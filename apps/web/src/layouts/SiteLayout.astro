---
import { REVEAL_SCRIPT } from '../lib/inline-scripts.ts';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/barlow/latin-300.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '../styles/site.css';
import ThemeScript from '../components/ThemeScript.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { CONSENT_COOKIE, consentFrom } from '../lib/consent.ts';
import { DEFAULT_THEME, THEME_BAR } from '../lib/theme.ts';
import type { PublicSite } from '../lib/site/content.ts';

interface Props {
  site: PublicSite;
  title: string;
  description?: string;
  noindex?: boolean;
  /** Diseño premium: aplica también el color de fondo del taller a toda la página. */
  premium?: boolean;
}
const { site, title, description = site.content.intro, noindex = false, premium = false } = Astro.props;
// El fondo propio del taller solo se usa en modo oscuro (el claro tiene el suyo, ver site.css).
const rootStyle = [`--accent:${site.accent}`, premium && site.colors.background ? `--bg-taller:${site.colors.background}` : ''].filter(Boolean).join(';');
// La web pública es SIEMPRE oscura (decisión del propietario): no hay botón y la
// elección hecha en el área privada no se aplica aquí (data-theme-fixed).
const theme = DEFAULT_THEME.web;
const consent = consentFrom(Astro.cookies.get(CONSENT_COOKIE)?.value);
const darkBar = premium && site.colors.background ? site.colors.background : THEME_BAR.oscuro;
// Una web de demostración no debe aparecer en buscadores.
const robots = noindex || site.isDemoContent ? 'noindex, nofollow' : 'index, follow';
---
<!doctype html>
<html lang="es" style={rootStyle} data-theme={theme} data-theme-fixed data-cookies={consent ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={darkBar} />
    <meta name="color-scheme" content="dark" />
    <ThemeScript />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      Animaciones de entrada (desenfoque → nítido). Va en línea para no depender
      de ningún archivo: sin JavaScript o con "reducir movimiento", todo se ve
      directamente y nada queda oculto.
    -->
    <script is:inline set:html={REVEAL_SCRIPT}></script>
  </head>
  <body>
    <slot />
    <CookieBanner consent={consent} />
  </body>
</html>
