---
/**
 * Plantilla del área privada (acceso, registro, cuenta, invitaciones).
 * Misma estética que la web pública, sin datos de ningún taller.
 */
import '@fontsource/barlow/latin-300.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource-variable/archivo/standard.css';
import '../styles/site.css';
import '../styles/app.css';
import BackLink from '../components/BackLink.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { CONSENT_COOKIE, consentFrom } from '../lib/consent.ts';
import { DEFAULT_THEME, THEME_BAR, THEME_COOKIE, themeFor } from '../lib/theme.ts';
import type { SessionUser } from '../lib/server/auth.ts';

interface Props {
  title: string;
  user?: SessionUser | null;
  /** Ancho de la columna: estrecho para formularios, ancho para la cuenta. */
  wide?: boolean;
  /**
   * Botón «Volver». Por defecto: con sesión, a «mi área» (panel o portal según
   * el rol); sin sesión, a iniciar sesión. `false` lo quita.
   */
  back?: { href: string; label: string; fromReferrer?: boolean } | false;
}
const { title, user = null, wide = false } = Astro.props;
const back = Astro.props.back ?? (user ? { href: '/mi-area', label: 'Volver a mi área' } : { href: '/acceso', label: 'Volver a iniciar sesión' });
const theme = themeFor(Astro.cookies.get(THEME_COOKIE)?.value, DEFAULT_THEME.acceso);
const consent = consentFrom(Astro.cookies.get(CONSENT_COOKIE)?.value);
---
<!doctype html>
<html lang="es" data-area="app" data-theme={theme} data-cookies={consent ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Área de talleres</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={THEME_BAR[theme]} data-oscuro={THEME_BAR.oscuro} data-claro={THEME_BAR.claro} />
    <meta name="color-scheme" content={theme === 'claro' ? 'light' : 'dark'} />
    <ThemeScript />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="auth-body">
    <div class="ambient" aria-hidden="true"></div>
    <header class="auth-top">
      <a href={user ? '/cuenta' : '/acceso'} class="brand">
        <span class="brand-mark liquid-glass" aria-hidden="true">t</span>
        <span class="brand-name">Área de talleres</span>
      </a>
      <div class="auth-top-side">
        <ThemeToggle current={theme} showLabel />
        {user && (
          <form method="post" action="/salir" class="auth-top-user">
            <a class="btn btn-sm" href="/mi-area">Mi área</a>
            <span class="auth-top-email" title={user.email}>{user.email}</span>
            <button class="btn btn-sm" type="submit">Salir</button>
          </form>
        )}
      </div>
    </header>
    <main class={`auth-main ${wide ? 'is-wide' : ''}`}>
      {back && <BackLink {...back} />}
      <slot />
    </main>
    <footer class="auth-legal" aria-label="Información legal">
      <a href="/privacidad-cuenta">Privacidad de las cuentas</a>
      <a href="/condiciones">Condiciones del servicio</a>
      <a href="/encargo">Encargo del tratamiento</a>
      <a href="/cookies">Cookies</a>
    </footer>
    <CookieBanner consent={consent} />
    <script>
      import '../scripts/auth-forms.ts';
    </script>
  </body>
</html>
