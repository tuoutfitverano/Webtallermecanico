---
import { PANEL_COLOR_SCRIPT } from '../lib/inline-scripts.ts';
/**
 * Plantilla del panel del taller: barra lateral (escritorio), pestañas
 * inferiores (móvil), cabecera con el taller y la persona. Navegación sin
 * recargar la página entera (ClientRouter de Astro); sin JavaScript todo
 * funciona igual con enlaces y formularios normales.
 */
import { ClientRouter } from 'astro:transitions';
import '@fontsource/barlow/latin-300.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource-variable/archivo/standard.css';
import '../styles/site.css';
import '../styles/panel.css';
import '../styles/app.css';
import ColorPicker from '../components/panel/ColorPicker.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { CONSENT_COOKIE, consentFrom } from '../lib/consent.ts';
import { DEFAULT_THEME, THEME_BAR, THEME_COOKIE, themeFor } from '../lib/theme.ts';
import { PANEL_COLOR_COOKIE, panelColor } from '../lib/panel/colors.ts';
import Icon from '../components/Icon.astro';
import type { Panel } from '../lib/server/panel.ts';
import { ROLE_LABELS } from '../lib/auth/validate.ts';

export type PanelSection = 'inicio' | 'ordenes' | 'vehiculos' | 'clientes' | 'equipo' | 'avisos' | 'solicitudes' | 'taller' | 'planificacion' | 'presupuestos' | 'facturas' | 'estadisticas' | 'recordatorios' | 'mantenimientos' | 'agenda';
interface Props {
  panel: Panel;
  title: string;
  section?: PanelSection;
}
const { panel, title, section } = Astro.props;
type NavIcon = 'home' | 'clipboard' | 'car' | 'users' | 'user' | 'bell' | 'mail' | 'cog' | 'calendar' | 'file' | 'euro' | 'chart' | 'clock' | 'wrench' | 'board';
const nav: Array<{ id: PanelSection; href: string; label: string; icon: NavIcon }> = [
  { id: 'inicio', href: '/panel', label: 'Inicio', icon: 'home' },
  { id: 'ordenes', href: '/panel/ordenes', label: 'Órdenes', icon: 'clipboard' },
  { id: 'vehiculos', href: '/panel/vehiculos', label: 'Vehículos', icon: 'car' },
  { id: 'clientes', href: '/panel/clientes', label: 'Clientes', icon: 'user' },
  { id: 'agenda', href: '/panel/agenda', label: 'Agenda', icon: 'calendar' },
  { id: 'planificacion', href: '/panel/planificacion', label: 'Planificación', icon: 'board' },
  { id: 'mantenimientos', href: '/panel/mantenimientos', label: 'Mantenimientos', icon: 'wrench' },
  // Oficina (propietario, administrador, recepción): la base de datos tampoco enseña estos datos a los demás.
  ...(panel.isOffice ? [
    { id: 'presupuestos' as const, href: '/panel/presupuestos', label: 'Presupuestos', icon: 'file' as const },
    { id: 'facturas' as const, href: '/panel/facturas', label: 'Facturas', icon: 'euro' as const },
    { id: 'estadisticas' as const, href: '/panel/estadisticas', label: 'Estadísticas', icon: 'chart' as const },
    { id: 'recordatorios' as const, href: '/panel/recordatorios', label: 'Recordatorios', icon: 'clock' as const },
    { id: 'solicitudes' as const, href: '/panel/solicitudes', label: 'Solicitudes web', icon: 'mail' as const },
  ] : []),
  { id: 'equipo', href: '/panel/equipo', label: 'Equipo', icon: 'users' },
  // Solo propietario y administradores.
  ...(panel.isManager ? [
    { id: 'avisos' as const, href: '/panel/avisos', label: 'Avisos', icon: 'bell' as const },
    { id: 'taller' as const, href: '/panel/taller', label: 'Taller', icon: 'cog' as const },
  ] : []),
];
// Móvil: cuatro pestañas fijas y el resto en «Más» (con «Mi cuenta»).
const tabs = nav.slice(0, 4);
const more = nav.slice(4);
const moreOn = more.some(n => n.id === section);
const w = panel.workshop;
// Color de las tarjetas elegido en este dispositivo (grafito si no hay elección).
const color = panelColor(Astro.cookies.get(PANEL_COLOR_COOKIE)?.value);
// Modo claro u oscuro de este dispositivo (en el panel, claro si no se ha elegido).
const theme = themeFor(Astro.cookies.get(THEME_COOKIE)?.value, DEFAULT_THEME.panel);
const consent = consentFrom(Astro.cookies.get(CONSENT_COOKIE)?.value);
---
<!doctype html>
<!-- Sin animación entre páginas: en una herramienta de trabajo el cambio debe ser inmediato. -->
<html lang="es" data-area="app" transition:animate="none" data-color={color} data-theme={theme} data-cookies={consent ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}{w ? ` · ${w.name}` : ''} · Panel</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={THEME_BAR[theme]} data-oscuro={THEME_BAR.oscuro} data-claro={THEME_BAR.claro} />
    <meta name="color-scheme" content={theme === 'claro' ? 'light' : 'dark'} />
    <ThemeScript />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Color elegido: también en localStorage (vista previa sin servidor o sin cookies). -->
    <script is:inline set:html={PANEL_COLOR_SCRIPT}></script>
    <ClientRouter fallback="none" />
  </head>
  <body class="pnl-body">
    <a class="pnl-skip" href="#contenido">Saltar al contenido</a>

    <aside class="pnl-side" aria-label="Menú del panel">
      <a href="/panel" class="pnl-brand">
        <span class="brand-mark liquid-glass" aria-hidden="true">t</span>
        <span class="pnl-brand-text">Panel del taller</span>
      </a>
      {w && (
        <nav class="pnl-nav" aria-label="Secciones">
          {nav.map(n => (
            <a href={n.href} class:list={['pnl-nav-link', { 'is-on': n.id === section }]} aria-current={n.id === section ? 'page' : undefined}>
              <Icon name={n.icon} /><span>{n.label}</span>
            </a>
          ))}
        </nav>
      )}
      <div class="pnl-side-foot">
        <a href="/cuenta" class="pnl-side-link"><Icon name="user" /><span>Mi cuenta</span></a>
      </div>
    </aside>

    <div class="pnl-main">
      <header class="pnl-top">
        <div class="pnl-top-workshop">
          {w ? (
            panel.workshops.length > 1 ? (
              <form method="get" action="/panel" class="pnl-switch" data-astro-reload>
                <label for="taller" class="sr-only">Taller</label>
                <select id="taller" name="taller" class="pnl-switch-select" data-autosubmit>
                  {panel.workshops.map(x => <option value={x.id} selected={x.id === w.id}>{x.name}</option>)}
                </select>
                <noscript><button class="btn btn-sm" type="submit">Cambiar</button></noscript>
              </form>
            ) : (
              <span class="pnl-workshop-name">{w.name}</span>
            )
          ) : <span class="pnl-workshop-name">Panel</span>}
          {w && <span class="pnl-role">{ROLE_LABELS[w.role]}</span>}
        </div>
        <div class="pnl-top-side">
        <ThemeToggle current={theme} />
        <ColorPicker current={color} />
        <form method="post" action="/salir" class="pnl-top-user" data-astro-reload>
          <span class="pnl-user" title={panel.user.email}>{panel.user.email}</span>
          <button class="btn btn-sm" type="submit" aria-label="Salir (cerrar sesión)" title="Cerrar sesión"><Icon name="logout" /><span class="pnl-hide-sm">Salir</span></button>
        </form>
        </div>
      </header>

      <main id="contenido" class="pnl-content" tabindex="-1">
        <slot />
      </main>
    </div>

    {w && (
      <nav class="pnl-tabs" aria-label="Secciones">
        {tabs.map(n => (
          <a href={n.href} class:list={['pnl-tab', { 'is-on': n.id === section }]} aria-current={n.id === section ? 'page' : undefined}>
            <Icon name={n.icon} /><span>{n.label}</span>
          </a>
        ))}
        <details class="pnl-more">
          <summary class:list={['pnl-tab', { 'is-on': moreOn }]}><Icon name="menu" /><span>Más</span></summary>
          <div class="pnl-more-menu">
            {more.map(n => (
              <a href={n.href} class:list={{ 'is-on': n.id === section }} aria-current={n.id === section ? 'page' : undefined}><Icon name={n.icon} /><span>{n.label}</span></a>
            ))}
            <a href="/cuenta"><Icon name="user" /><span>Mi cuenta</span></a>
          </div>
        </details>
      </nav>
    )}

    <CookieBanner consent={consent} />

    <script>
      import '../scripts/panel.ts';
    </script>
  </body>
</html>
