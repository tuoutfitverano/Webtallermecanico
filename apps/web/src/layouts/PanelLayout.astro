---
/**
 * Plantilla del panel del taller: barra lateral (escritorio), pestañas
 * inferiores (móvil), cabecera con el taller y la persona. Navegación sin
 * recargar la página entera (ClientRouter de Astro); sin JavaScript todo
 * funciona igual con enlaces y formularios normales.
 */
import { ClientRouter } from 'astro:transitions';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/barlow/latin-300.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '../styles/site.css';
import '../styles/panel.css';
import Icon from '../components/Icon.astro';
import type { Panel } from '../lib/server/panel.ts';
import { ROLE_LABELS } from '../lib/auth/validate.ts';

export type PanelSection = 'inicio' | 'ordenes' | 'vehiculos' | 'clientes' | 'equipo' | 'avisos';
interface Props {
  panel: Panel;
  title: string;
  section?: PanelSection;
}
const { panel, title, section } = Astro.props;
const nav: Array<{ id: PanelSection; href: string; label: string; icon: 'home' | 'clipboard' | 'car' | 'users' | 'user' | 'bell' }> = [
  { id: 'inicio', href: '/panel', label: 'Inicio', icon: 'home' },
  { id: 'ordenes', href: '/panel/ordenes', label: 'Órdenes', icon: 'clipboard' },
  { id: 'vehiculos', href: '/panel/vehiculos', label: 'Vehículos', icon: 'car' },
  { id: 'clientes', href: '/panel/clientes', label: 'Clientes', icon: 'user' },
  { id: 'equipo', href: '/panel/equipo', label: 'Equipo', icon: 'users' },
  // Avisos a clientes: solo propietario y administradores (la base de datos tampoco se los enseña a nadie más).
  ...(panel.isManager ? [{ id: 'avisos' as const, href: '/panel/avisos', label: 'Avisos', icon: 'bell' as const }] : []),
];
const w = panel.workshop;
---
<!doctype html>
<!-- Sin animación entre páginas: en una herramienta de trabajo el cambio debe ser inmediato. -->
<html lang="es" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}{w ? ` · ${w.name}` : ''} · Panel</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter fallback="none" />
  </head>
  <body class="pnl-body">
    <a class="pnl-skip" href="#contenido">Saltar al contenido</a>

    <aside class="pnl-side" aria-label="Menú del panel">
      <a href="/panel" class="pnl-brand">
        <span class="brand-mark liquid-glass" aria-hidden="true">t</span>
        <span class="pnl-brand-text">Panel del taller</span>
      </a>
      {w && (
        <nav class="pnl-nav" aria-label="Secciones">
          {nav.map(n => (
            <a href={n.href} class:list={['pnl-nav-link', { 'is-on': n.id === section }]} aria-current={n.id === section ? 'page' : undefined}>
              <Icon name={n.icon} /><span>{n.label}</span>
            </a>
          ))}
        </nav>
      )}
      <div class="pnl-side-foot">
        <a href="/cuenta" class="pnl-side-link"><Icon name="user" /><span>Mi cuenta</span></a>
      </div>
    </aside>

    <div class="pnl-main">
      <header class="pnl-top">
        <div class="pnl-top-workshop">
          {w ? (
            panel.workshops.length > 1 ? (
              <form method="get" action="/panel" class="pnl-switch" data-astro-reload>
                <label for="taller" class="sr-only">Taller</label>
                <select id="taller" name="taller" class="pnl-switch-select" data-autosubmit>
                  {panel.workshops.map(x => <option value={x.id} selected={x.id === w.id}>{x.name}</option>)}
                </select>
                <noscript><button class="btn btn-sm" type="submit">Cambiar</button></noscript>
              </form>
            ) : (
              <span class="pnl-workshop-name">{w.name}</span>
            )
          ) : <span class="pnl-workshop-name">Panel</span>}
          {w && <span class="pnl-role">{ROLE_LABELS[w.role]}</span>}
        </div>
        <form method="post" action="/salir" class="pnl-top-user" data-astro-reload>
          <span class="pnl-user" title={panel.user.email}>{panel.user.email}</span>
          <button class="btn btn-sm" type="submit" aria-label="Cerrar sesión"><Icon name="logout" /><span class="pnl-hide-sm">Salir</span></button>
        </form>
      </header>

      <main id="contenido" class="pnl-content" tabindex="-1">
        <slot />
      </main>
    </div>

    {w && (
      <nav class:list={['pnl-tabs', { 'pnl-tabs-6': nav.length === 6 }]} aria-label="Secciones">
        {nav.map(n => (
          <a href={n.href} class:list={['pnl-tab', { 'is-on': n.id === section }]} aria-current={n.id === section ? 'page' : undefined}>
            <Icon name={n.icon} /><span>{n.label}</span>
          </a>
        ))}
      </nav>
    )}

    <script>
      import '../scripts/panel.ts';
    </script>
  </body>
</html>
