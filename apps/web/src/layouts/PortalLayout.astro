---
import { PANEL_COLOR_SCRIPT } from '../lib/inline-scripts.ts';
/**
 * Plantilla del portal del cliente: misma identidad visual que el panel,
 * pero con pocas secciones y textos pensados para quien no es mecánico.
 */
import { ClientRouter } from 'astro:transitions';
import '@fontsource/barlow/latin-300.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource-variable/archivo/standard.css';
import '../styles/site.css';
import '../styles/panel.css';
import '../styles/app.css';
import ColorPicker from '../components/panel/ColorPicker.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { CONSENT_COOKIE, consentFrom } from '../lib/consent.ts';
import { DEFAULT_THEME, THEME_BAR, THEME_COOKIE, themeFor } from '../lib/theme.ts';
import { PANEL_COLOR_COOKIE, panelColor } from '../lib/panel/colors.ts';
import Icon from '../components/Icon.astro';
import type { Portal } from '../lib/server/portal.ts';

export type PortalSection = 'inicio' | 'vehiculos' | 'reparaciones' | 'presupuestos' | 'facturas' | 'avisos' | 'datos';
interface Props {
  portal: Portal;
  title: string;
  section?: PortalSection;
}
const { portal, title, section } = Astro.props;
const nav: Array<{ id: PortalSection; href: string; label: string; icon: 'home' | 'car' | 'clipboard' | 'bell' | 'user' | 'file' | 'euro' }> = [
  { id: 'inicio', href: '/portal', label: 'Inicio', icon: 'home' },
  { id: 'vehiculos', href: '/portal/vehiculos', label: 'Mis vehículos', icon: 'car' },
  { id: 'reparaciones', href: '/portal/reparaciones', label: 'Reparaciones', icon: 'clipboard' },
  { id: 'avisos', href: '/portal/avisos', label: 'Avisos', icon: 'bell' },
  { id: 'presupuestos', href: '/portal/presupuestos', label: 'Presupuestos', icon: 'file' },
  { id: 'facturas', href: '/portal/facturas', label: 'Facturas', icon: 'euro' },
  { id: 'datos', href: '/portal/datos', label: 'Mis datos', icon: 'user' },
];
// Móvil: cuatro pestañas y el resto en «Más» (con «Mi cuenta»).
const tabs = nav.slice(0, 4);
const more = nav.slice(4);
const moreOn = more.some(n => n.id === section);
const linked = portal.records.length > 0;
const workshopLabel = portal.records.length === 1 ? portal.records[0]!.workshop_name : portal.records.length > 1 ? `${portal.records.length} talleres` : '';
// Color de las tarjetas elegido en este dispositivo (grafito si no hay elección).
const color = panelColor(Astro.cookies.get(PANEL_COLOR_COOKIE)?.value);
// Modo claro u oscuro de este dispositivo (claro si no se ha elegido).
const theme = themeFor(Astro.cookies.get(THEME_COOKIE)?.value, DEFAULT_THEME.portal);
const consent = consentFrom(Astro.cookies.get(CONSENT_COOKIE)?.value);
---
<!doctype html>
<html lang="es" data-area="app" transition:animate="none" data-color={color} data-theme={theme} data-cookies={consent ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Mi portal</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={THEME_BAR[theme]} data-oscuro={THEME_BAR.oscuro} data-claro={THEME_BAR.claro} />
    <meta name="color-scheme" content={theme === 'claro' ? 'light' : 'dark'} />
    <ThemeScript />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Color elegido: también en localStorage (vista previa sin servidor o sin cookies). -->
    <script is:inline set:html={PANEL_COLOR_SCRIPT}></script>
    <ClientRouter fallback="none" />
  </head>
  <body class="pnl-body portal-body">
    <a class="pnl-skip" href="#contenido">Saltar al contenido</a>

    <aside class="pnl-side" aria-label="Menú del portal">
      <a href="/portal" class="pnl-brand">
        <span class="brand-mark liquid-glass" aria-hidden="true">t</span>
        <span class="pnl-brand-text">Mi portal</span>
      </a>
      {linked && (
        <nav class="pnl-nav" aria-label="Secciones">
          {nav.map(n => (
            <a href={n.href} class:list={['pnl-nav-link', { 'is-on': n.id === section }]} aria-current={n.id === section ? 'page' : undefined}>
              <Icon name={n.icon} /><span>{n.label}</span>
              {n.id === 'avisos' && portal.unread > 0 && <span class="pnl-badge" aria-label={`${portal.unread} sin leer`}>{portal.unread > 99 ? '99+' : portal.unread}</span>}
            </a>
          ))}
        </nav>
      )}
      <div class="pnl-side-foot">
        <a href="/cuenta" class="pnl-side-link"><Icon name="shield" /><span>Mi cuenta</span></a>
      </div>
    </aside>

    <div class="pnl-main">
      <header class="pnl-top">
        <div class="pnl-top-workshop">
          <span class="pnl-workshop-name">{workshopLabel || 'Mi portal'}</span>
          {linked && <span class="pnl-role">Cliente</span>}
        </div>
        <div class="pnl-top-side">
        <ThemeToggle current={theme} />
        <ColorPicker current={color} />
        <form method="post" action="/salir" class="pnl-top-user" data-astro-reload>
          <span class="pnl-user" title={portal.user.email}>{portal.user.email}</span>
          <button class="btn btn-sm" type="submit" aria-label="Salir (cerrar sesión)" title="Cerrar sesión"><Icon name="logout" /><span class="pnl-hide-sm">Salir</span></button>
        </form>
        </div>
      </header>
      <main id="contenido" class="pnl-content" tabindex="-1">
        <slot />
      </main>
    </div>

    {linked && (
      <nav class="pnl-tabs" aria-label="Secciones">
        {tabs.map(n => (
          <a href={n.href} class:list={['pnl-tab', { 'is-on': n.id === section }]} aria-current={n.id === section ? 'page' : undefined}>
            <Icon name={n.icon} /><span>{n.label}</span>
            {n.id === 'avisos' && portal.unread > 0 && <span class="pnl-badge pnl-badge-tab" aria-label={`${portal.unread} sin leer`}>{portal.unread > 99 ? '99+' : portal.unread}</span>}
          </a>
        ))}
        <details class="pnl-more">
          <summary class:list={['pnl-tab', { 'is-on': moreOn }]}><Icon name="menu" /><span>Más</span></summary>
          <div class="pnl-more-menu">
            {more.map(n => (
              <a href={n.href} class:list={{ 'is-on': n.id === section }} aria-current={n.id === section ? 'page' : undefined}><Icon name={n.icon} /><span>{n.label}</span></a>
            ))}
            <a href="/cuenta"><Icon name="shield" /><span>Mi cuenta</span></a>
          </div>
        </details>
      </nav>
    )}

    <CookieBanner consent={consent} />

    <script>
      import '../scripts/panel.ts';
    </script>
  </body>
</html>
