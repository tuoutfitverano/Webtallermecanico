---
/**
 * Mi cuenta: perfil y talleres a los que pertenezco. El equipo y las
 * invitaciones se gestionan en el panel (/panel/equipo).
 *
 * Todas las lecturas y escrituras van con el token del usuario: la base de
 * datos (RLS y funciones) decide qué puede ver y hacer. El id del taller que
 * llega en un formulario NO se da por bueno: la función lo comprueba.
 */
import AuthLayout from '../../layouts/AuthLayout.astro';
import Icon from '../../components/Icon.astro';
import { authPage, formText, redirectToLogin } from '../../lib/server/auth-page.ts';
import { logAuth } from '../../lib/server/auth.ts';
import { dbErrorMessage } from '../../lib/auth/messages.ts';
import { ROLE_LABELS, text, type MemberRole } from '../../lib/auth/validate.ts';

export const prerender = false;

const page = await authPage(Astro);
if (page.isPost && !page.form) return new Response('Origen no permitido.', { status: 403 });
if (!page.user || !page.supabase) return redirectToLogin(Astro);
const { supabase, user } = page;

interface Workshop { workshop_id: string; name: string; slug: string; status: string; role: MemberRole }

const flash: { kind: 'ok' | 'bad'; text: string } = { kind: 'ok', text: '' };

if (page.form) {
  const action = formText(page.form, 'action');
  if (action === 'perfil') {
    const fullName = text(page.form.get('full_name'), 120);
    const phone = text(page.form.get('phone'), 30);
    const { error } = await supabase.from('profiles')
      .update({ full_name: fullName || null, phone: phone || null })
      .eq('id', user.id);
    if (error) logAuth('account_profile_error', error.code);
    Object.assign(flash, error ? { kind: 'bad', text: dbErrorMessage(error) } : { kind: 'ok', text: 'Datos guardados.' });
  }
  if (flash.kind === 'bad') Astro.response.status = 400;
}

const [{ data: profile }, { data: workshopsData, error: workshopsError }, { data: portalRecords }] = await Promise.all([
  supabase.from('profiles').select('full_name, phone').eq('id', user.id).maybeSingle(),
  supabase.rpc('my_workshops'),
  supabase.rpc('portal_profile'),
]);
if (workshopsError) logAuth('account_workshops_error', workshopsError.code);
const workshops = (workshopsData ?? []) as Workshop[];

// «Volver»: al panel (personal), al portal (cliente vinculado) o, si no hay ninguno, sin botón.
const back = workshops.length > 0 ? { href: '/panel', label: 'Volver al panel' }
  : (portalRecords ?? []).length > 0 ? { href: '/portal', label: 'Volver a mi portal' } : false;
const manages = (w: Workshop) => w.role === 'propietario' || w.role === 'administrador';

const welcome = Astro.url.searchParams.get('bienvenida') === '1';
---
<AuthLayout title="Mi cuenta" user={user} wide back={back}>
  <header class="account-head">
    <p class="label">// Tu cuenta</p>
    <h1 class="account-title heading">Hola{profile?.full_name ? `, ${profile.full_name.split(' ')[0]}` : ''}</h1>
    {workshops.length > 0 && <p class="auth-lead" style="margin:12px 0 0"><a class="btn btn-primary" href="/panel">Ir al panel del taller</a></p>}
  </header>

  {welcome && <div class="alert alert-ok" role="status"><Icon name="check" /><span>Invitación aceptada. Ya formas parte del equipo.</span></div>}
  {flash.text && (
    <div class={`alert ${flash.kind === 'ok' ? 'alert-ok' : 'alert-bad'}`} role={flash.kind === 'ok' ? 'status' : 'alert'}>
      <Icon name={flash.kind === 'ok' ? 'check' : 'alert'} /><span>{flash.text}</span>
    </div>
  )}

  <div class="account-grid">
    <section class="panel liquid-glass" aria-labelledby="perfil-t">
      <h2 id="perfil-t" class="panel-title heading">Tus datos</h2>
      <p class="muted small">Correo: <strong class="mono">{user.email}</strong></p>
      <form method="post" class="auth-form" data-busy="Guardando…">
        <input type="hidden" name="action" value="perfil" />
        <div class="field">
          <label for="full_name">Nombre y apellidos</label>
          <input class="input" id="full_name" name="full_name" autocomplete="name" maxlength="120" value={profile?.full_name ?? ''} />
        </div>
        <div class="field">
          <label for="phone">Teléfono <span class="muted">(opcional)</span></label>
          <input class="input" id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" value={profile?.phone ?? ''} />
        </div>
        <button class="btn btn-block" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Guardar</span></button>
      </form>
      <nav class="auth-links"><a href="/cuenta/contrasena">Cambiar la contraseña</a></nav>
    </section>

    <section class="panel liquid-glass" aria-labelledby="talleres-t">
      <h2 id="talleres-t" class="panel-title heading">Tus talleres</h2>
      {workshopsError ? (
        <div class="alert alert-bad" role="alert"><Icon name="alert" /><span>No hemos podido cargar tus talleres. Recarga la página.</span></div>
      ) : workshops.length === 0 ? (
        <p class="muted">Todavía no perteneces a ningún taller. Si te han invitado, abre el enlace de la invitación con este correo. Para dar de alta un taller nuevo, contacta con la plataforma.</p>
      ) : (
        <ul class="workshop-list">
          {workshops.map(w => (
            <li>
              <span class="workshop-name">{w.name}</span>
              <span class="role-pill liquid-glass">{ROLE_LABELS[w.role]}</span>
              {w.status === 'suspendido' && <span class="muted small">Suspendido</span>}
              {manages(w) && <a class="small" href={`/panel/equipo?taller=${w.workshop_id}`}>Equipo e invitaciones</a>}
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>

</AuthLayout>
