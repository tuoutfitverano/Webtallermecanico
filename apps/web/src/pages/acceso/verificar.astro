---
/**
 * Segundo paso del acceso: el código de 6 cifras de la app de verificación
 * (Google Authenticator, Microsoft Authenticator, 1Password…). Solo para
 * cuentas que tienen activada la verificación en dos pasos. Lo comprueba
 * Supabase Auth (challenge + verify) y la sesión pasa a «aal2».
 *
 * ¿Sin el móvil? (migración 20261106090000_recuperar_dos_pasos.sql)
 *  · Código de recuperación (los 10 que se dieron al activarla): quita la
 *    verificación y la persona la vuelve a activar con su móvil nuevo.
 *  · Por correo: contraseña recién escrita + código que envía Supabase Auth al
 *    correo de la cuenta. No vale para la administración de la plataforma.
 * Las reglas (intentos, caducidad, quién puede) las pone la base de datos.
 */
import AuthLayout from '../../layouts/AuthLayout.astro';
import Icon from '../../components/Icon.astro';
import { authPage, formText, needsSecondFactor, redirectToLogin } from '../../lib/server/auth-page.ts';
import { logAuth } from '../../lib/server/auth.ts';
import { safeNext } from '../../lib/auth/redirect.ts';

export const prerender = false;

const page = await authPage(Astro, { allowPendingMfa: true });
if (page.isPost && !page.form) return new Response('Origen no permitido.', { status: 403 });
if (!page.user || !page.supabase) return redirectToLogin(Astro);
const { supabase, user } = page;
const next = safeNext(page.isPost ? formText(page.form, 'next') : Astro.url.searchParams.get('next'), page.self);
// Ya verificada (o sin verificación en dos pasos): a su destino.
if (!(await needsSecondFactor(supabase, user))) return Astro.redirect(next, 303);

const RECOVERY_ERRORS: Record<string, string> = {
  incorrecto: 'Ese código de recuperación no es correcto o ya se ha usado.',
  demasiados: 'Demasiados intentos. Espera 15 minutos y vuelve a probar.',
  sin_verificacion: 'Tu cuenta ya no tiene la verificación en dos pasos.',
  contrasena: 'Por seguridad, sal y vuelve a entrar con tu contraseña, y pide el código del correo justo después.',
  administracion: 'Las cuentas de la administración de la plataforma no se recuperan por correo: usa un código de recuperación.',
  caducada: 'La recuperación ha caducado. Pide un código nuevo.',
  correo: 'No hemos podido comprobar el código del correo. Pide uno nuevo.',
};

/** Tras quitar la verificación, la sesión se renueva (para que deje de pedir el código) y se va a activarla de nuevo. */
async function recovered(how: 'codigo' | 'correo') {
  await supabase.auth.refreshSession();
  logAuth(how === 'codigo' ? 'mfa_recovery_code_ok' : 'mfa_recovery_email_ok');
  return Astro.redirect(`/cuenta/seguridad?recuperada=${how}`, 303);
}

let error = '';
let recoveryError = '';
let emailSent = false;
const action = page.form ? formText(page.form, 'action') || 'verificar' : '';
const masked = user.email.replace(/^(.)[^@]*(@.*)$/, '$1•••$2');

if (action === 'verificar') {
  const code = formText(page.form, 'code').replace(/\s/g, '');
  if (!/^\d{6}$/.test(code)) {
    error = 'Escribe las 6 cifras que muestra tu app de verificación.';
    Astro.response.status = 422;
  } else {
    const { data: factors, error: listError } = await supabase.auth.mfa.listFactors();
    const factor = factors?.totp.find(f => f.status === 'verified');
    if (listError || !factor) {
      logAuth('mfa_list_error', listError?.code);
      error = 'No hemos podido comprobar el código. Inténtalo de nuevo.';
      Astro.response.status = 400;
    } else {
      const { error: e } = await supabase.auth.mfa.challengeAndVerify({ factorId: factor.id, code });
      if (!e) {
        logAuth('mfa_verify_ok');
        return Astro.redirect(next, 303);
      }
      logAuth('mfa_verify_error', e.code);
      error = e.status === 429 ? 'Demasiados intentos. Espera un minuto y vuelve a probar.' : 'Código incorrecto o caducado. Escribe el que aparece ahora en tu app.';
      Astro.response.status = e.status === 429 ? 429 : 400;
    }
  }
} else if (action === 'codigo-recuperacion') {
  const code = formText(page.form, 'recovery_code');
  const { data, error: e } = await supabase.rpc('use_mfa_recovery_code', { p_code: code });
  if (!e && data?.ok === true) return recovered('codigo');
  logAuth('mfa_recovery_code_error', e?.code ?? data?.reason);
  recoveryError = RECOVERY_ERRORS[data?.reason] ?? 'No hemos podido comprobar el código. Inténtalo de nuevo.';
  Astro.response.status = data?.reason === 'demasiados' ? 429 : 400;
} else if (action === 'correo-pedir') {
  const { data, error: e } = await supabase.rpc('start_mfa_email_recovery');
  if (!e && data?.ok === true) {
    // El correo lo envía Supabase Auth (plantilla magic_link, con el código de 6 cifras).
    const { error: otpError } = await supabase.auth.signInWithOtp({ email: user.email, options: { shouldCreateUser: false } });
    if (otpError) {
      logAuth('mfa_recovery_email_send_error', otpError.code);
      recoveryError = otpError.status === 429
        ? 'Hemos enviado demasiados correos. Espera unos minutos y vuelve a probar.'
        : 'No hemos podido enviar el correo. Inténtalo más tarde o usa un código de recuperación.';
      Astro.response.status = otpError.status === 429 ? 429 : 503;
    } else {
      emailSent = true;
    }
  } else {
    logAuth('mfa_recovery_email_error', e?.code ?? data?.reason);
    recoveryError = RECOVERY_ERRORS[data?.reason] ?? 'No hemos podido empezar la recuperación. Inténtalo de nuevo.';
    Astro.response.status = data?.reason === 'demasiados' ? 429 : 400;
  }
} else if (action === 'correo-verificar') {
  const token = formText(page.form, 'email_code').replace(/\s/g, '');
  emailSent = true;
  if (!/^\d{6}$/.test(token)) {
    recoveryError = 'Escribe las 6 cifras del correo.';
    Astro.response.status = 422;
  } else {
    // Abre una sesión nueva con el código del correo; la base de datos comprueba que va
    // después de la petición hecha con la contraseña, y solo entonces quita la verificación.
    const { error: otpError } = await supabase.auth.verifyOtp({ email: user.email, token, type: 'email' });
    if (otpError) {
      logAuth('mfa_recovery_email_verify_error', otpError.code);
      recoveryError = 'Código del correo incorrecto o caducado.';
      Astro.response.status = 400;
    } else {
      const { data, error: e } = await supabase.rpc('finish_mfa_email_recovery');
      if (!e && data?.ok === true) return recovered('correo');
      logAuth('mfa_recovery_email_error', e?.code ?? data?.reason);
      recoveryError = RECOVERY_ERRORS[data?.reason] ?? 'No hemos podido terminar la recuperación. Empieza de nuevo.';
      emailSent = false;
      Astro.response.status = 400;
    }
  }
}
const showRecovery = Boolean(recoveryError || emailSent || action === 'codigo-recuperacion');
---
<AuthLayout title="Verificación en dos pasos" user={user}>
  <section class="auth-card liquid-glass-strong" aria-labelledby="titulo">
    <p class="label">Área de talleres</p>
    <h1 id="titulo" class="auth-title heading">Código de verificación</h1>
    <p class="auth-lead">Tu cuenta tiene activada la verificación en dos pasos. Abre tu app de verificación y escribe el código de 6 cifras de AutoValue.</p>
    {error && <div class="alert alert-bad" role="alert"><Icon name="alert" /><span>{error}</span></div>}
    <form method="post" class="auth-form" data-busy="Comprobando…" novalidate>
      <input type="hidden" name="action" value="verificar" />
      <input type="hidden" name="next" value={next} />
      <div class="field">
        <label for="code">Código de 6 cifras</label>
        <input class="input mono" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus={!showRecovery} />
      </div>
      <button class="btn btn-primary btn-block" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Verificar</span></button>
    </form>

    <details class="mfa-recover" open={showRecovery}>
      <summary>¿No tienes el móvil?</summary>
      {recoveryError && <div class="alert alert-bad" role="alert"><Icon name="alert" /><span>{recoveryError}</span></div>}

      <h2 class="mfa-recover-title">Con un código de recuperación</h2>
      <p class="hint">Son los códigos que guardaste al activar la verificación. Cada uno sirve una vez.</p>
      <form method="post" class="auth-form" data-busy="Comprobando…" novalidate>
        <input type="hidden" name="action" value="codigo-recuperacion" />
        <input type="hidden" name="next" value={next} />
        <div class="field">
          <label for="recovery_code">Código de recuperación</label>
          <input class="input mono" id="recovery_code" name="recovery_code" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ABCD-EFGH-JKLM-NPQR" maxlength="24" required />
        </div>
        <button class="btn btn-block" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Entrar con el código de recuperación</span></button>
      </form>

      <h2 class="mfa-recover-title">Por correo</h2>
      {emailSent ? (
        <form method="post" class="auth-form" data-busy="Comprobando…" novalidate>
          <input type="hidden" name="action" value="correo-verificar" />
          <input type="hidden" name="next" value={next} />
          <p class="hint" role="status">Te hemos enviado un código de 6 cifras a <strong>{masked}</strong>. Caduca en 15 minutos.</p>
          <div class="field">
            <label for="email_code">Código del correo</label>
            <input class="input mono" id="email_code" name="email_code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required autofocus />
          </div>
          <button class="btn btn-block" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Comprobar el código del correo</span></button>
        </form>
      ) : (
        <form method="post" class="auth-form" data-busy="Enviando…">
          <input type="hidden" name="action" value="correo-pedir" />
          <input type="hidden" name="next" value={next} />
          <p class="hint">Te enviamos un código a <strong>{masked}</strong>. Solo funciona justo después de entrar con tu contraseña.</p>
          <button class="btn btn-block" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Enviarme un código al correo</span></button>
        </form>
      )}
      <p class="hint">Al recuperar la cuenta se quita la verificación en dos pasos: vuelve a activarla con tu móvil nuevo. Si no tienes ni los códigos ni el correo, escribe a la administración de la plataforma: la retirará después de comprobar que eres tú.</p>
    </details>

    <form method="post" action="/salir" class="auth-links" data-astro-reload>
      <button class="btn btn-sm" type="submit">Salir y entrar con otra cuenta</button>
    </form>
  </section>
</AuthLayout>

<style>
  .mfa-recover { margin-top: 18px; border-top: 1px solid var(--line, currentColor); padding-top: 14px; display: grid; gap: 10px; }
  .mfa-recover > summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .mfa-recover[open] { gap: 12px; }
  .mfa-recover-title { margin: 8px 0 0; font-size: 1rem; }
</style>
