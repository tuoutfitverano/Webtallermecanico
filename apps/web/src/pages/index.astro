---
/**
 * Web pública del taller. Se genera en cada visita según el dominio, para que
 * una sola aplicación sirva a todos los talleres. El diseño (clásico o
 * premium) y sus secciones salen de la configuración del taller.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import ClassicHome from '../components/ClassicHome.astro';
import PremiumHome from '../components/premium/PremiumHome.astro';
import { emailAvailable, siteForHost, turnstileSiteKey, vehicleLookupAvailable } from '../lib/server/config.ts';

export const prerender = false;

let site;
try {
  site = await siteForHost(Astro.request.headers.get('host') ?? Astro.url.host);
} catch {
  return new Response('La web no está disponible en este momento. Inténtalo de nuevo en unos minutos.', {
    status: 503,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'retry-after': '60' },
  });
}
if (!site) {
  return new Response('Esta web no existe o no está publicada.', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}

// Resultado de un envío sin JavaScript (el formulario vuelve aquí).
const q = Astro.url.searchParams;
const result = q.get('solicitud') === 'ok'
  ? { ok: true, ref: (q.get('ref') ?? '').replace(/[^A-Z0-9]/g, '').slice(0, 8) }
  : q.get('solicitud') === 'error' ? { ok: false } : null;
const isSales = q.get('tipo') === 'digitalizacion';

Astro.response.headers.set('cache-control', 'no-store');
const premium = site.design === 'premium';
const title = premium && site.content.hero.title
  ? `${site.name} · ${site.content.hero.title}`
  : [site.name, site.content.tagline || 'Taller mecánico', site.content.city].filter(Boolean).join(' · ');
---
<SiteLayout site={site} title={title} premium={premium}>
  {premium ? (
    <PremiumHome
      site={site}
      turnstileSiteKey={turnstileSiteKey()}
      noJsResult={isSales ? null : result}
      salesResult={isSales ? result : null}
      status={{ plateLookup: vehicleLookupAvailable(), email: emailAvailable() }}
    />
  ) : (
    <ClassicHome site={site} turnstileSiteKey={turnstileSiteKey()} noJsResult={result} />
  )}
</SiteLayout>
