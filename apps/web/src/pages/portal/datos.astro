---
/**
 * Mis datos: lo que cada taller tiene registrado del cliente (solo lectura), la
 * cuenta y las preferencias de comunicación.
 *
 *  · Avisos de las reparaciones: siempre en el portal y, si el cliente quiere,
 *    también por email, por WhatsApp o por los dos. WhatsApp solo lo puede
 *    pedir el propio cliente (aquí) y necesita un móvil en su ficha.
 *  · Recordatorios de mantenimiento (revisión por fecha o por km): solo si el
 *    cliente los pide aquí; el taller solo puede retirarlos.
 *  · Comunicaciones comerciales: por separado y desactivadas de entrada.
 */
import PortalLayout from '../../layouts/PortalLayout.astro';
import Icon from '../../components/Icon.astro';
import Flash from '../../components/panel/Flash.astro';
import NotLinked from '../../components/portal/NotLinked.astro';
import { portalPage } from '../../lib/server/portal.ts';
import { field, isUuid } from '../../lib/server/panel.ts';
import { logAuth } from '../../lib/server/auth.ts';
import { formatDate } from '../../lib/panel/format.ts';
import { pushKeys } from '../../lib/server/config.ts';

export const prerender = false;

const portal = await portalPage(Astro);
if (portal instanceof Response) return portal;

let flash: { kind: 'ok' | 'bad'; text: string } = { kind: 'ok', text: '' };
if (portal.form && field(portal.form, 'action') === 'preferencias') {
  const customerId = field(portal.form, 'customer_id');
  // La base de datos comprueba que la ficha es del propio cliente.
  const { error } = isUuid(customerId)
    ? await portal.supabase.rpc('set_contact_preferences', {
        p_customer_id: customerId,
        p_operational_email: portal.form.get('operational_email') === 'on',
        p_marketing_email: portal.form.get('marketing_email') === 'on',
        p_operational_whatsapp: portal.form.get('operational_whatsapp') === 'on',
      })
    : { error: { code: '22023', message: '' } };
  const reminders = error ? null : await portal.supabase.rpc('set_service_reminders', {
    p_customer_id: customerId, p_enabled: portal.form.get('service_reminders') === 'on',
  });
  if (reminders?.error) {
    logAuth('portal_reminders_error', reminders.error.code);
    flash = { kind: 'bad', text: 'No se han guardado tus preferencias. Inténtalo de nuevo.' };
    Astro.response.status = 400;
  } else if (error) {
    logAuth('portal_preferences_error', error.code);
    const noMobile = error.code === '22023' && /móvil/.test(error.message ?? '');
    flash = { kind: 'bad', text: noMobile
      ? 'Para recibir avisos por WhatsApp hace falta un móvil en tu ficha. Pídele al taller que lo añada.'
      : 'No se han guardado tus preferencias. Inténtalo de nuevo.' };
    Astro.response.status = 400;
  } else flash = { kind: 'ok', text: 'Preferencias guardadas.' };
}

interface Prefs {
  customer_id: string; workshop_name: string; has_email: boolean; operational_email: boolean; marketing_email: boolean;
  has_whatsapp_number: boolean; whatsapp_hint: string | null; operational_whatsapp: boolean; workshop_email: boolean; workshop_whatsapp: boolean;
}
let prefs: Prefs[] = [];
let reminderPrefs: Array<{ customer_id: string; enabled: boolean }> = [];
if (portal.records.length > 0) {
  const [{ data, error }, rem] = await Promise.all([
    portal.supabase.rpc('portal_contact_preferences'),
    portal.supabase.rpc('portal_service_reminders'),
  ]);
  if (error) logAuth('portal_preferences_load_error', error.code);
  if (rem.error) logAuth('portal_reminders_load_error', rem.error.code);
  prefs = (data ?? []) as Prefs[];
  reminderPrefs = (rem.data ?? []) as typeof reminderPrefs;
}
// Notificaciones en el móvil (Web Push): solo si la plataforma tiene sus claves.
const pushPublicKey = pushKeys()?.publicKey ?? '';
const prefsOf = (customerId: string) => prefs.find(p => p.customer_id === customerId);
const remindersOn = (customerId: string) => reminderPrefs.some(p => p.customer_id === customerId && p.enabled);
---
<PortalLayout portal={portal} title="Mis datos" section="datos">
  <header class="pnl-head"><div><h1 class="pnl-title">Mis datos</h1><p class="pnl-sub">Los datos que tu taller tiene registrados. Si alguno no es correcto, díselo al taller.</p></div></header>
  <Flash kind={flash.kind} text={flash.text} />
  <section class="card" aria-labelledby="cuenta">
    <h2 id="cuenta" class="card-title"><Icon name="shield" />Tu cuenta</h2>
    <dl class="facts"><dt>Correo de acceso</dt><dd>{portal.user.email}</dd></dl>
    <nav class="auth-links" style="justify-content:flex-start"><a href="/cuenta/contrasena">Cambiar la contraseña</a><a href="/cuenta">Mi cuenta</a></nav>
  </section>
  <section class="card push-card" aria-labelledby="movil-t" data-push data-key={pushPublicKey}>
    <h2 id="movil-t" class="card-title"><Icon name="bell" />Notificaciones en este móvil</h2>
    <p>Un aviso en la pantalla de tu móvil cada vez que tu taller cambie el estado de tu coche, como los de una app. Es gratis y solo vale para este dispositivo.</p>
    {pushPublicKey ? (
      <>
        <p class="hint" data-push-state="nojs">Para activarlas, tu navegador tiene que permitir JavaScript.</p>
        <p class="hint" data-push-state="unsupported" hidden>Este navegador no admite notificaciones. Prueba con Chrome, Safari, Firefox o Edge actualizados.</p>
        <p class="hint" data-push-state="ios" hidden>En iPhone: toca <strong>Compartir</strong> y después <strong>Añadir a pantalla de inicio</strong>. Abre el portal desde ese icono y vuelve aquí para activarlas.</p>
        <p class="hint" data-push-state="denied" hidden>Las notificaciones están bloqueadas para esta web. Permítelas en los ajustes del navegador y vuelve a intentarlo.</p>
        <p class="hint" data-push-state="on" hidden role="status"><strong>Activadas en este dispositivo.</strong></p>
        <p class="hint" data-push-state="error" hidden role="alert">No se han podido activar. Inténtalo de nuevo en un momento.</p>
        <div class="pnl-actions">
          <button class="btn btn-primary" type="button" data-push-on hidden><span class="spinner" aria-hidden="true"></span><span data-label>Activar en este móvil</span></button>
          <button class="btn" type="button" data-push-off hidden><span class="spinner" aria-hidden="true"></span><span data-label>Desactivar en este móvil</span></button>
        </div>
      </>
    ) : (
      <p class="hint">Todavía no están disponibles. Mientras, tienes todos los avisos aquí, en tu portal.</p>
    )}
  </section>
  {portal.records.length === 0 ? <div class="mt-l"><NotLinked loadError={portal.loadError} /></div> : portal.records.map(r => {
    const p = prefsOf(r.customer_id);
    return (
      <section class="card" aria-label={`Ficha en ${r.workshop_name}`}>
        <h2 class="card-title"><Icon name="user" />{r.workshop_name}</h2>
        <dl class="facts">
          <dt>Nombre</dt><dd>{r.full_name}</dd>
          <dt>Teléfono</dt><dd>{r.phone ?? 'No registrado'}</dd>
          <dt>Correo</dt><dd>{r.email ?? 'No registrado'}</dd>
          {r.linked_at && <><dt>Portal vinculado</dt><dd>desde el {formatDate(r.linked_at)}</dd></>}
          {r.workshop_phone && <><dt>Teléfono del taller</dt><dd>{r.workshop_phone}</dd></>}
        </dl>
        {p && (
          <form method="post" class="form-stack mt-l" data-busy="Guardando…" aria-label={`Comunicaciones de ${r.workshop_name}`}>
            <input type="hidden" name="action" value="preferencias" />
            <input type="hidden" name="customer_id" value={r.customer_id} />
            <h3 class="card-title" style="margin:0"><Icon name="bell" />Comunicaciones</h3>
            <fieldset class="channels">
              <legend>¿Dónde quieres recibir los avisos de tus reparaciones?</legend>
              <p class="hint">Vehículo recibido, esperando recambios, listo para recoger… Puedes elegir uno, dos o los tres.</p>
              <label class="check">
                <input type="checkbox" checked disabled aria-describedby={`portal-${r.customer_id}`} />
                <span><strong>En este portal</strong> <span id={`portal-${r.customer_id}`}>(siempre: aquí tienes el historial completo).</span></span>
              </label>
              <label class="check">
                <input type="checkbox" name="operational_email" checked={p.operational_email} />
                <span><strong>Por email</strong>
                  {!p.has_email ? ' · El taller no tiene tu correo: hasta que lo añada, no te llegarán emails.'
                    : !p.workshop_email ? ' · Tu taller todavía no envía emails: te llegarán cuando los active.' : ''}</span>
              </label>
              <label class="check">
                <input type="checkbox" name="operational_whatsapp" checked={p.operational_whatsapp}
                  disabled={!p.has_whatsapp_number && !p.operational_whatsapp} />
                <span><strong>Por WhatsApp</strong>
                  {p.has_whatsapp_number ? ` al móvil acabado en ${p.whatsapp_hint}.` : ' · Hace falta un móvil en tu ficha: pídele al taller que lo añada.'}
                  {p.has_whatsapp_number && !p.workshop_whatsapp && ' Tu taller todavía no envía WhatsApp: te llegarán cuando los active.'}
                  {' '}Solo avisos de tus reparaciones, nunca publicidad.</span>
              </label>
            </fieldset>
            <label class="check">
              <input type="checkbox" name="service_reminders" checked={remindersOn(r.customer_id)} />
              <span><strong>Recordatorios de mantenimiento.</strong> Te avisamos cuando se acerque la próxima revisión de tu vehículo (por fecha o por kilómetros), por los mismos canales que elijas arriba. Opcional.</span>
            </label>
            <label class="check">
              <input type="checkbox" name="marketing_email" checked={p.marketing_email} />
              <span><strong>Ofertas y promociones de {r.workshop_name} por email.</strong> Opcional y separado de los avisos de tus reparaciones. Puedes retirarlo cuando quieras.</span>
            </label>
            <button class="btn" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Guardar preferencias</span></button>
          </form>
        )}
      </section>
    );
  })}
</PortalLayout>

<script>
  import { setupPush } from '../../scripts/push.ts';
  setupPush();
</script>

<style>
  .push-card .pnl-actions { margin-top: 8px; }
  .channels { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; min-width: 0; }
  .channels legend { padding: 0; font-weight: 600; margin-bottom: 2px; }
  .channels .hint { margin: 0 0 4px; }
</style>
