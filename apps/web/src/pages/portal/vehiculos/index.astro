---
/** Mis vehículos: solo los vinculados a las fichas del cliente. */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import StatusBadge from '../../../components/panel/StatusBadge.astro';
import Flash from '../../../components/panel/Flash.astro';
import NotLinked from '../../../components/portal/NotLinked.astro';
import { portalPage } from '../../../lib/server/portal.ts';
import { logAuth } from '../../../lib/server/auth.ts';
import { formatPlate, FUEL_LABELS, type FuelType, type RepairStatus } from '@talleres/core';

export const prerender = false;

const portal = await portalPage(Astro);
if (portal instanceof Response) return portal;

interface Vehicle { id: string; workshop_name: string; plate: string; make: string; model: string; year: number | null; fuel: FuelType | null; active_status: RepairStatus | null }
let vehicles: Vehicle[] = [];
let error = false;
if (portal.records.length > 0) {
  const { data, error: e } = await portal.supabase.rpc('portal_vehicles');
  if (e) { logAuth('portal_vehicles_error', e.code); error = true; }
  vehicles = (data ?? []) as Vehicle[];
}
---
<PortalLayout portal={portal} title="Mis vehículos" section="vehiculos">
  <header class="pnl-head"><div><h1 class="pnl-title">Mis vehículos</h1><p class="pnl-sub">Los vehículos que el taller tiene registrados a tu nombre.</p></div></header>
  {portal.records.length === 0 ? <NotLinked loadError={portal.loadError} /> : (
    <>
      {error && <Flash kind="bad" text="No hemos podido cargar tus vehículos. Recarga la página." />}
      {vehicles.length === 0 ? (
        <div class="empty"><strong>Todavía no tienes vehículos registrados.</strong><span>Si crees que falta alguno, díselo a tu taller.</span></div>
      ) : (
        <div class="cards">
          {vehicles.map(v => (
            <a class="vcard" href={`/portal/vehiculos/${v.id}`}>
              <span class="plate" style="align-self:flex-start">{formatPlate(v.plate)}</span>
              <span class="vcard-title">{v.make} {v.model}</span>
              <span class="row-meta">{[v.year ? `Año ${v.year}` : null, v.fuel ? FUEL_LABELS[v.fuel] : null, v.workshop_name].filter(Boolean).join(' · ')}</span>
              {v.active_status ? <StatusBadge status={v.active_status} /> : <span class="row-meta">Sin reparaciones en curso</span>}
            </a>
          ))}
        </div>
      )}
    </>
  )}
</PortalLayout>
