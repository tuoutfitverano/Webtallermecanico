---
/**
 * Un vehículo del cliente y sus reparaciones. Si no es suyo, como si no existiera.
 * «Quitar de mi portal» (en dos pasos): va a la papelera 30 días; el taller lo conserva siempre.
 */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import Icon from '../../../components/Icon.astro';
import StatusBadge from '../../../components/panel/StatusBadge.astro';
import NotLinked from '../../../components/portal/NotLinked.astro';
import Flash from '../../../components/panel/Flash.astro';
import { portalPage } from '../../../lib/server/portal.ts';
import { field, isUuid } from '../../../lib/server/panel.ts';
import { logAuth } from '../../../lib/server/auth.ts';
import { formatDate, formatDateTime, formatDay } from '../../../lib/panel/format.ts';
import { formatPlate, FUEL_LABELS, orderLabel, YEAR_KIND_LABELS, type FuelType, type RepairStatus, type YearKind } from '@talleres/core';

export const prerender = false;

const portal = await portalPage(Astro);
if (portal instanceof Response) return portal;
const id = Astro.params.id ?? '';

interface Vehicle { id: string; workshop_name: string; plate: string; make: string; model: string; year: number | null; year_kind: YearKind | null; fuel: FuelType | null;
  version: string | null; mileage: number | null; next_service_date: string | null; next_service_km: number | null; next_service_notes: string | null }
interface Order { id: string; number: number; status: RepairStatus; received_at: string; last_update: string; problem_description: string }
let flash: { kind: 'ok' | 'bad'; text: string } = { kind: 'ok', text: Astro.url.searchParams.get('anadido') === '1' ? 'Vehículo añadido. El taller revisará los datos.' : Astro.url.searchParams.get('recuperado') === '1' ? 'Vehículo recuperado.' : '' };
let askRemove = false;
if (portal.form && portal.records.length > 0 && isUuid(id)) {
  const action = field(portal.form, 'action');
  if (action === 'pedir-quitar') askRemove = true;
  else if (action === 'quitar') {
    const { error } = await portal.supabase.rpc('portal_remove_vehicle', { p_vehicle_id: id });
    if (!error) return Astro.redirect('/portal/vehiculos/papelera?quitado=1', 303);
    logAuth('portal_vehicle_remove_error', error.code);
    flash = { kind: 'bad', text: error.code === '22023' && error.message ? error.message : 'No se ha podido quitar el vehículo.' };
    Astro.response.status = 400;
  }
}

let vehicle: Vehicle | null = null;
let orders: Order[] = [];
let services: Array<{ name: string; last_done_on: string; next_due_on: string | null; next_due_km: number | null }> = [];
if (portal.records.length > 0 && isUuid(id)) {
  const [v, o, s] = await Promise.all([
    portal.supabase.rpc('portal_vehicles'),
    portal.supabase.rpc('portal_orders', { p_filter: 'todas', p_vehicle_id: id }),
    portal.supabase.rpc('portal_vehicle_services', { p_vehicle_id: id }),
  ]);
  vehicle = ((v.data ?? []) as Vehicle[]).find(x => x.id === id) ?? null;
  orders = vehicle ? (o.data ?? []) as Order[] : [];
  services = vehicle ? (s.data ?? []) as typeof services : [];
}
if (portal.records.length > 0 && !vehicle) Astro.response.status = 404;
const km = (n: number) => `${n.toLocaleString('es-ES')} km`;
const hasService = Boolean(vehicle && (vehicle.next_service_date || vehicle.next_service_km !== null || vehicle.next_service_notes));
---
<PortalLayout portal={portal} title={vehicle ? `${vehicle.make} ${vehicle.model}` : 'Vehículo'} section="vehiculos">
  <a class="pnl-back" href="/portal/vehiculos"><Icon name="arrow" />Mis vehículos</a>
  {portal.records.length === 0 ? <NotLinked loadError={portal.loadError} /> : !vehicle ? (
    <div class="empty"><strong>Vehículo no encontrado.</strong><span>No existe o no está registrado a tu nombre.</span><a class="btn" href="/portal/vehiculos">Volver a mis vehículos</a></div>
  ) : (
    <>
      <header class="pnl-head">
        <div>
          <h1 class="pnl-title">{vehicle.make} {vehicle.model}</h1>
          <p class="pnl-sub"><span class="plate">{formatPlate(vehicle.plate)}</span> · {vehicle.workshop_name}</p>
        </div>
      </header>
      <Flash kind={flash.kind} text={flash.text} />
      <div class="grid-2">
        <section class="card" aria-labelledby="rep">
          <h2 id="rep" class="card-title"><Icon name="history" />Reparaciones</h2>
          {orders.length === 0 ? <p class="hint">Este vehículo no tiene reparaciones registradas a tu nombre.</p> : (
            <ul class="list">{orders.map(o => (
              <li><a class="row" href={`/portal/reparaciones/${o.id}`}>
                <span class="row-main">
                  <span class="row-title"><span class="num">{orderLabel(o.number)}</span>Recibido el {formatDate(o.received_at)}</span>
                  <span class="row-meta">{o.problem_description}</span>
                  <span class="row-meta">Última novedad {formatDateTime(o.last_update)}</span>
                </span>
                <span class="row-side"><StatusBadge status={o.status} /></span>
              </a></li>
            ))}</ul>
          )}
        </section>
        <section class="card" aria-labelledby="datos">
          <h2 id="datos" class="card-title"><Icon name="car" />Datos del vehículo</h2>
          <dl class="facts">
            <dt>Matrícula</dt><dd>{formatPlate(vehicle.plate)}</dd>
            <dt>Marca y modelo</dt><dd>{vehicle.make} {vehicle.model}{vehicle.version && ` ${vehicle.version}`}</dd>
            {vehicle.year && <><dt>Año</dt><dd>{vehicle.year}{vehicle.year_kind ? ` (${YEAR_KIND_LABELS[vehicle.year_kind].toLowerCase()})` : ''}</dd></>}
            {vehicle.fuel && <><dt>Combustible</dt><dd>{FUEL_LABELS[vehicle.fuel]}</dd></>}
            {vehicle.mileage !== null && <><dt>Últimos kilómetros anotados</dt><dd>{km(vehicle.mileage)}</dd></>}
            <dt>Taller</dt><dd>{vehicle.workshop_name}</dd>
          </dl>
          <p class="hint" style="margin-top:12px">Si algún dato no es correcto, díselo a tu taller.</p>
        </section>
        <section class="card" aria-labelledby="revision">
          <h2 id="revision" class="card-title"><Icon name="calendar" />Próxima revisión y mantenimientos</h2>
          {hasService && (
            <dl class="facts">
              {vehicle.next_service_date && <><dt>Fecha recomendada</dt><dd>{formatDay(vehicle.next_service_date)}</dd></>}
              {vehicle.next_service_km !== null && <><dt>O a los</dt><dd>{km(vehicle.next_service_km)}</dd></>}
              {vehicle.next_service_notes && <><dt>Recomendación del taller</dt><dd>{vehicle.next_service_notes}</dd></>}
            </dl>
          )}
          {services.length > 0 && (
            <ul class="list" aria-label="Mantenimientos" style={hasService ? 'margin-top:12px' : undefined}>
              {services.map(x => (
                <li class="row"><span class="row-main">
                  <span class="row-title">{x.name}</span>
                  <span class="row-meta">Próximo: {[x.next_due_on && formatDay(x.next_due_on), x.next_due_km !== null && `a los ${km(x.next_due_km)}`].filter(Boolean).join(' o ') || 'sin fecha'} · último el {formatDay(x.last_done_on)}</span>
                </span></li>
              ))}
            </ul>
          )}
          {!hasService && services.length === 0 && <p class="hint">Tu taller todavía no ha anotado la próxima revisión ni otros mantenimientos.</p>}
          <p class="hint" style="margin-top:12px">Las fechas son orientativas (lo primero que llegue: la fecha o los kilómetros).</p>
          <p class="hint" style="margin-top:12px">Si quieres que te lo recordemos, actívalo en <a href="/portal/datos">Mis datos</a>.</p>
        </section>
        <section class="card" aria-labelledby="quitar-t">
          <h2 id="quitar-t" class="card-title">¿Ya no tienes este vehículo?</h2>
          {askRemove ? (
            <form method="post" class="confirm" data-busy="Quitando…">
              <input type="hidden" name="action" value="quitar" />
              <strong>¿Quitar {formatPlate(vehicle.plate)} de tu portal?</strong>
              <span class="hint">Irá a tu papelera y podrás recuperarlo durante 30 días. El taller conserva siempre sus revisiones y reparaciones.</span>
              <div class="pnl-actions">
                <button class="btn btn-danger" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Sí, quitarlo</span></button>
                <a class="btn" href={`/portal/vehiculos/${vehicle.id}`}>Cancelar</a>
              </div>
            </form>
          ) : (
            <form method="post">
              <input type="hidden" name="action" value="pedir-quitar" />
              <button class="btn btn-sm btn-danger" type="submit">Quitar de mi portal…</button>
              <p class="hint" style="margin-top:8px">No se borra: va a la papelera durante 30 días.</p>
            </form>
          )}
        </section>
      </div>
    </>
  )}
</PortalLayout>
