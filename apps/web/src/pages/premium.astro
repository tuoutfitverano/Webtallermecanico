---
/**
 * Diseño alternativo «premium» de la web del taller (se compara con el de la
 * portada; no la sustituye). Mismos datos reales que la portada:
 *  · Contenido del taller (servicios, dirección, teléfono) de la base de datos.
 *  · Formularios reales de cita/presupuesto/contacto (RequestForms).
 *  · Software: capturas reales del panel y del portal (public/demo/autovalue/software,
 *    hechas con los datos de demostración) y solo funciones que existen en el código.
 *  · Fases: nombres y estado de docs/ROADMAP.md.
 *  · Proceso: los seis estados reales de una orden y el texto que ve el cliente.
 */
import '@fontsource-variable/archivo/standard.css';
import '../styles/premium.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import DemoNotice from '../components/DemoNotice.astro';
import ScrollStage from '../components/ScrollStage.astro';
import RequestForms from '../components/RequestForms.astro';
import Icon from '../components/Icon.astro';
import { siteForHost, turnstileSiteKey } from '../lib/server/config.ts';
import { telHref } from '../lib/site/content.ts';
import { REPAIR_STATUSES, REPAIR_STATUS_CUSTOMER_TEXT, REPAIR_STATUS_LABELS } from '@talleres/core';

export const prerender = false;

let site;
try {
  site = await siteForHost(Astro.request.headers.get('host') ?? Astro.url.host);
} catch {
  return new Response('La web no está disponible en este momento. Inténtalo de nuevo en unos minutos.', {
    status: 503,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'retry-after': '60' },
  });
}
if (!site) {
  return new Response('Esta web no existe o no está publicada.', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}
Astro.response.headers.set('cache-control', 'no-store');

const c = site.content;
const tel = telHref(c.phone);
const name = site.name.toUpperCase();
const SW = '/demo/autovalue/software';

// Funciones del software que existen hoy en el código (ver docs/INTEGRACION.md).
const features = [
  {
    id: 'ordenes', kicker: 'Órdenes de reparación', title: 'Cada coche, un expediente.',
    text: 'Seis estados claros, mecánico asignado, diagnosis y trabajo realizado. El historial de cambios lo escribe el propio sistema: nadie puede alterarlo.',
    img: `${SW}/orden.webp`, w: 1600, h: 1222, alt: 'Detalle de una orden de reparación en el panel del taller (datos de demostración)', status: null,
  },
  {
    id: 'portal', kicker: 'Portal del cliente', title: 'Tu reparación, en tu móvil.',
    text: 'El cliente ve el estado de su coche, los mensajes del taller y el historial. Solo lo suyo y solo lo que el taller decide mostrarle.',
    img: `${SW}/portal-reparacion.webp`, w: 780, h: 1688, alt: 'Detalle de una reparación en el portal del cliente, en el móvil (datos de demostración)', status: null, phone: true,
  },
  {
    id: 'avisos', kicker: 'Avisos automáticos', title: 'Te avisamos cuando cambia algo.',
    text: 'Cada cambio real de estado genera un aviso en el portal del cliente. El envío por email está preparado y se activa al configurar el proveedor de correo.',
    img: `${SW}/avisos.webp`, w: 1600, h: 1000, alt: 'Registro de avisos a clientes en el panel (datos de demostración)', status: 'Email pendiente de activar',
  },
  {
    id: 'solicitudes', kicker: 'Solicitudes web', title: 'De la web al taller, sin perder nada.',
    text: 'Las peticiones de cita, presupuesto o contacto llegan a una bandeja del panel. Una cita solicitada no es una cita confirmada: el taller te contacta.',
    img: `${SW}/solicitudes.webp`, w: 1600, h: 1000, alt: 'Bandeja de solicitudes de la web en el panel (datos de demostración)', status: null,
  },
  {
    id: 'equipo', kicker: 'Equipo y permisos', title: 'Cada persona ve lo suyo.',
    text: 'Propietario, administración y mecánicos con permisos distintos, comprobados en la base de datos. Un mecánico solo ve las órdenes que tiene asignadas.',
    img: `${SW}/trabajador.webp`, w: 1600, h: 1000, alt: 'Inicio del panel visto por un mecánico: solo sus trabajos (datos de demostración)', status: null,
  },
];

// docs/ROADMAP.md (Fases 1–8). Fueron etapas de construcción; varias se convirtieron en módulos.
const phases = [
  { n: '01', name: 'Herramientas y prototipos', text: 'Navegador real para las pruebas y primeros prototipos de la web.', status: 'Completada' },
  { n: '02', name: 'Web del taller y solicitudes', text: 'Web pública por dominio y formularios reales de cita, presupuesto y contacto.', status: 'Completada' },
  { n: '03', name: 'Cuentas y arquitectura multitaller', text: 'Inicio de sesión, recuperación de contraseña, equipos con roles e invitaciones.', status: 'Completada' },
  { n: '04', name: 'Panel de gestión del taller', text: 'Clientes, vehículos, órdenes de reparación con historial y equipo.', status: 'Completada' },
  { n: '05', name: 'Portal del cliente', text: 'Vehículos, reparaciones, mensajes del taller e historial, por invitación.', status: 'Completada' },
  { n: '06', name: 'Datos por matrícula', text: 'Consulta de datos del vehículo con proveedor externo y revisión antes de guardar.', status: 'Pendiente de contratar el proveedor' },
  { n: '07', name: 'Notificaciones', text: 'Avisos automáticos por cada cambio de estado, en el portal y por email.', status: 'Email pendiente de credenciales' },
  { n: '08', name: 'Auditoría y producción', text: 'Revisión de seguridad, accesibilidad y preparación del despliegue.', status: 'Completada' },
];

const corners = [
  c.city ? `Taller multimarca · ${c.city}` : 'Taller multimarca',
  'Software de gestión propio',
  'Seguimiento online de cada reparación',
];
---
<SiteLayout site={site} title={`${site.name} · La mecánica, evolucionada`}>
  <div class="pm">
    <DemoNotice site={site} />

    <script is:inline>document.documentElement.classList.add('pm-js');</script>
    <header class="pm-header" data-pm-header>
      <a href="#inicio" class="pm-logo" aria-label={`${site.name}, inicio`}>{name}</a>
      <nav class="pm-nav" id="pm-nav" aria-label="Secciones">
        <a href="#servicios">Servicios</a>
        <a href="#software">Software</a>
        <a href="#fases">Fases</a>
        <a href="#proceso">Proceso</a>
        <a href="/acceso" rel="nofollow">Área de clientes</a>
      </nav>
      <div class="pm-header-side">
        <a href="#solicitar" class="pm-btn pm-btn-light pm-hide-sm">Solicitar cita</a>
        <button class="pm-menu" type="button" aria-expanded="false" aria-controls="pm-nav" data-pm-menu>
          <span class="sr-only">Menú</span><span aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <main id="inicio">
      {site.scrollFrames ? (
        <ScrollStage frames={site.scrollFrames}>
          <section slot="first" class="pm-hero" aria-labelledby="pm-title">
            <ul class="pm-corners" aria-label="En pocas palabras">
              {corners.map((t, i) => <li class={`pm-corner pm-corner-${i}`}><span class="pm-tick" aria-hidden="true"></span>{t}</li>)}
            </ul>
            <div class="pm-hero-copy">
              <h1 id="pm-title" class="pm-display reveal" data-reveal>La mecánica,<br />evolucionada.</h1>
              <p class="pm-lead reveal" data-reveal style="--d:.15s">Precisión en cada reparación. Tecnología en cada proceso.</p>
              <div class="pm-actions reveal" data-reveal style="--d:.3s">
                <a href="#solicitar" class="pm-btn pm-btn-light">Solicitar cita <Icon name="arrowUpRight" /></a>
                <a href="#filosofia" class="pm-btn pm-btn-ghost">Descubrir {site.name}</a>
              </div>
            </div>
            <p class="pm-wordmark" aria-hidden="true">{name}</p>
            <a href="#filosofia" class="pm-scroll">Desliza<span aria-hidden="true"></span></a>
          </section>

          <div slot="second" class="pm-over">
            <section class="pm-section pm-philosophy" id="filosofia" aria-labelledby="filo-t">
              <p class="pm-kicker">01 — Filosofía</p>
              <h2 id="filo-t" class="pm-h2 reveal" data-reveal>Primero entender.<br />Después reparar.</h2>
              <div class="pm-cols">
                <p class="reveal" data-reveal>Revisamos el vehículo y te explicamos qué necesita antes de empezar.</p>
                <p class="reveal" data-reveal style="--d:.1s">Cada trabajo queda registrado en nuestro sistema, paso a paso.</p>
                <p class="reveal" data-reveal style="--d:.2s">Te avisamos cuando tu coche está listo para que pases a recogerlo.</p>
              </div>
            </section>

            {c.services.length > 0 && (
              <section class="pm-section pm-services" id="servicios" aria-labelledby="serv-t">
                <p class="pm-kicker">02 — Servicios</p>
                <h2 id="serv-t" class="pm-h2 reveal" data-reveal>El trabajo,<br />bien hecho.</h2>
                {c.brands && <p class="pm-note">Trabajamos con {c.brands.toLowerCase()}.</p>}
                <ol class="pm-service-list">
                  {c.services.map((s, i) => (
                    <li class="pm-service reveal" data-reveal>
                      <span class="pm-service-n">{String(i + 1).padStart(2, '0')}</span>
                      <div class="pm-service-body">
                        <h3>{s.name}</h3>
                        {s.description && <p>{s.description}</p>}
                      </div>
                      <a class="pm-link" href="#solicitar" data-service={s.id} aria-label={`Pedir cita: ${s.name}`}>Pedir cita <Icon name="arrowUpRight" /></a>
                    </li>
                  ))}
                </ol>
              </section>
            )}
          </div>
        </ScrollStage>
      ) : null}

      <section class="pm-section pm-software" id="software" aria-labelledby="soft-t">
        <p class="pm-kicker">03 — Software propio</p>
        <h2 id="soft-t" class="pm-h2 pm-h2-xl reveal" data-reveal>Un taller.<br />Un sistema más inteligente.</h2>
        <p class="pm-lead pm-measure reveal" data-reveal>Hemos desarrollado e integrado un software propio para conectar la gestión del taller con una experiencia de servicio más organizada, eficiente y transparente.</p>
        <div class="pm-stack" data-pm-stack>
          <figure class="pm-window pm-window-main" data-parallax="-0.04">
            <div class="pm-window-bar" aria-hidden="true"><span></span><span></span><span></span><em>Panel del taller · Inicio</em></div>
            <img src={`${SW}/panel-inicio.webp`} width="1600" height="1000" loading="lazy" decoding="async" alt="Inicio del panel del taller con los indicadores reales del día (datos de demostración)" />
          </figure>
          <figure class="pm-window pm-window-side" data-parallax="0.06">
            <div class="pm-window-bar" aria-hidden="true"><span></span><span></span><span></span><em>Órdenes</em></div>
            <img src={`${SW}/ordenes.webp`} width="1600" height="1000" loading="lazy" decoding="async" alt="Lista de órdenes de reparación con su estado (datos de demostración)" />
          </figure>
          <figure class="pm-phone" data-parallax="0.12">
            <img src={`${SW}/portal.webp`} width="780" height="1688" loading="lazy" decoding="async" alt="Portal del cliente en el móvil: aviso de vehículo listo para recoger (datos de demostración)" />
          </figure>
        </div>
        <p class="pm-caption">Capturas reales del software con datos de demostración.</p>
      </section>

      <section class="pm-section pm-features" aria-labelledby="feat-t">
        <p class="pm-kicker">04 — Lo que hace hoy</p>
        <h2 id="feat-t" class="pm-h2 reveal" data-reveal>Funciones reales,<br />no promesas.</h2>
        <div class="pm-feature-list">
          {features.map((f, i) => (
            <article class:list={['pm-feature', { 'pm-feature-flip': i % 2 === 1 }]} id={`f-${f.id}`}>
              <div class="pm-feature-copy">
                <p class="pm-kicker">{f.kicker}</p>
                <h3 class="pm-h3 reveal" data-reveal>{f.title}</h3>
                <p class="reveal" data-reveal>{f.text}</p>
                {f.status && <p class="pm-status pm-status-pending">{f.status}</p>}
              </div>
              <figure class:list={['pm-shot reveal', { 'pm-shot-phone': f.phone }]} data-reveal>
                <img src={f.img} width={f.w} height={f.h} loading="lazy" decoding="async" alt={f.alt} />
              </figure>
            </article>
          ))}
          <article class="pm-feature pm-feature-text" id="f-matricula">
            <div class="pm-feature-copy">
              <p class="pm-kicker">Datos por matrícula</p>
              <h3 class="pm-h3">La matrícula rellena la ficha.</h3>
              <p>El alta de vehículos está preparada para consultar sus datos con un proveedor externo y revisarlos antes de guardar. Nunca se rellena un dato que el proveedor no haya devuelto.</p>
              <p class="pm-status pm-status-pending">Pendiente de contratar el proveedor</p>
            </div>
          </article>
        </div>
      </section>

      <section class="pm-section pm-phases" id="fases" aria-labelledby="fases-t">
        <p class="pm-kicker">05 — Cómo se ha construido</p>
        <h2 id="fases-t" class="pm-h2 reveal" data-reveal>Ocho fases.<br />Un solo sistema.</h2>
        <p class="pm-lead pm-measure">El software no se hizo de golpe: se ha construido por etapas, y cada una terminó con algo funcionando y probado.</p>
        <ol class="pm-phase-list">
          {phases.map(p => (
            <li class="pm-phase reveal" data-reveal>
              <span class="pm-phase-n">{p.n}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
              <span class:list={['pm-status', { 'pm-status-pending': p.status !== 'Completada' }]}>{p.status}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="pm-section pm-process" id="proceso" aria-labelledby="proc-t">
        <p class="pm-kicker">06 — Proceso</p>
        <h2 id="proc-t" class="pm-h2 reveal" data-reveal>De la recepción<br />a la entrega.</h2>
        <p class="pm-lead pm-measure">Son los mismos pasos que registra nuestro sistema y que ves en tu portal, con el mismo texto.</p>
        <ol class="pm-steps" data-pm-progress>
          {REPAIR_STATUSES.map((s, i) => (
            <li class="pm-step reveal" data-reveal style={`--d:${i * 0.06}s`}>
              <span class="pm-step-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{REPAIR_STATUS_LABELS[s]}</h3>
              <p>{REPAIR_STATUS_CUSTOMER_TEXT[s]}</p>
            </li>
          ))}
        </ol>
      </section>

      <div class="pm-forms">
        <RequestForms site={site} turnstileSiteKey={turnstileSiteKey()} noJsResult={null} />
      </div>
    </main>

    <footer class="pm-footer">
      <p class="pm-footer-mark" aria-hidden="true">{name}</p>
      <div class="pm-footer-grid">
        <div>
          <p class="pm-kicker">Taller</p>
          <p>{site.name}</p>
          {c.address && <p>{c.address}</p>}
        </div>
        <div>
          <p class="pm-kicker">Contacto</p>
          {c.phone && (tel ? <p><a href={tel}>{c.phone}</a></p> : <p>{c.phone}</p>)}
          {c.email && <p>{c.email}</p>}
        </div>
        {c.hours.length > 0 && (
          <div>
            <p class="pm-kicker">Horario</p>
            {c.hours.map(h => <p>{h}</p>)}
          </div>
        )}
        <div>
          <p class="pm-kicker">Más</p>
          <p><a href="/acceso" rel="nofollow">Área de clientes</a></p>
          <p><a href="/aviso-legal">Aviso legal</a> · <a href="/privacidad">Privacidad</a> · <a href="/cookies">Cookies</a></p>
        </div>
      </div>
    </footer>
  </div>
  <script>
    import '../scripts/premium.ts';
  </script>
</SiteLayout>
