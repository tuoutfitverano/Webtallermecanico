---
/**
 * Cookies (LSSI-CE art. 22.2). En la web de un taller, con su plantilla; en el
 * dominio del área privada (sin web de taller), con la de la plataforma.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackLink from '../components/BackLink.astro';
import CookiesInfo from '../components/CookiesInfo.astro';
import PlatformLegalDoc from '../components/PlatformLegalDoc.astro';
import { siteForHost } from '../lib/server/config.ts';
import { LEGAL_DATE, LEGAL_VERSION } from '../lib/legal/platform.ts';
import { WEB_EXPORT } from '../lib/site/export.ts';
export const prerender = false;
const site = await siteForHost(Astro.request.headers.get('host') ?? Astro.url.host).catch(() => null);
---
{site ? (
  <SiteLayout site={site} title={`Cookies · ${site.name}`}>
    <SiteHeader site={site} />
    <main class="section legal-page glow">
      <div class="wrap legal legal-doc">
        <BackLink href="/" label="Volver a la web" />
        <p class="label">// Información legal</p>
        <h1 class="heading">Cookies</h1>
        {WEB_EXPORT ? (
          <>
            <p>Esta web <strong>no usa cookies</strong> ni guarda nada en tu navegador (tampoco en su almacenamiento local): no hay publicidad, analítica, inicio de sesión ni formularios. Por eso no te pide aceptar nada.</p>
            <p>Si el taller añade algo que las use (por ejemplo, un mapa o un formulario de otra empresa), lo indicará aquí antes.</p>
          </>
        ) : <CookiesInfo site />}
        <p class="legal-version">Versión {LEGAL_VERSION} · {LEGAL_DATE}</p>
        <p><a href="/">Volver a la web</a></p>
      </div>
    </main>
    <SiteFooter site={site} />
  </SiteLayout>
) : (
  <PlatformLegalDoc title="Cookies"><CookiesInfo site={false} /></PlatformLegalDoc>
)}
