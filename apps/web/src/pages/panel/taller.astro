---
/**
 * Datos y configuración del taller (propietario y administradores).
 *
 *  · Datos de la cuenta: los guarda RLS («workshops: edición gestores»); el
 *    identificador y el estado comercial los protege workshops_guard.
 *  · Web pública, dominios e integraciones: solo lectura. Se configuran desde
 *    la plataforma (ver docs/PUESTA_EN_MARCHA.md y docs/DESPLIEGUE.md).
 *  · Nunca se muestra ninguna clave: solo si cada servicio está activo o no.
 */
import PanelLayout from '../../layouts/PanelLayout.astro';
import Icon from '../../components/Icon.astro';
import NoWorkshop from '../../components/panel/NoWorkshop.astro';
import Flash from '../../components/panel/Flash.astro';
import { field, panelPage } from '../../lib/server/panel.ts';
import { logAuth } from '../../lib/server/auth.ts';
import { dbErrorMessage } from '../../lib/auth/messages.ts';
import { emailAvailable, turnstileSiteKey, vehicleLookupAvailable, whatsappAvailable } from '../../lib/server/config.ts';
import { formatDate, formatDateTime } from '../../lib/panel/format.ts';
import { LEGAL_VERSION } from '../../lib/legal/platform.ts';
import { billingSettingsSchema, fieldErrors, formatCents, parseEuros, workshopProfileSchema } from '@talleres/core';

export const prerender = false;

const panel = await panelPage(Astro);
if (panel instanceof Response) return panel;

interface WorkshopRow {
  name: string; legal_name: string | null; tax_id: string | null; contact_email: string | null;
  contact_phone: string | null; logo_url: string | null; status: string; created_at: string;
  address_line: string | null; postal_code: string | null; city: string | null; province: string | null;
  registry_info: string | null; legal_email: string | null;
}
interface Billing {
  default_tax_rate: number; quote_validity_days: number; labour_rate_cents: number | null; invoice_series: string; rectifying_series: string;
  payment_terms_days: number; quote_conditions: string | null; invoice_footer: string | null;
}
const values = { name: '', legal_name: '', tax_id: '', contact_email: '', contact_phone: '', logo_url: '', address_line: '', postal_code: '', city: '', province: '', registry_info: '', legal_email: '' };
const billValues = { default_tax_rate: '', quote_validity_days: '', labour_rate: '', invoice_series: '', rectifying_series: '', payment_terms_days: '', quote_conditions: '', invoice_footer: '' };
let billErrors: Partial<Record<string, string>> = {};
let billPosted = false;
let errors: Partial<Record<string, string>> = {};
let flash: { kind: 'ok' | 'bad'; text: string } = { kind: 'ok', text: Astro.url.searchParams.get('guardado') === '1' ? 'Datos del taller guardados.' : '' };
let posted = false;

if (panel.form && panel.workshop && field(panel.form, 'action') === 'datos') {
  posted = true;
  for (const k of Object.keys(values) as Array<keyof typeof values>) values[k] = field(panel.form, k);
  if (!panel.isManager) {
    // La base de datos tampoco lo permitiría (RLS): se responde sin intentarlo.
    flash = { kind: 'bad', text: 'Solo el propietario o un administrador pueden cambiar los datos del taller.' };
    Astro.response.status = 403;
  } else {
    const parsed = workshopProfileSchema.safeParse({
      name: values.name, legalName: values.legal_name, taxId: values.tax_id,
      contactEmail: values.contact_email, contactPhone: values.contact_phone, logoUrl: values.logo_url,
      addressLine: values.address_line, postalCode: values.postal_code, city: values.city, province: values.province,
      registryInfo: values.registry_info, legalEmail: values.legal_email,
    });
    if (!parsed.success) {
      errors = fieldErrors(parsed.error);
      flash = { kind: 'bad', text: 'Revisa los campos marcados.' };
      Astro.response.status = 422;
    } else {
      const d = parsed.data;
      const { data, error } = await panel.supabase.from('workshops')
        .update({
          name: d.name, legal_name: d.legalName, tax_id: d.taxId, contact_email: d.contactEmail, contact_phone: d.contactPhone, logo_url: d.logoUrl,
          address_line: d.addressLine, postal_code: d.postalCode, city: d.city, province: d.province,
          registry_info: d.registryInfo, legal_email: d.legalEmail,
        })
        .eq('id', panel.workshop.id).select('id');
      if (error || !data?.length) {
        logAuth('panel_workshop_update_error', error?.code);
        flash = { kind: 'bad', text: error ? dbErrorMessage(error) : 'No se ha guardado: no tienes permiso para cambiar este taller.' };
        Astro.response.status = 400;
      } else {
        // Redirección: el nombre nuevo aparece también en la cabecera del panel.
        return Astro.redirect('/panel/taller?guardado=1', 303);
      }
    }
  }
}

if (panel.form && panel.workshop && field(panel.form, 'action') === 'facturacion') {
  billPosted = true;
  for (const k of Object.keys(billValues) as Array<keyof typeof billValues>) billValues[k] = field(panel.form, k);
  const num = (t: string) => (t.trim() === '' ? Number.NaN : Number(t.trim().replace(',', '.')));
  const labour = billValues.labour_rate.trim() === '' ? null : parseEuros(billValues.labour_rate);
  const parsed = billingSettingsSchema.safeParse({
    defaultTaxRate: num(billValues.default_tax_rate), quoteValidityDays: num(billValues.quote_validity_days),
    labourRateCents: labour, invoiceSeries: billValues.invoice_series, rectifyingSeries: billValues.rectifying_series,
    paymentTermsDays: num(billValues.payment_terms_days), quoteConditions: billValues.quote_conditions, invoiceFooter: billValues.invoice_footer,
  });
  if (!panel.isManager) {
    flash = { kind: 'bad', text: 'Solo el propietario o un administrador pueden cambiar estos ajustes.' };
    Astro.response.status = 403;
  } else if (!parsed.success || (billValues.labour_rate.trim() !== '' && labour === null)) {
    billErrors = parsed.success ? {} : fieldErrors(parsed.error);
    if (billValues.labour_rate.trim() !== '' && labour === null) billErrors.labourRateCents = 'Escribe el precio, p. ej. 45 o 45,50.';
    flash = { kind: 'bad', text: 'Revisa los ajustes marcados.' };
    Astro.response.status = 422;
  } else {
    const d = parsed.data;
    const { data, error } = await panel.supabase.from('workshop_billing_settings').update({
      default_tax_rate: d.defaultTaxRate, quote_validity_days: d.quoteValidityDays, labour_rate_cents: d.labourRateCents,
      invoice_series: d.invoiceSeries, rectifying_series: d.rectifyingSeries, payment_terms_days: d.paymentTermsDays,
      quote_conditions: d.quoteConditions, invoice_footer: d.invoiceFooter,
    }).eq('workshop_id', panel.workshop.id).select('workshop_id');
    if (error || !data?.length) {
      logAuth('panel_billing_settings_error', error?.code);
      flash = { kind: 'bad', text: error ? dbErrorMessage(error) : 'No se han guardado los ajustes.' };
      Astro.response.status = 400;
    } else {
      flash = { kind: 'ok', text: 'Ajustes de presupuestos y facturas guardados.' };
      billPosted = false;
    }
  }
}

// Condiciones del servicio y contrato de encargo (RGPD art. 28): solo la propietaria las acepta.
const isOwner = panel.workshop?.role === 'propietario';
if (panel.form && panel.workshop && field(panel.form, 'action') === 'aceptar-condiciones') {
  if (field(panel.form, 'acepto') !== '1') {
    flash = { kind: 'bad', text: 'Marca la casilla para aceptar las condiciones y el contrato de encargo.' };
    Astro.response.status = 422;
  } else {
    const { error } = await panel.supabase.rpc('accept_platform_terms', { p_workshop_id: panel.workshop.id, p_version: LEGAL_VERSION });
    if (error) { logAuth('panel_terms_error', error.code); flash = { kind: 'bad', text: dbErrorMessage(error) }; Astro.response.status = 400; }
    else flash = { kind: 'ok', text: `Condiciones y contrato de encargo aceptados (versión ${LEGAL_VERSION}).` };
  }
}

let workshop: WorkshopRow | null = null;
let accepted: { accepted_at: string } | null = null;
let billing: Billing | null = null;
let site: { published: boolean; is_demo_content: boolean } | null = null;
let domains: Array<{ hostname: string; is_primary: boolean }> = [];
let loadError = false;
interface Usage {
  plan: string; whatsapp: number; matriculas: number; whatsapp_cents: number; matriculas_cents: number;
  whatsapp_unit_cents: number; whatsapp_discounted_cents: number; whatsapp_limit: number;
  matricula_unit_cents: number; matricula_discounted_cents: number; matricula_limit: number;
}
let usage: Usage | null = null;
if (panel.workshop && panel.isManager) {
  const id = panel.workshop.id;
  const [w, s, d, b] = await Promise.all([
    panel.supabase.from('workshops').select('name, legal_name, tax_id, contact_email, contact_phone, logo_url, status, created_at, address_line, postal_code, city, province, registry_info, legal_email').eq('id', id).maybeSingle(),
    panel.supabase.from('workshop_sites').select('published, is_demo_content').eq('workshop_id', id).maybeSingle(),
    panel.supabase.from('workshop_domains').select('hostname, is_primary').eq('workshop_id', id).order('is_primary', { ascending: false }),
    panel.supabase.from('workshop_billing_settings').select('default_tax_rate, quote_validity_days, labour_rate_cents, invoice_series, rectifying_series, payment_terms_days, quote_conditions, invoice_footer').eq('workshop_id', id).maybeSingle(),
  ]);
  const u = await panel.supabase.rpc('workshop_usage', { p_workshop_id: id });
  if (u.error) logAuth('panel_usage_error', u.error.code);
  usage = ((u.data ?? []) as Usage[])[0] ?? null;
  const { data: acc } = await panel.supabase.from('workshop_legal_acceptances').select('accepted_at')
    .eq('workshop_id', id).eq('document', 'encargo').eq('version', LEGAL_VERSION).maybeSingle();
  accepted = acc ?? null;
  billing = (b.data as Billing | null) ?? null;
  if (billing && !billPosted) {
    Object.assign(billValues, {
      default_tax_rate: String(Number(billing.default_tax_rate)).replace('.', ','), quote_validity_days: String(billing.quote_validity_days),
      labour_rate: billing.labour_rate_cents === null ? '' : (Number(billing.labour_rate_cents) / 100).toFixed(2).replace('.', ','),
      invoice_series: billing.invoice_series, rectifying_series: billing.rectifying_series, payment_terms_days: String(billing.payment_terms_days),
      quote_conditions: billing.quote_conditions ?? '', invoice_footer: billing.invoice_footer ?? '',
    });
  }
  if (w.error || !w.data) { logAuth('panel_workshop_load_error', w.error?.code); loadError = true; }
  workshop = (w.data as WorkshopRow | null) ?? null;
  site = s.data ?? null;
  domains = d.data ?? [];
  if (workshop && !posted) {
    Object.assign(values, {
      name: workshop.name, legal_name: workshop.legal_name ?? '', tax_id: workshop.tax_id ?? '', contact_email: workshop.contact_email ?? '',
      contact_phone: workshop.contact_phone ?? '', logo_url: workshop.logo_url ?? '',
      address_line: workshop.address_line ?? '', postal_code: workshop.postal_code ?? '', city: workshop.city ?? '', province: workshop.province ?? '',
      registry_info: workshop.registry_info ?? '', legal_email: workshop.legal_email ?? '',
    });
  }
}

const STATUS_LABELS: Record<string, string> = { demo: 'Demostración', activo: 'Activo', suspendido: 'Suspendido' };
const PLAN_LABELS: Record<string, string> = { profesional: 'Profesional', premium: 'Premium' };
const MONTH = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' }).format(new Date());
/** «0,06 € cada uno» o «0,04 € los 300 primeros del mes; después, 0,06 €». */
const tariff = (unit: number, discounted: number, limit: number, word: string) =>
  limit > 0 && discounted !== unit
    ? `${formatCents(discounted)} ${word === 'aviso' ? 'los' : 'las'} ${limit} primer${word === 'aviso' ? 'os' : 'as'} del mes; después, ${formatCents(unit)}`
    : `${formatCents(unit)} cada ${word === 'aviso' ? 'uno' : 'una'}`;
const err = (k: string) => errors[k];
const berr = (k: string) => billErrors[k];
const integrations = [
  { name: 'Formularios de la web (antispam)', on: Boolean(turnstileSiteKey()), off: 'Sin antispam configurado: la web no acepta solicitudes (responde «no disponible»), nunca finge que se han enviado.' },
  { name: 'Emails a clientes', on: emailAvailable(), off: 'Sin proveedor de email: los avisos aparecen en el portal del cliente y los emails quedan pendientes.' },
  { name: 'WhatsApp a clientes', on: whatsappAvailable(), off: 'Sin la API de WhatsApp Business: los clientes pueden pedirlo, pero esos avisos quedan pendientes (nunca se dan por enviados).' },
  { name: 'Consulta de datos por matrícula', on: vehicleLookupAvailable(), off: 'Sin proveedor contratado: los vehículos se dan de alta a mano.' },
];
---
<PanelLayout panel={panel} title="Taller" section="taller">
  <header class="pnl-head">
    <div>
      <h1 class="pnl-title">Taller</h1>
      <p class="pnl-sub">Datos de la cuenta del taller, web pública y servicios conectados.</p>
    </div>
  </header>
  {!panel.workshop ? <NoWorkshop loadError={panel.loadError} /> : !panel.isManager ? (
    <div class="empty"><strong>Solo el propietario o un administrador gestionan los datos del taller.</strong><a class="btn" href="/panel">Volver al inicio</a></div>
  ) : (
    <>
      <Flash kind={flash.kind} text={flash.text} />
      {loadError && <Flash kind="bad" text="No se han podido cargar los datos del taller. Recarga la página." />}
      <div class="grid-2">
        <section class="card" aria-labelledby="datos-t">
          <h2 id="datos-t" class="card-title"><Icon name="wrench" />Datos del taller</h2>
          <form method="post" class="form-stack" data-busy="Guardando…" novalidate>
            <input type="hidden" name="action" value="datos" />
            <div class={`field ${err('name') ? 'has-error' : ''}`}>
              <label for="name">Nombre comercial</label>
              <input class="input" id="name" name="name" required maxlength="120" value={values.name} aria-invalid={err('name') ? 'true' : undefined} aria-describedby={err('name') ? 'name-err' : undefined} />
              {err('name') && <p class="field-error" id="name-err">{err('name')}</p>}
            </div>
            <div class="form-row">
              <div class={`field ${err('legalName') ? 'has-error' : ''}`}>
                <label for="legal_name">Razón social o nombre del titular <span class="muted">(sale en el aviso legal y en las facturas)</span></label>
                <input class="input" id="legal_name" name="legal_name" maxlength="160" value={values.legal_name} aria-invalid={err('legalName') ? 'true' : undefined} />
                {err('legalName') && <p class="field-error">{err('legalName')}</p>}
              </div>
              <div class={`field ${err('taxId') ? 'has-error' : ''}`}>
                <label for="tax_id">NIF / CIF <span class="muted">(aviso legal y facturas)</span></label>
                <input class="input mono" id="tax_id" name="tax_id" maxlength="20" autocomplete="off" value={values.tax_id} aria-invalid={err('taxId') ? 'true' : undefined} />
                {err('taxId') && <p class="field-error">{err('taxId')}</p>}
              </div>
            </div>
            <div class="form-row">
              <div class={`field ${err('contactEmail') ? 'has-error' : ''}`}>
                <label for="contact_email">Correo de contacto <span class="muted">(opcional)</span></label>
                <input class="input" id="contact_email" name="contact_email" type="email" inputmode="email" maxlength="254" value={values.contact_email} aria-invalid={err('contactEmail') ? 'true' : undefined} aria-describedby={err('contactEmail') ? 'contact_email-err' : 'contact_email-hint'} />
                {err('contactEmail') ? <p class="field-error" id="contact_email-err">{err('contactEmail')}</p> : <p class="hint" id="contact_email-hint">Para la plataforma; no se publica en la web.</p>}
              </div>
              <div class={`field ${err('contactPhone') ? 'has-error' : ''}`}>
                <label for="contact_phone">Teléfono de contacto <span class="muted">(opcional)</span></label>
                <input class="input" id="contact_phone" name="contact_phone" type="tel" inputmode="tel" maxlength="30" value={values.contact_phone} aria-invalid={err('contactPhone') ? 'true' : undefined} />
                {err('contactPhone') && <p class="field-error">{err('contactPhone')}</p>}
              </div>
            </div>
            <div class={`field ${err('addressLine') ? 'has-error' : ''}`}>
              <label for="address_line">Dirección <span class="muted">(sale en el aviso legal, presupuestos y facturas)</span></label>
              <input class="input" id="address_line" name="address_line" maxlength="200" autocomplete="off" value={values.address_line} />
            </div>
            <div class="form-row">
              <div class={`field ${err('postalCode') ? 'has-error' : ''}`}>
                <label for="postal_code">Código postal</label>
                <input class="input" id="postal_code" name="postal_code" inputmode="numeric" maxlength="5" autocomplete="off" value={values.postal_code} aria-invalid={err('postalCode') ? 'true' : undefined} />
                {err('postalCode') && <p class="field-error">{err('postalCode')}</p>}
              </div>
              <div class="field">
                <label for="city">Localidad</label>
                <input class="input" id="city" name="city" maxlength="80" autocomplete="off" value={values.city} />
              </div>
            </div>
            <div class="field">
              <label for="province">Provincia</label>
              <input class="input" id="province" name="province" maxlength="80" autocomplete="off" value={values.province} />
            </div>
            <div class={`field ${err('legalEmail') ? 'has-error' : ''}`}>
              <label for="legal_email">Correo para asuntos legales y de privacidad</label>
              <input class="input" id="legal_email" name="legal_email" type="email" inputmode="email" maxlength="254" value={values.legal_email} aria-invalid={err('legalEmail') ? 'true' : undefined} aria-describedby={err('legalEmail') ? 'legal_email-err' : 'legal_email-hint'} />
              {err('legalEmail') ? <p class="field-error" id="legal_email-err">{err('legalEmail')}</p> : <p class="hint" id="legal_email-hint">Sale en el aviso legal y en la privacidad de la web: es donde los clientes ejercen sus derechos. Sin él, se usa el correo de la web.</p>}
            </div>
            <div class={`field ${err('registryInfo') ? 'has-error' : ''}`}>
              <label for="registry_info">Inscripción registral <span class="muted">(solo si el titular está inscrito)</span></label>
              <input class="input" id="registry_info" name="registry_info" maxlength="300" placeholder="Ej.: Registro Mercantil de Madrid, tomo …, folio …, hoja …" value={values.registry_info} />
              {err('registryInfo') && <p class="field-error">{err('registryInfo')}</p>}
            </div>
            <div class={`field ${err('logoUrl') ? 'has-error' : ''}`}>
              <label for="logo_url">Dirección del logotipo <span class="muted">(opcional, https)</span></label>
              <input class="input mono" id="logo_url" name="logo_url" type="url" inputmode="url" maxlength="500" placeholder="https://…" value={values.logo_url} aria-invalid={err('logoUrl') ? 'true' : undefined} />
              {err('logoUrl') && <p class="field-error">{err('logoUrl')}</p>}
            </div>
            <button class="btn btn-primary" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Guardar datos</span></button>
          </form>
        </section>

        <div>
          <section class="card" aria-labelledby="cuenta-t">
            <h2 id="cuenta-t" class="card-title"><Icon name="shield" />Cuenta en la plataforma</h2>
            <dl class="facts">
              <dt>Estado</dt><dd>{workshop ? (STATUS_LABELS[workshop.status] ?? workshop.status) : '—'}</dd>
              <dt>Plan</dt><dd>{usage ? (PLAN_LABELS[usage.plan] ?? usage.plan) : '—'}</dd>
              <dt>Identificador</dt><dd class="mono">{panel.workshop.slug}</dd>
              {workshop && <><dt>Alta</dt><dd>{formatDate(workshop.created_at)}</dd></>}
            </dl>
            <p class="hint" style="margin-top:10px">El estado, el plan y el identificador solo los cambia la plataforma.</p>
          </section>

          <section class="card" aria-labelledby="legal-t">
            <h2 id="legal-t" class="card-title"><Icon name="file" />Condiciones y protección de datos</h2>
            {accepted ? (
              <p>Aceptadas las <a href="/condiciones" data-astro-reload>condiciones del servicio</a> y el <a href="/encargo" data-astro-reload>contrato de encargo del tratamiento</a> (versión {LEGAL_VERSION}) el {formatDateTime(accepted.accepted_at)}.</p>
            ) : isOwner ? (
              <form method="post" class="form-stack" data-busy="Guardando…" novalidate>
                <input type="hidden" name="action" value="aceptar-condiciones" />
                <p>Para usar la plataforma con clientes reales, la propietaria del taller acepta las <a href="/condiciones" data-astro-reload>condiciones del servicio</a> y el <a href="/encargo" data-astro-reload>contrato de encargo del tratamiento</a> (la plataforma trata los datos de tus clientes por tu cuenta).</p>
                <label class="check"><input type="checkbox" name="acepto" value="1" required /> He leído y acepto las condiciones y el contrato de encargo (versión {LEGAL_VERSION})</label>
                <button class="btn btn-primary" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Aceptar</span></button>
              </form>
            ) : (
              <p class="hint">Pendiente: la persona propietaria del taller tiene que aceptar las <a href="/condiciones" data-astro-reload>condiciones</a> y el <a href="/encargo" data-astro-reload>contrato de encargo</a>.</p>
            )}
            <p class="hint" style="margin-top:8px">El aviso legal y la privacidad de tu web se rellenan solos con los datos de la izquierda: <a href="/aviso-legal" target="_blank" rel="noopener">ver aviso legal</a> · <a href="/privacidad" target="_blank" rel="noopener">ver privacidad</a>.</p>
          </section>

          <section class="card" aria-labelledby="web-t">
            <h2 id="web-t" class="card-title"><Icon name="home" />Web pública</h2>
            <dl class="facts">
              <dt>Publicada</dt><dd>{site ? (site.published ? 'Sí' : 'No') : 'Sin configurar'}</dd>
              {site && <><dt>Contenido</dt><dd>{site.is_demo_content ? 'De demostración (pendiente de sustituir por el real)' : 'Propio del taller'}</dd></>}
              <dt>Dominios</dt>
              <dd>{domains.length === 0 ? 'Ninguno todavía' : domains.map((d, i) => <>{i > 0 && ', '}<span class="mono">{d.hostname}</span>{d.is_primary && ' (principal)'}</>)}</dd>
            </dl>
            <p class="hint" style="margin-top:10px">Los textos, el aspecto y los dominios de la web los configura la plataforma. Las solicitudes que llegan desde ella están en <a href="/panel/solicitudes">Solicitudes web</a>.</p>
          </section>

          <section class="card" aria-labelledby="int-t">
            <h2 id="int-t" class="card-title"><Icon name="cog" />Servicios conectados</h2>
            <ul class="plain-list">
              {integrations.map(i => (
                <li>
                  <strong>{i.name}:</strong> {i.on ? 'activo' : 'no configurado'}
                  {!i.on && <span class="hint" style="display:block">{i.off}</span>}
                </li>
              ))}
            </ul>
            <p class="hint" style="margin-top:10px">Qué avisos reciben tus clientes se decide en <a href="/panel/avisos#ajustes">Avisos</a>; los recordatorios, en <a href="/panel/recordatorios">Recordatorios</a>; cada cuánto toca cada servicio, en <a href="/panel/mantenimientos">Mantenimientos</a>.</p>
          </section>

          <section class="card" aria-labelledby="consumo-t" id="consumo">
            <h2 id="consumo-t" class="card-title"><Icon name="euro" />Consumo de este mes</h2>
            {!usage ? <p class="hint">No se ha podido cargar el consumo. Recarga la página.</p> : (
              <>
                <p class="hint">Avisos por WhatsApp y consultas por matrícula de {MONTH}. Cuestan dinero a la plataforma, así que van a cargo del taller (IVA incluido). Los avisos en el portal, el correo y las notificaciones en el móvil no cuentan.</p>
                  <table class="data-table" style="margin-top:10px">
                    <caption class="sr-only">Consumo de extras de {MONTH}</caption>
                    <thead><tr><th scope="col">Extra</th><th scope="col" class="num-col">Usados</th><th scope="col" class="num-col">Importe</th></tr></thead>
                    <tbody>
                      <tr><th scope="row">Avisos por WhatsApp</th><td class="num-col">{usage.whatsapp}</td><td class="num-col">{formatCents(usage.whatsapp_cents)}</td></tr>
                      <tr><th scope="row">Consultas por matrícula</th><td class="num-col">{usage.matriculas}</td><td class="num-col">{formatCents(usage.matriculas_cents)}</td></tr>
                      <tr><th scope="row">Total</th><td></td><td class="num-col"><strong>{formatCents(usage.whatsapp_cents + usage.matriculas_cents)}</strong></td></tr>
                    </tbody>
                  </table>
                <p class="hint" style="margin-top:8px">Precio en tu plan ({PLAN_LABELS[usage.plan] ?? usage.plan}): WhatsApp, {tariff(usage.whatsapp_unit_cents, usage.whatsapp_discounted_cents, usage.whatsapp_limit, 'aviso')}; matrícula, {tariff(usage.matricula_unit_cents, usage.matricula_discounted_cents, usage.matricula_limit, 'consulta')}. Repetir una matrícula en 24 h o una consulta fallida no cuenta.</p>
              </>
            )}
          </section>

          <section class="card" aria-labelledby="copia-t">
            <h2 id="copia-t" class="card-title"><Icon name="shield" />Copia de seguridad</h2>
            <p class="hint">Descarga todos los datos de tu taller (copia completa o tablas para Excel) cuando quieras.</p>
            <p style="margin-top:12px"><a class="btn btn-sm" href="/panel/copia">Ir a la copia de seguridad</a></p>
          </section>
        </div>
      </div>

      <section class="card" aria-labelledby="fact-t" id="facturacion">
        <h2 id="fact-t" class="card-title"><Icon name="euro" />Presupuestos y facturas</h2>
        <p class="hint">Facturación operativa, <strong>no certificada VERI*FACTU</strong>: revisa estos ajustes con tu asesoría. Para emitir facturas hacen falta la razón social y el NIF del taller (arriba).</p>
        <form method="post" class="form-stack" data-busy="Guardando…" novalidate>
          <input type="hidden" name="action" value="facturacion" />
          <div class="form-row">
            <div class={`field ${berr('defaultTaxRate') ? 'has-error' : ''}`}>
              <label for="default_tax_rate">IVA por defecto (%)</label>
              <input class="input" id="default_tax_rate" name="default_tax_rate" inputmode="decimal" value={billValues.default_tax_rate} />
              {berr('defaultTaxRate') && <p class="field-error">{berr('defaultTaxRate')}</p>}
            </div>
            <div class={`field ${berr('labourRateCents') ? 'has-error' : ''}`}>
              <label for="labour_rate">Precio de la hora de mano de obra (€, sin IVA) <span class="muted">(opcional)</span></label>
              <input class="input" id="labour_rate" name="labour_rate" inputmode="decimal" placeholder="Ej.: 45,00" value={billValues.labour_rate} />
              {berr('labourRateCents') && <p class="field-error">{berr('labourRateCents')}</p>}
            </div>
          </div>
          <div class="form-row">
            <div class={`field ${berr('quoteValidityDays') ? 'has-error' : ''}`}>
              <label for="quote_validity_days">Validez de los presupuestos (días)</label>
              <input class="input" id="quote_validity_days" name="quote_validity_days" inputmode="numeric" value={billValues.quote_validity_days} />
              {berr('quoteValidityDays') && <p class="field-error">{berr('quoteValidityDays')}</p>}
            </div>
            <div class={`field ${berr('paymentTermsDays') ? 'has-error' : ''}`}>
              <label for="payment_terms_days">Plazo de pago de las facturas (días; 0 = al contado)</label>
              <input class="input" id="payment_terms_days" name="payment_terms_days" inputmode="numeric" value={billValues.payment_terms_days} />
              {berr('paymentTermsDays') && <p class="field-error">{berr('paymentTermsDays')}</p>}
            </div>
          </div>
          <div class="form-row">
            <div class={`field ${berr('invoiceSeries') ? 'has-error' : ''}`}>
              <label for="invoice_series">Serie de facturas</label>
              <input class="input mono" id="invoice_series" name="invoice_series" maxlength="6" autocapitalize="characters" value={billValues.invoice_series} />
              {berr('invoiceSeries') && <p class="field-error">{berr('invoiceSeries')}</p>}
            </div>
            <div class={`field ${berr('rectifyingSeries') ? 'has-error' : ''}`}>
              <label for="rectifying_series">Serie de rectificativas</label>
              <input class="input mono" id="rectifying_series" name="rectifying_series" maxlength="6" autocapitalize="characters" value={billValues.rectifying_series} />
              {berr('rectifyingSeries') && <p class="field-error">{berr('rectifyingSeries')}</p>}
            </div>
          </div>
          <p class="hint">La numeración es correlativa por serie y año (p. ej. {billValues.invoice_series || 'F'}{new Date().getFullYear()}-0001). Cambiar la serie no renumera las facturas ya emitidas.</p>
          <div class={`field ${berr('quoteConditions') ? 'has-error' : ''}`}>
            <label for="quote_conditions">Condiciones de los presupuestos <span class="muted">(opcional; las ve el cliente)</span></label>
            <textarea class="textarea" id="quote_conditions" name="quote_conditions" maxlength="2000" rows="3">{billValues.quote_conditions}</textarea>
            {berr('quoteConditions') && <p class="field-error">{berr('quoteConditions')}</p>}
          </div>
          <div class={`field ${berr('invoiceFooter') ? 'has-error' : ''}`}>
            <label for="invoice_footer">Pie de las facturas <span class="muted">(opcional; p. ej. datos bancarios o registro mercantil)</span></label>
            <textarea class="textarea" id="invoice_footer" name="invoice_footer" maxlength="1000" rows="2">{billValues.invoice_footer}</textarea>
            {berr('invoiceFooter') && <p class="field-error">{berr('invoiceFooter')}</p>}
          </div>
          {billing && billing.labour_rate_cents !== null && <p class="hint">Ahora: {formatCents(Number(billing.labour_rate_cents))} la hora.</p>}
          <button class="btn btn-primary" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Guardar ajustes</span></button>
        </form>
      </section>
    </>
  )}
</PanelLayout>
