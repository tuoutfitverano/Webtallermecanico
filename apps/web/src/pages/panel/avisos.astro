---
/**
 * Avisos a clientes: ajustes del taller (qué avisos se generan y por qué
 * canal) y registro de envíos con su estado real, motivo general de fallo y
 * reintento manual. Solo propietario y administradores: la base de datos
 * (RLS y funciones) tampoco se lo enseña ni se lo permite a nadie más.
 */
import PanelLayout from '../../layouts/PanelLayout.astro';
import Icon from '../../components/Icon.astro';
import NoWorkshop from '../../components/panel/NoWorkshop.astro';
import Flash from '../../components/panel/Flash.astro';
import { field, isUuid, panelPage } from '../../lib/server/panel.ts';
import { logAuth } from '../../lib/server/auth.ts';
import { emailAvailable } from '../../lib/server/config.ts';
import { dispatchOrderEmails } from '../../lib/server/notify.ts';
import { dbErrorMessage } from '../../lib/auth/messages.ts';
import { formatDateTime } from '../../lib/panel/format.ts';
import {
  CHANNEL_LABELS, ERROR_LABELS, EVENT_LABELS, NOTIFICATION_EVENTS, STATUS_LABELS, type NotificationEvent, type NotificationStatus,
} from '../../lib/notifications/labels.ts';
import { orderLabel } from '@talleres/core';

export const prerender = false;

const panel = await panelPage(Astro);
if (panel instanceof Response) return panel;
const canEmail = emailAvailable();

let flash: { kind: 'ok' | 'bad'; text: string } = { kind: 'ok', text: '' };
if (panel.form && panel.workshop && panel.isManager) {
  const form = panel.form;
  const action = field(form, 'action');
  if (action === 'ajustes') {
    const wantsEmail = form.get('email_enabled') === 'on';
    const replyTo = field(form, 'reply_to').trim().toLowerCase();
    if (wantsEmail && !canEmail) {
      flash = { kind: 'bad', text: 'No se puede activar el email: la plataforma todavía no tiene un proveedor de email configurado.' };
      Astro.response.status = 400;
    } else if (replyTo && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(replyTo)) {
      flash = { kind: 'bad', text: 'La dirección de respuesta no es un correo válido.' };
      Astro.response.status = 422;
    } else {
      const { data, error } = await panel.supabase.from('workshop_notification_settings').update({
        email_enabled: wantsEmail,
        app_events: NOTIFICATION_EVENTS.filter(e => form.get(`app_${e}`) === 'on'),
        email_events: NOTIFICATION_EVENTS.filter(e => form.get(`email_${e}`) === 'on'),
        reply_to: replyTo || null,
      }).eq('workshop_id', panel.workshop.id).select('workshop_id');
      if (error || !data?.length) {
        logAuth('panel_notification_settings_error', error?.code);
        flash = { kind: 'bad', text: error ? dbErrorMessage(error) : 'No se han guardado los ajustes.' };
        Astro.response.status = 400;
      } else flash = { kind: 'ok', text: 'Ajustes de avisos guardados.' };
    }
  } else if (action === 'reintentar') {
    const id = field(form, 'id');
    const { error } = isUuid(id) ? await panel.supabase.rpc('retry_notification', { p_id: id }) : { error: { code: '22023', message: '' } };
    if (error) {
      logAuth('panel_notification_retry_error', error.code);
      flash = { kind: 'bad', text: error.message && error.code !== '22023' ? dbErrorMessage(error) : error.message || 'No se puede reintentar este aviso.' };
      Astro.response.status = 400;
    } else {
      const order = field(form, 'order');
      if (isUuid(order)) await dispatchOrderEmails(Astro, order);
      flash = { kind: 'ok', text: canEmail ? 'Reintento enviado. Revisa el estado en la lista.' : 'Reintento programado: saldrá cuando el email esté configurado.' };
    }
  }
}

const FILTERS = [
  { id: 'todos', label: 'Todos', statuses: null },
  { id: 'pendientes', label: 'Pendientes', statuses: ['pendiente', 'procesando'] },
  { id: 'enviados', label: 'Enviados', statuses: ['enviado', 'entregado'] },
  { id: 'fallidos', label: 'Fallidos', statuses: ['fallido'] },
  { id: 'cancelados', label: 'Cancelados', statuses: ['cancelado'] },
] as const;
const filter = FILTERS.find(f => f.id === Astro.url.searchParams.get('estado')) ?? FILTERS[0];
const channel = Astro.url.searchParams.get('canal') === 'app' ? 'app' : Astro.url.searchParams.get('canal') === 'todos' ? 'todos' : 'email';
const qs = (estado: string, canal: string) => `/panel/avisos?estado=${estado}&canal=${canal}`;

interface Settings { email_enabled: boolean; app_events: NotificationEvent[]; email_events: NotificationEvent[]; reply_to: string | null }
interface Row {
  id: string; channel: 'app' | 'email'; event: NotificationEvent | null; status: NotificationStatus; title: string; attempts: number; manual_retries: number;
  last_attempt_at: string | null; sent_at: string | null; delivered_at: string | null; read_at: string | null; error_code: string | null; created_at: string; order_id: string | null;
  customers: { id: string; full_name: string } | null; repair_orders: { number: number } | null;
}
let settings: Settings | null = null;
let rows: Row[] = [];
let counts = { pendientes: 0, fallidos: 0 };
let loadError = false;
if (panel.workshop && panel.isManager) {
  let q = panel.supabase.from('notifications')
    .select('id, channel, event, status, title, attempts, manual_retries, last_attempt_at, sent_at, delivered_at, read_at, error_code, created_at, order_id, customers(id, full_name), repair_orders(number)')
    .eq('workshop_id', panel.workshop.id).order('created_at', { ascending: false }).limit(100);
  if (channel !== 'todos') q = q.eq('channel', channel);
  if (filter.statuses) q = q.in('status', [...filter.statuses]);
  const count = (statuses: string[]) => panel.supabase.from('notifications').select('id', { count: 'exact', head: true })
    .eq('workshop_id', panel.workshop!.id).eq('channel', 'email').in('status', statuses);
  const [s, r, p, f] = await Promise.all([
    panel.supabase.from('workshop_notification_settings').select('email_enabled, app_events, email_events, reply_to').eq('workshop_id', panel.workshop.id).maybeSingle(),
    q, count(['pendiente', 'procesando']), count(['fallido']),
  ]);
  if (s.error || r.error) { logAuth('panel_notifications_error', s.error?.code ?? r.error?.code); loadError = true; }
  settings = (s.data as Settings | null) ?? null;
  rows = (r.data ?? []) as unknown as Row[];
  counts = { pendientes: p.count ?? 0, fallidos: f.count ?? 0 };
}
---
<PanelLayout panel={panel} title="Avisos a clientes" section="avisos">
  <header class="pnl-head">
    <div>
      <h1 class="pnl-title">Avisos a clientes</h1>
      <p class="pnl-sub">Se generan solos con cada cambio real de estado de una orden. Aquí ves si han salido y decides qué se avisa.</p>
    </div>
  </header>
  {!panel.workshop ? <NoWorkshop loadError={panel.loadError} /> : !panel.isManager ? (
    <div class="empty"><strong>Solo el propietario o un administrador gestionan los avisos a clientes.</strong><a class="btn" href="/panel">Volver al inicio</a></div>
  ) : (
    <>
      <Flash kind={flash.kind} text={flash.text} />
      {loadError && <Flash kind="bad" text="No se han podido cargar los avisos. Recarga la página." />}
      {!canEmail && (
        <div class="alert alert-warn" role="note"><Icon name="alert" /><span>El envío de emails todavía no está configurado en la plataforma. Los avisos del portal funcionan; los emails no se envían (ni se dan por enviados).</span></div>
      )}

      <section class="kpis" aria-label="Resumen de emails">
        <a class="kpi" href={qs('pendientes', 'email')}><span class="kpi-value">{counts.pendientes}</span><span class="kpi-label">Emails pendientes</span></a>
        <a class="kpi" href={qs('fallidos', 'email')}><span class="kpi-value">{counts.fallidos}</span><span class="kpi-label">Emails fallidos</span></a>
      </section>

      <section class="card" aria-labelledby="registro">
        <h2 id="registro" class="card-title"><Icon name="history" />Registro de avisos</h2>
        <nav class="filter-tabs" aria-label="Canal">
          {[['email', 'Email'], ['app', 'Portal'], ['todos', 'Todos los canales']].map(([id, label]) => (
            <a href={qs(filter.id, id!)} aria-current={channel === id ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <nav class="filter-tabs" aria-label="Estado">
          {FILTERS.map(f => <a href={qs(f.id, channel)} aria-current={f.id === filter.id ? 'page' : undefined}>{f.label}</a>)}
        </nav>
        {rows.length === 0 ? <div class="empty"><strong>No hay avisos con este filtro.</strong></div> : (
          <div class="table-wrap">
            <table class="data-table">
              <thead><tr><th>Fecha</th><th>Cliente y orden</th><th>Aviso</th><th>Canal</th><th>Estado</th><th>Último intento</th><th><span class="sr-only">Acciones</span></th></tr></thead>
              <tbody>
                {rows.map(n => (
                  <tr>
                    <td>{formatDateTime(n.created_at)}</td>
                    <td>
                      {n.customers ? <a href={`/panel/clientes/${n.customers.id}`}>{n.customers.full_name}</a> : '—'}
                      {n.order_id && n.repair_orders && <><br /><a href={`/panel/ordenes/${n.order_id}`}>{orderLabel(n.repair_orders.number)}</a></>}
                    </td>
                    <td>{n.title}{n.event && <><br /><span class="muted small">{EVENT_LABELS[n.event]}</span></>}</td>
                    <td>{CHANNEL_LABELS[n.channel]}</td>
                    <td>
                      <span class={`nstatus nstatus-${n.status}`}>{n.channel === 'app' ? (n.read_at ? 'Leído' : 'Sin leer') : STATUS_LABELS[n.status]}</span>
                      {n.error_code && <><br /><span class="muted small">{ERROR_LABELS[n.error_code] ?? 'Error'}</span></>}
                    </td>
                    <td>{n.channel === 'email' ? <>{n.last_attempt_at ? formatDateTime(n.last_attempt_at) : '—'}<br /><span class="muted small">{n.attempts} {n.attempts === 1 ? 'intento' : 'intentos'}</span></> : '—'}</td>
                    <td>
                      {n.channel === 'email' && n.status === 'fallido' && n.manual_retries < 3 && n.error_code !== 'rebotado' && n.error_code !== 'queja' && (
                        <form method="post" data-busy="Reintentando…">
                          <input type="hidden" name="action" value="reintentar" /><input type="hidden" name="id" value={n.id} />
                          {n.order_id && <input type="hidden" name="order" value={n.order_id} />}
                          <button class="btn btn-sm" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Reintentar</span></button>
                        </form>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <p class="hint" style="margin-top:12px">«Enviado al proveedor» significa que el proveedor lo aceptó; «Entregado», que confirmó la entrega. Los reintentos automáticos son 5 como máximo (con esperas de 1 min a 2 h); después, como mucho 3 reintentos manuales.</p>
      </section>

      {settings && (
        <section class="card" aria-labelledby="ajustes">
          <h2 id="ajustes" class="card-title"><Icon name="cog" />Qué se avisa</h2>
          <form method="post" class="form-stack" data-busy="Guardando…">
            <input type="hidden" name="action" value="ajustes" />
            <label class="check">
              <input type="checkbox" name="email_enabled" checked={settings.email_enabled} disabled={!canEmail && !settings.email_enabled} />
              <span><strong>Enviar avisos por email</strong> a los clientes con correo que no lo hayan desactivado.{!canEmail && ' (No disponible hasta que la plataforma configure el proveedor de email.)'}</span>
            </label>
            <fieldset class="field">
              <legend>Avisos en el portal del cliente</legend>
              <div class="check-grid">
                {NOTIFICATION_EVENTS.map(e => <label class="check"><input type="checkbox" name={`app_${e}`} checked={settings!.app_events.includes(e)} /><span>{EVENT_LABELS[e]}</span></label>)}
              </div>
            </fieldset>
            <fieldset class="field">
              <legend>Avisos por email</legend>
              <div class="check-grid">
                {NOTIFICATION_EVENTS.map(e => <label class="check"><input type="checkbox" name={`email_${e}`} checked={settings!.email_events.includes(e)} /><span>{EVENT_LABELS[e]}</span></label>)}
              </div>
            </fieldset>
            <div class="field">
              <label for="reply_to">Correo al que responden los clientes <span class="muted">(opcional)</span></label>
              <input class="input" id="reply_to" name="reply_to" type="email" inputmode="email" maxlength="254" value={settings.reply_to ?? ''} placeholder="taller@ejemplo.es" />
            </div>
            <p class="hint">Son avisos operativos sobre la reparación del propio cliente. Las promociones son otra cosa: solo con el consentimiento del cliente, que lo da él mismo desde su portal.</p>
            <button class="btn btn-primary" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Guardar ajustes</span></button>
          </form>
        </section>
      )}
    </>
  )}
</PanelLayout>
