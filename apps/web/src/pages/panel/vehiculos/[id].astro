---
/**
 * Ficha de vehículo: datos, kilómetros y próxima revisión, origen y verificación,
 * edición, historial (reparaciones con km y trabajos; la oficina ve además
 * presupuestos y facturas), cambio de titular (oficina) y borrado.
 */
import PanelLayout from '../../../layouts/PanelLayout.astro';
import Icon from '../../../components/Icon.astro';
import NoWorkshop from '../../../components/panel/NoWorkshop.astro';
import Flash from '../../../components/panel/Flash.astro';
import StatusBadge from '../../../components/panel/StatusBadge.astro';
import VehicleFields from '../../../components/panel/VehicleFields.astro';
import { field, isUuid, panelPage } from '../../../lib/server/panel.ts';
import { logAuth } from '../../../lib/server/auth.ts';
import { dbErrorMessage } from '../../../lib/auth/messages.ts';
import { readVehicleForm } from '../../../lib/panel/vehicle-form.ts';
import { formatDate, formatDateTime, formatDay, todayMadrid } from '../../../lib/panel/format.ts';
import {
  DATA_SOURCE_LABELS, describeServiceInterval, formatCents, SERVICE_DUE_LABELS, serviceDueState, type ServiceDueState, FUEL_LABELS, formatPlate, INVOICE_KIND_LABELS, orderLabel, quoteLabel, QUOTE_STATUS_LABELS, VERIFICATION_LABELS, YEAR_KIND_LABELS,
  type DataSource, type FuelType, type RepairStatus, type VerificationStatus, type YearKind,
} from '@talleres/core';

import { LOOKUP_FIELD_LABELS } from '../../../lib/vehicle-lookup/review.ts';
import type { VehicleData } from '../../../lib/vehicle-lookup/types.ts';

export const prerender = false;

const PROVIDER_NAMES: Record<string, string> = { openapi: 'Openapi (Spanish Car Check)' };
const FIELD_STATE_LABELS = { confirmado: 'tal como lo dio el proveedor', modificado: 'cambiado a mano', no_usado: 'no se usó' } as const;
const TRANSFER_METHODS: Record<string, string> = {
  vendedor: 'lo confirmó el titular anterior', permiso: 'permiso de circulación a su nombre', midgt: 'app miDGT', correccion: 'corrección: estaba en la ficha equivocada',
};
const TRANSFER_STATUS: Record<string, string> = { confirmado: 'Hecho', rechazado: 'Rechazado', anulado: 'Anulado' };

const panel = await panelPage(Astro);
if (panel instanceof Response) return panel;
const id = Astro.params.id ?? '';

interface Vehicle {
  id: string; plate: string; make: string; model: string; year: number | null; year_kind: YearKind | null; fuel: FuelType | null;
  customer_id: string | null; internal_notes: string | null; data_source: DataSource; verification_status: VerificationStatus; created_at: string;
  version: string | null; vin: string | null; mileage: number | null; mileage_at: string | null;
  next_service_date: string | null; next_service_km: number | null; next_service_notes: string | null;
  portal_hidden_at: string | null; added_by_customer: boolean;
  customers: { id: string; full_name: string } | null;
  lookup_fields: Record<string, { value: string | number; state: 'confirmado' | 'modificado' | 'no_usado' }> | null;
  vehicle_lookups: { provider: string; completed_at: string; result: VehicleData } | null;
}
let flash: { kind: 'ok' | 'bad'; text: string } = { kind: 'ok', text: Astro.url.searchParams.get('creado') === '1' ? 'Vehículo registrado.' : '' };
let errors: Partial<Record<string, string>> = {};
let editValues: Record<string, string> | null = null;
let askPlate = false;
let askDelete = false;
let openEdit = false;

if (panel.form && panel.workshop && isUuid(id)) {
  const action = field(panel.form, 'action');
  if (action === 'editar') {
    const r = readVehicleForm(panel.form);
    if (!r.ok) {
      editValues = r.values; errors = r.errors; askPlate = r.needsPlateConfirmation; openEdit = true;
      flash = { kind: 'bad', text: 'Revisa los campos marcados.' };
      Astro.response.status = 422;
    } else {
      const { data, error } = await panel.supabase.from('vehicles').update(r.row).eq('id', id).eq('workshop_id', panel.workshop.id).select('id');
      if (error || !data?.length) {
        logAuth('panel_vehicle_update_error', error?.code);
        editValues = r.values; openEdit = true;
        flash = { kind: 'bad', text: error?.code === '23505' ? 'Ya hay otro vehículo con esa matrícula en tu taller.' : error ? dbErrorMessage(error) : 'No se ha guardado: el vehículo no existe o no tienes permiso.' };
        Astro.response.status = 400;
      } else {
        flash = { kind: 'ok', text: 'Cambios guardados.' };
      }
    }
  } else if ((action === 'mantenimiento' || action === 'mantenimiento-quitar') && panel.isOffice) {
    // Uno hecho fuera del taller (o en el taller antes de usar el panel). La base de datos calcula el próximo.
    const interval = field(panel.form, 'interval_id');
    const day = action === 'mantenimiento' ? field(panel.form, 'done_on') : '';
    const kmText = field(panel.form, 'done_km').trim().replace(/\D/g, '');
    if (!isUuid(interval) || (action === 'mantenimiento' && !/^\d{4}-\d{2}-\d{2}$/.test(day))) {
      flash = { kind: 'bad', text: 'Elige el mantenimiento y la fecha en que se hizo.' }; Astro.response.status = 422;
    } else {
      const { error } = await panel.supabase.rpc('set_vehicle_service', {
        p_vehicle_id: id, p_interval_id: interval, p_done_on: day || null, p_done_km: kmText ? Number(kmText) : null,
      });
      if (error) { logAuth('panel_vehicle_service_error', error.code); flash = { kind: 'bad', text: error.code === '22023' && error.message ? error.message : dbErrorMessage(error) }; Astro.response.status = 400; }
      else flash = { kind: 'ok', text: action === 'mantenimiento' ? 'Mantenimiento anotado. El próximo ya está calculado.' : 'Anotación quitada.' };
    }
  } else if (action.startsWith('titular-') && panel.isOffice) {
    // Cambio de titular: la base de datos comprueba permisos, reparación en curso y documento.
    const method = field(panel.form, 'method');
    const transfer = field(panel.form, 'transfer_id');
    const target = field(panel.form, 'new_customer_id');
    let res: { error: { code?: string; message?: string } | null };
    if (action === 'titular-confirmar' && isUuid(transfer)) {
      res = await panel.supabase.rpc('confirm_vehicle_transfer', { p_transfer_id: transfer, p_method: method });
    } else if (action === 'titular-rechazar' && isUuid(transfer)) {
      res = await panel.supabase.rpc('reject_vehicle_transfer', { p_transfer_id: transfer });
    } else if (action === 'titular-cambiar' && isUuid(target)) {
      res = await panel.supabase.rpc('transfer_vehicle', { p_vehicle_id: id, p_customer_id: target, p_method: method });
    } else {
      res = { error: { code: '22023', message: action === 'titular-cambiar' ? 'Elige a quién pasa el vehículo.' : 'Solicitud no válida.' } };
    }
    if (res.error) {
      logAuth('panel_vehicle_transfer_error', res.error.code);
      flash = { kind: 'bad', text: res.error.code === '22023' && res.error.message ? res.error.message : dbErrorMessage(res.error) };
      Astro.response.status = 400;
    } else {
      flash = { kind: 'ok', text: action === 'titular-rechazar' ? 'Solicitud rechazada. Se ha avisado a quien la pidió.' : 'Titular cambiado. Se ha avisado a los dos.' };
    }
  } else if (action === 'pedir-borrar') {
    askDelete = true;
  } else if (action === 'borrar') {
    const { data, error } = await panel.supabase.from('vehicles').delete().eq('id', id).eq('workshop_id', panel.workshop.id).select('id');
    if (!error && data?.length) return Astro.redirect('/panel/vehiculos?borrado=1', 303);
    logAuth('panel_vehicle_delete_error', error?.code);
    flash = {
      kind: 'bad',
      text: error?.code === '23503'
        ? 'No se puede borrar: tiene órdenes de reparación. Se conserva para mantener el historial.'
        : 'No se ha borrado: solo el propietario o un administrador puede borrar vehículos.',
    };
    Astro.response.status = 400;
  }
}

let vehicle: Vehicle | null = null;
let orders: Array<{ id: string; number: number; status: RepairStatus; received_at: string; problem_description: string; mileage_in: number | null; work_done: string | null; repair_order_items: Array<{ description: string }> }> = [];
let customers: Array<{ id: string; full_name: string; phone: string | null }> = [];
let quotes: Array<{ id: string; number: number; version: number; status: string; total_cents: number | null; created_at: string; title: string | null }> = [];
let invoices: Array<{ id: string; full_number: string | null; kind: 'ordinaria' | 'rectificativa'; status: string; total_cents: number | null; issue_date: string | null; created_at: string }> = [];
interface Interval { id: string; name: string; every_months: number | null; every_km: number | null }
interface Service { interval_id: string; last_done_on: string; last_done_km: number | null; next_due_on: string | null; next_due_km: number | null; source: 'orden' | 'manual'; order_id: string | null }
let intervals: Interval[] = [];
interface Transfer {
  id: string; status: 'pendiente' | 'confirmado' | 'rechazado' | 'anulado'; origin: 'portal' | 'taller'; method: string | null;
  seller_answer: 'vendido' | 'no_vendido' | null; requested_at: string; decided_at: string | null;
  from_customer_id: string | null; to_customer_id: string;
}
let transfers: Transfer[] = [];
const names = new Map<string, string>();
let services = new Map<string, Service>();
if (panel.workshop && isUuid(id)) {
  const ws = panel.workshop.id;
  const office = panel.isOffice;
  const [v, o, c, q, f, si, vs] = await Promise.all([
    panel.supabase.from('vehicles')
      .select('id, plate, make, model, year, year_kind, fuel, customer_id, internal_notes, data_source, verification_status, created_at, version, vin, mileage, mileage_at, next_service_date, next_service_km, next_service_notes, portal_hidden_at, added_by_customer, customers(id, full_name), lookup_fields, vehicle_lookups(provider, completed_at, result)')
      .eq('id', id).eq('workshop_id', ws).maybeSingle(),
    panel.supabase.from('repair_orders').select('id, number, status, received_at, problem_description, mileage_in, work_done, repair_order_items(description)')
      .eq('vehicle_id', id).eq('workshop_id', ws).order('received_at', { ascending: false }).limit(50),
    panel.supabase.rpc('search_customers', { p_workshop_id: ws, p_query: '', p_limit: 200 }),
    office ? panel.supabase.from('quotes').select('id, number, version, status, total_cents, created_at, title').eq('vehicle_id', id).eq('workshop_id', ws).neq('status', 'sustituido').order('created_at', { ascending: false }).limit(50) : Promise.resolve({ data: [] }),
    office ? panel.supabase.from('invoices').select('id, full_number, kind, status, total_cents, issue_date, created_at').eq('vehicle_id', id).eq('workshop_id', ws).order('created_at', { ascending: false }).limit(50) : Promise.resolve({ data: [] }),
    panel.supabase.from('service_intervals').select('id, name, every_months, every_km').eq('workshop_id', ws).eq('active', true).order('position').order('name'),
    panel.supabase.from('vehicle_services').select('interval_id, last_done_on, last_done_km, next_due_on, next_due_km, source, order_id').eq('vehicle_id', id).eq('workshop_id', ws),
  ]);
  intervals = (si.data ?? []) as Interval[];
  services = new Map(((vs.data ?? []) as Service[]).map(x => [x.interval_id, x]));
  vehicle = (v.data as unknown as Vehicle | null) ?? null;
  orders = (o.data ?? []) as unknown as typeof orders;
  customers = (c.data ?? []) as typeof customers;
  quotes = (q.data ?? []) as typeof quotes;
  invoices = (f.data ?? []) as typeof invoices;
  if (office && vehicle) {
    const { data: t } = await panel.supabase.from('vehicle_transfers')
      .select('id, status, origin, method, seller_answer, requested_at, decided_at, from_customer_id, to_customer_id')
      .eq('vehicle_id', id).eq('workshop_id', ws).order('requested_at', { ascending: false }).limit(30);
    transfers = (t ?? []) as Transfer[];
    for (const c of customers) names.set(c.id, c.full_name);
    const missing = [...new Set(transfers.flatMap(x => [x.from_customer_id, x.to_customer_id]))].filter((x): x is string => !!x && !names.has(x));
    if (missing.length) {
      const { data: extra } = await panel.supabase.from('customers').select('id, full_name').eq('workshop_id', ws).in('id', missing);
      for (const c of extra ?? []) names.set(c.id, c.full_name);
    }
  }
}
const pendingTransfers = transfers.filter(t => t.status === 'pendiente');
const pastTransfers = transfers.filter(t => t.status !== 'pendiente');
const who = (cid: string | null) => (cid ? names.get(cid) ?? 'Cliente' : 'Sin titular');
const today = todayMadrid();
const dueTone: Record<ServiceDueState, string> = { vencido: 'pill-bad', pronto: 'pill-warn', al_dia: 'pill-ok' };
const km = (n: number | null | undefined) => (n === null || n === undefined ? '' : `${n.toLocaleString('es-ES')} km`);
if (panel.workshop && !vehicle) Astro.response.status = 404;
const values: Record<string, string> = editValues ?? (vehicle ? {
  plate: vehicle.plate, make: vehicle.make, model: vehicle.model, year: vehicle.year?.toString() ?? '',
  year_kind: vehicle.year_kind ?? '', fuel: vehicle.fuel ?? '', customer_id: vehicle.customer_id ?? '', internal_notes: vehicle.internal_notes ?? '',
  version: vehicle.version ?? '', vin: vehicle.vin ?? '', mileage: vehicle.mileage?.toString() ?? '',
  next_service_date: vehicle.next_service_date ?? '', next_service_km: vehicle.next_service_km?.toString() ?? '', next_service_notes: vehicle.next_service_notes ?? '',
} : {});
---
<PanelLayout panel={panel} title={vehicle ? formatPlate(vehicle.plate) : 'Vehículo'} section="vehiculos">
  <a class="pnl-back" href="/panel/vehiculos"><Icon name="arrow" />Vehículos</a>
  {!panel.workshop ? <NoWorkshop loadError={panel.loadError} /> : !vehicle ? (
    <div class="empty"><strong>Vehículo no encontrado.</strong><span>No existe o pertenece a otro taller.</span><a class="btn" href="/panel/vehiculos">Volver a vehículos</a></div>
  ) : (
    <>
      <header class="pnl-head">
        <div>
          <h1 class="pnl-title"><span class="plate" style="font-size:1.5rem;vertical-align:middle">{formatPlate(vehicle.plate)}</span> {vehicle.make} {vehicle.model}</h1>
          <p class="pnl-sub">Registrado el {formatDate(vehicle.created_at)}</p>
        </div>
        {panel.isOffice && <div class="pnl-actions"><a class="btn btn-primary" href={`/panel/ordenes/nueva?vehiculo=${vehicle.id}`}><Icon name="plus" />Nueva orden</a></div>}
      </header>
      <Flash kind={flash.kind} text={flash.text} />
      {vehicle.portal_hidden_at && <div class="alert alert-warn" role="note"><Icon name="alert" /><span>El cliente quitó este vehículo de su portal el {formatDate(vehicle.portal_hidden_at)}. Aquí se conserva siempre con todo su historial; si abres una orden nueva, vuelve a su portal.</span></div>}
      {vehicle.added_by_customer && !vehicle.portal_hidden_at && <div class="alert alert-ok" role="note"><Icon name="user" /><span>Lo añadió el cliente desde su portal: revisa los datos.</span></div>}
      <div class="grid-2">
        <div class="stack">
          <section class="card" aria-labelledby="ficha">
            <h2 id="ficha" class="card-title"><Icon name="car" />Ficha</h2>
            <dl class="facts">
              <dt>Cliente</dt><dd>{vehicle.customers ? <a href={`/panel/clientes/${vehicle.customers.id}`}>{vehicle.customers.full_name}</a> : 'Sin cliente asignado'}</dd>
              <dt>Año</dt><dd>{vehicle.year ? `${vehicle.year}${vehicle.year_kind ? ` (${YEAR_KIND_LABELS[vehicle.year_kind].toLowerCase()})` : ''}` : 'Pendiente'}</dd>
              {vehicle.version && <><dt>Versión</dt><dd>{vehicle.version}</dd></>}
              <dt>Combustible</dt><dd>{vehicle.fuel ? FUEL_LABELS[vehicle.fuel] : 'Sin indicar'}</dd>
              {vehicle.vin && <><dt>Bastidor (VIN)</dt><dd class="mono">{vehicle.vin}</dd></>}
              <dt>Kilómetros</dt><dd>{vehicle.mileage !== null ? <>{km(vehicle.mileage)}{vehicle.mileage_at && <span class="muted small"> · {formatDate(vehicle.mileage_at)}</span>}</> : 'Sin registrar'}</dd>
              <dt>Próxima revisión</dt><dd>{vehicle.next_service_date || vehicle.next_service_km !== null
                ? [vehicle.next_service_date && formatDay(vehicle.next_service_date), vehicle.next_service_km !== null && `a los ${km(vehicle.next_service_km)}`].filter(Boolean).join(' o ')
                : 'Sin fijar'}{vehicle.next_service_notes && <><br /><span class="muted small">{vehicle.next_service_notes}</span></>}</dd>
              <dt>Fuente de los datos</dt><dd>{DATA_SOURCE_LABELS[vehicle.data_source]}</dd>
              <dt>Verificación externa</dt><dd>{VERIFICATION_LABELS[vehicle.verification_status]}</dd>
              {vehicle.internal_notes && <><dt>Notas internas</dt><dd class="note-internal">{vehicle.internal_notes}</dd></>}
            </dl>
          </section>
          {panel.isOffice && (
            <section class="card" aria-labelledby="titular">
              <h2 id="titular" class="card-title"><Icon name="user" />Titular</h2>
              {pendingTransfers.map(t => (
                <div style="display:grid;gap:10px;padding-bottom:16px;margin-bottom:16px;border-bottom:1px solid var(--p-line)">
                  <p><strong>{who(t.to_customer_id)}</strong> pide ponerlo a su nombre{t.origin === 'portal' ? ' desde su portal' : ''} · {formatDateTime(t.requested_at)}</p>
                  {t.from_customer_id && (
                    t.seller_answer === 'no_vendido'
                      ? <div class="alert alert-warn" role="note"><Icon name="alert" /><span>{who(t.from_customer_id)} dice que <strong>NO</strong> lo ha vendido. Compruébalo con calma con los papeles delante.</span></div>
                      : <p class="hint">{who(t.from_customer_id)}, el titular actual, no ha contestado. Si tiene cuenta en el portal y confirma la venta, el cambio se hace solo; si no, compruébalo tú con el documento.</p>
                  )}
                  <form method="post" class="form-stack" data-busy="Confirmando…" novalidate>
                    <input type="hidden" name="action" value="titular-confirmar" /><input type="hidden" name="transfer_id" value={t.id} />
                    <fieldset class="field checks">
                      <legend>¿Qué has comprobado?</legend>
                      <label class="check"><input type="radio" name="method" value="permiso" required /><span>El permiso de circulación a su nombre</span></label>
                      <label class="check"><input type="radio" name="method" value="midgt" /><span>La app miDGT con el vehículo a su nombre</span></label>
                    </fieldset>
                    <p class="hint">No guardes copia del documento: basta con anotar cuál has visto.</p>
                    <div class="pnl-actions">
                      <button class="btn btn-primary btn-sm" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Confirmar el cambio</span></button>
                    </div>
                  </form>
                  <form method="post" data-busy="Rechazando…" style="margin-top:8px">
                    <input type="hidden" name="action" value="titular-rechazar" /><input type="hidden" name="transfer_id" value={t.id} />
                    <button class="btn btn-sm" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Rechazar la solicitud</span></button>
                  </form>
                </div>
              ))}
              <p>{vehicle.customers ? <>A nombre de <a href={`/panel/clientes/${vehicle.customers.id}`}>{vehicle.customers.full_name}</a>.</> : 'Sin titular.'}</p>
              {vehicle.customer_id && pendingTransfers.length === 0 && (
                <details style="margin-top:12px">
                  <summary style="cursor:pointer">Cambiar de titular</summary>
                  <form method="post" class="form-stack" style="margin-top:12px" data-busy="Cambiando…" novalidate>
                    <input type="hidden" name="action" value="titular-cambiar" />
                    <div class="field"><label for="t-customer">Nuevo titular</label>
                      <select class="select" id="t-customer" name="new_customer_id" required>
                        <option value="">Elige un cliente…</option>
                        {customers.filter(c => c.id !== vehicle!.customer_id).map(c => <option value={c.id}>{c.full_name}{c.phone ? ` · ${c.phone}` : ''}</option>)}
                      </select>
                      <p class="hint">Si no está, <a href="/panel/clientes/nuevo">crea su ficha</a> primero.</p>
                    </div>
                    <fieldset class="field checks">
                      <legend>¿Cómo lo has comprobado?</legend>
                      <label class="check"><input type="radio" name="method" value="permiso" required /><span>El permiso de circulación a su nombre</span></label>
                      <label class="check"><input type="radio" name="method" value="midgt" /><span>La app miDGT con el vehículo a su nombre</span></label>
                      <label class="check"><input type="radio" name="method" value="correccion" /><span>No hubo venta: estaba en la ficha equivocada</span></label>
                    </fieldset>
                    <p class="hint">El titular anterior conserva sus reparaciones y resúmenes de servicios; el nuevo solo verá las suyas. No se puede cambiar con una reparación en curso.</p>
                    <button class="btn btn-sm" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Cambiar de titular</span></button>
                  </form>
                </details>
              )}
              {pastTransfers.length > 0 && (
                <ul class="list" style="margin-top:12px" aria-label="Historial de titulares">
                  {pastTransfers.map(t => (
                    <li class="row"><span class="row-main">
                      <span class="row-title">{TRANSFER_STATUS[t.status] ?? t.status}: {who(t.from_customer_id)} → {who(t.to_customer_id)}</span>
                      <span class="row-meta">{formatDateTime(t.decided_at ?? t.requested_at)}{t.method && ` · ${TRANSFER_METHODS[t.method] ?? t.method}`}</span>
                    </span></li>
                  ))}
                </ul>
              )}
            </section>
          )}
          <section class="card" aria-labelledby="mant">
            <h2 id="mant" class="card-title"><Icon name="wrench" />Mantenimientos</h2>
            {intervals.length === 0 ? <p class="hint">El taller no tiene mantenimientos periódicos activos.{panel.isManager && <> <a href="/panel/mantenimientos">Configurarlos</a></>}</p> : (
              <ul class="list">
                {intervals.map(i => {
                  const s = services.get(i.id);
                  const state = s ? serviceDueState({ dueOn: s.next_due_on, dueKm: s.next_due_km }, today, vehicle!.mileage) : null;
                  return (
                    <li class="row">
                      <span class="row-main">
                        <span class="row-title">{i.name}</span>
                        <span class="row-meta">{s
                          ? <>Hecho el {formatDay(s.last_done_on)}{s.last_done_km !== null && ` a ${km(s.last_done_km)}`}{s.source === 'manual' ? ' (anotado a mano)' : s.order_id ? <> · <a href={`/panel/ordenes/${s.order_id}`}>ver orden</a></> : ''} · Próximo: {[s.next_due_on && formatDay(s.next_due_on), s.next_due_km !== null && `a los ${km(s.next_due_km)}`].filter(Boolean).join(' o ') || 'sin calcular'}</>
                          : `${describeServiceInterval(i.every_months, i.every_km)} · sin registros`}</span>
                      </span>
                      <span class="row-side">
                        {state && <span class={`pill ${dueTone[state]}`}>{SERVICE_DUE_LABELS[state]}</span>}
                        {s?.source === 'manual' && panel.isOffice && (
                          <form method="post" data-busy="Quitando…">
                            <input type="hidden" name="action" value="mantenimiento-quitar" /><input type="hidden" name="interval_id" value={i.id} />
                            <button class="btn btn-sm" type="submit" aria-label={`Quitar la anotación de «${i.name}»`}><span class="spinner" aria-hidden="true"></span><span data-label>Quitar</span></button>
                          </form>
                        )}
                      </span>
                    </li>
                  );
                })}
              </ul>
            )}
            {panel.isOffice && intervals.length > 0 && (
              <details style="margin-top:12px">
                <summary style="cursor:pointer">Anotar uno hecho fuera del taller</summary>
                <form method="post" class="form-stack" style="margin-top:12px" data-busy="Guardando…" novalidate>
                  <input type="hidden" name="action" value="mantenimiento" />
                  <div class="field"><label for="m-interval">Mantenimiento</label>
                    <select class="select" id="m-interval" name="interval_id" required>{intervals.map(i => <option value={i.id}>{i.name}</option>)}</select></div>
                  <div class="form-row">
                    <div class="field"><label for="m-day">Fecha en que se hizo</label><input class="input" id="m-day" name="done_on" type="date" max={today} required /></div>
                    <div class="field"><label for="m-km">Kilómetros <span class="muted">(opcional)</span></label><input class="input" id="m-km" name="done_km" inputmode="numeric" placeholder="Ej.: 120500" /></div>
                  </div>
                  <p class="hint">Si después se hace en el taller con una orden, cuenta el más reciente.</p>
                  <button class="btn btn-sm" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Anotar</span></button>
                </form>
              </details>
            )}
          </section>
          {vehicle.vehicle_lookups && (
            <section class="card" aria-labelledby="consulta">
              <h2 id="consulta" class="card-title"><Icon name="search" />Datos de la consulta por matrícula</h2>
              <p class="hint">Fuente: {PROVIDER_NAMES[vehicle.vehicle_lookups.provider] ?? vehicle.vehicle_lookups.provider} · consultado el {formatDateTime(vehicle.vehicle_lookups.completed_at)}</p>
              <dl class="facts">
                {Object.entries(vehicle.lookup_fields ?? {}).map(([f, info]) => (
                  <><dt>{LOOKUP_FIELD_LABELS[f as keyof VehicleData] ?? f}</dt><dd>{f === 'fuel' ? FUEL_LABELS[info.value as FuelType] ?? info.value : info.value} · <span class:list={['muted', 'small']}>{FIELD_STATE_LABELS[info.state]}</span></dd></>
                ))}
                {(['version', 'power_cv', 'engine_cc', 'vin'] as const).filter(f => vehicle!.vehicle_lookups!.result[f] !== undefined).map(f => (
                  <><dt>{LOOKUP_FIELD_LABELS[f]}</dt><dd>{vehicle!.vehicle_lookups!.result[f]}{f === 'power_cv' ? ' CV' : f === 'engine_cc' ? ' cm³' : ''}</dd></>
                ))}
              </dl>
            </section>
          )}
          <section class="card" aria-labelledby="hist">
            <h2 id="hist" class="card-title"><Icon name="history" />Historial de reparaciones</h2>
            {orders.length === 0 ? <p class="hint">{panel.isOffice ? 'Sin reparaciones registradas.' : 'Sin reparaciones asignadas a ti para este vehículo.'}</p> : (
              <ul class="list">{orders.map(o => (
                <li><a class="row" href={`/panel/ordenes/${o.id}`}>
                  <span class="row-main">
                    <span class="row-title"><span class="num">{orderLabel(o.number)}</span>{formatDateTime(o.received_at)}{o.mileage_in !== null && <span class="muted small">{km(o.mileage_in)}</span>}</span>
                    <span class="row-meta">{o.problem_description}</span>
                    {o.repair_order_items.length > 0 && <span class="row-meta">Trabajos: {o.repair_order_items.slice(0, 4).map(i => i.description).join(' · ')}{o.repair_order_items.length > 4 && ` · y ${o.repair_order_items.length - 4} más`}</span>}
                  </span>
                  <span class="row-side"><StatusBadge status={o.status} /></span>
                </a></li>
              ))}</ul>
            )}
          </section>
          {panel.isOffice && (quotes.length > 0 || invoices.length > 0) && (
            <section class="card" aria-labelledby="docs">
              <h2 id="docs" class="card-title"><Icon name="file" />Presupuestos y servicios</h2>
              <ul class="list">
                {quotes.map(q => (
                  <li><a class="row" href={`/panel/presupuestos/${q.id}`}>
                    <span class="row-main"><span class="row-title"><span class="num">{quoteLabel(q.number, q.version)}</span>Presupuesto</span><span class="row-meta">{q.title ?? 'Sin título'} · {formatDate(q.created_at)}</span></span>
                    <span class="row-side"><span class="pill">{QUOTE_STATUS_LABELS[q.status as keyof typeof QUOTE_STATUS_LABELS] ?? q.status}</span>{q.total_cents !== null && <span class="money-big">{formatCents(Number(q.total_cents))}</span>}</span>
                  </a></li>
                ))}
                {invoices.map(f => (
                  <li><a class="row" href={`/panel/facturas/${f.id}`}>
                    <span class="row-main"><span class="row-title"><span class="num">{f.full_number ?? 'Borrador'}</span>{INVOICE_KIND_LABELS[f.kind]}</span><span class="row-meta">{f.issue_date ? `Emitida ${formatDay(f.issue_date)}` : `Creada ${formatDate(f.created_at)}`}</span></span>
                    <span class="row-side">{f.total_cents !== null && <span class="money-big">{formatCents(Number(f.total_cents))}</span>}</span>
                  </a></li>
                ))}
              </ul>
            </section>
          )}
        </div>
        <section class="card" aria-labelledby="editar">
          <details open={openEdit}>
            <summary id="editar" class="card-title" style="cursor:pointer">Editar datos</summary>
            <form method="post" class="form-stack" data-busy="Guardando…" novalidate>
              <input type="hidden" name="action" value="editar" />
              <VehicleFields values={values} errors={errors} customers={customers} askPlateConfirmation={askPlate}
                lockedCustomer={vehicle.customer_id ? (vehicle.customers?.full_name ?? 'Cliente') : undefined} />
              <button class="btn btn-primary" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Guardar cambios</span></button>
            </form>
          </details>
          {panel.isManager && (
            <div style="margin-top:20px">
              {askDelete ? (
                <form method="post" class="confirm" data-busy="Borrando…">
                  <input type="hidden" name="action" value="borrar" />
                  <strong>¿Borrar el vehículo {formatPlate(vehicle.plate)}?</strong>
                  <span class="hint">No se puede deshacer. Si tiene órdenes de reparación, no se podrá borrar.</span>
                  <div class="pnl-actions">
                    <button class="btn btn-danger" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Sí, borrar definitivamente</span></button>
                    <a class="btn" href={`/panel/vehiculos/${vehicle.id}`}>Cancelar</a>
                  </div>
                </form>
              ) : (
                <form method="post"><input type="hidden" name="action" value="pedir-borrar" /><button class="btn btn-sm btn-danger" type="submit">Borrar vehículo…</button></form>
              )}
            </div>
          )}
        </section>
      </div>
    </>
  )}
</PanelLayout>
