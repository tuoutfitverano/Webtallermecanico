---
/**
 * Ficha de cliente: datos, edición, vehículos, reparaciones, acceso al portal
 * (invitar, anular, desvincular) y borrado con confirmación.
 *
 * La vinculación con una cuenta solo se hace con una invitación que acepta el
 * propio cliente con su correo; nunca por matrícula, nombre o teléfono. Las
 * funciones de la base de datos comprueban que quien invita es gestor.
 */
import PanelLayout from '../../../layouts/PanelLayout.astro';
import Icon from '../../../components/Icon.astro';
import NoWorkshop from '../../../components/panel/NoWorkshop.astro';
import Flash from '../../../components/panel/Flash.astro';
import StatusBadge from '../../../components/panel/StatusBadge.astro';
import CustomerFields from '../../../components/panel/CustomerFields.astro';
import { readCustomerForm } from '../../../lib/panel/customer-form.ts';
import { field, isUuid, panelPage } from '../../../lib/server/panel.ts';
import { logAuth } from '../../../lib/server/auth.ts';
import { emailAvailable, sendInvitationEmail } from '../../../lib/server/config.ts';
import { LINK_STATUS, type LinkStatus } from '../../../lib/panel/links.ts';
import { dbErrorMessage } from '../../../lib/auth/messages.ts';
import { formatDate, formatDateTime } from '../../../lib/panel/format.ts';
import { formatPlate, orderLabel, type RepairStatus } from '@talleres/core';

export const prerender = false;

const panel = await panelPage(Astro);
if (panel instanceof Response) return panel;
const id = Astro.params.id ?? '';

interface Customer {
  id: string; full_name: string; phone: string | null; email: string | null; internal_notes: string | null; created_at: string;
  tax_id: string | null; address_line: string | null; postal_code: string | null; city: string | null; province: string | null;
  user_id: string | null; portal_linked_at: string | null;
}
interface Invitation { id: string; email: string; expires_at: string; created_at: string }
let flash: { kind: 'ok' | 'bad'; text: string } = { kind: 'ok', text: Astro.url.searchParams.get('creado') === '1' ? 'Cliente guardado.' : '' };
let errors: Partial<Record<string, string>> = {};
let editValues: Record<string, string> | null = null;
let askDelete = false;
let askUnlink = false;
let inviteLink: { email: string; url: string; sent: 'enviado' | 'sin_proveedor' | 'error' } | null = null;
let inviteEmail: string | null = null;

if (panel.form && panel.workshop && isUuid(id)) {
  const action = field(panel.form, 'action');
  if (action === 'editar') {
    const parsed = readCustomerForm(panel.form);
    editValues = parsed.values;
    if (!parsed.ok) {
      errors = parsed.errors;
      flash = { kind: 'bad', text: 'Revisa los campos marcados.' };
      Astro.response.status = 422;
    } else {
      const { data, error } = await panel.supabase.from('customers')
        .update(parsed.row)
        .eq('id', id).eq('workshop_id', panel.workshop.id).select('id');
      if (error || !data?.length) {
        logAuth('panel_customer_update_error', error?.code);
        flash = { kind: 'bad', text: error ? dbErrorMessage(error) : 'No se ha guardado: la ficha no existe o no tienes permiso.' };
        Astro.response.status = 400;
      } else {
        flash = { kind: 'ok', text: 'Cambios guardados.' };
        editValues = null;
      }
    }
  } else if (action === 'invitar') {
    inviteEmail = field(panel.form, 'invite_email').trim();
    const { data, error } = await panel.supabase.rpc('create_customer_invitation', { p_customer_id: id, p_email: inviteEmail || null });
    const created = (Array.isArray(data) ? data[0] : null) as { invitation_id: string; token: string; expires_at: string } | null;
    if (error || !created?.token) {
      logAuth('panel_customer_invite_error', error?.code);
      flash = { kind: 'bad', text: dbErrorMessage(error) };
      Astro.response.status = 400;
    } else {
      logAuth('panel_customer_invite_ok');
      const url = `${panel.origin}/portal/invitacion?token=${encodeURIComponent(created.token)}`;
      // El correo exacto lo decide la base de datos (el escrito o el de la ficha).
      const { data: inv } = await panel.supabase.from('customer_invitations').select('email').eq('id', created.invitation_id).maybeSingle();
      const to = (inv as { email: string } | null)?.email ?? inviteEmail;
      const sent = to
        ? await sendInvitationEmail({ id: created.invitation_id, to, workshopName: panel.workshop.name, url, expiresAt: new Date(created.expires_at) })
        : 'error';
      logAuth('panel_customer_invite_email', sent);
      inviteLink = { email: to, url, sent };
      inviteEmail = null;
    }
  } else if (action === 'anular-invitacion') {
    const { error } = await panel.supabase.rpc('revoke_customer_invitation', { p_invitation_id: field(panel.form, 'invitation_id') });
    if (error) {
      logAuth('panel_customer_invite_revoke_error', error.code);
      flash = { kind: 'bad', text: dbErrorMessage(error) };
      Astro.response.status = 400;
    } else flash = { kind: 'ok', text: 'Invitación anulada. El enlace ya no funciona.' };
  } else if (action === 'pedir-desvincular') {
    askUnlink = true;
  } else if (action === 'desvincular') {
    const { error } = await panel.supabase.rpc('unlink_customer_account', { p_customer_id: id });
    if (error) {
      logAuth('panel_customer_unlink_error', error.code);
      flash = { kind: 'bad', text: dbErrorMessage(error) };
      Astro.response.status = 400;
    } else flash = { kind: 'ok', text: 'Acceso al portal retirado. La ficha y su historial se conservan.' };
  } else if (action === 'comunicaciones') {
    // Solo a petición del cliente: el taller puede desactivar o reactivar los avisos por email y RETIRAR
    // el consentimiento comercial, nunca darlo (lo impide set_contact_preferences).
    const { error } = await panel.supabase.rpc('set_contact_preferences', {
      p_customer_id: id,
      p_operational_email: field(panel.form, 'operational_email') === '1',
      p_marketing_email: field(panel.form, 'marketing_email') === '1',
    });
    if (error) {
      logAuth('panel_customer_prefs_error', error.code);
      flash = { kind: 'bad', text: dbErrorMessage(error) };
      Astro.response.status = 400;
    } else flash = { kind: 'ok', text: 'Preferencias de comunicación actualizadas.' };
  } else if (action === 'retirar-whatsapp') {
    // El taller solo puede RETIRAR los avisos por WhatsApp (a petición del cliente); pedirlos es cosa del cliente.
    const { data: cur } = await panel.supabase.from('customer_contact_preferences').select('operational_email, marketing_email').eq('customer_id', id).maybeSingle();
    const { error } = await panel.supabase.rpc('set_contact_preferences', {
      p_customer_id: id,
      p_operational_email: cur?.operational_email ?? true,
      p_marketing_email: cur?.marketing_email ?? false,
      p_operational_whatsapp: false,
    });
    if (error) {
      logAuth('panel_customer_prefs_error', error.code);
      flash = { kind: 'bad', text: dbErrorMessage(error) };
      Astro.response.status = 400;
    } else flash = { kind: 'ok', text: 'Avisos por WhatsApp retirados. Solo el cliente puede volver a pedirlos desde su portal.' };
  } else if (action === 'pedir-borrar') {
    askDelete = true;
  } else if (action === 'borrar') {
    const { data, error } = await panel.supabase.from('customers').delete().eq('id', id).eq('workshop_id', panel.workshop.id).select('id');
    if (!error && data?.length) return Astro.redirect('/panel/clientes?borrado=1', 303);
    logAuth('panel_customer_delete_error', error?.code);
    flash = {
      kind: 'bad',
      text: error?.code === '23503'
        ? 'No se puede borrar: tiene órdenes de reparación. La ficha se conserva para mantener el historial.'
        : 'No se ha borrado: solo el propietario o un administrador puede borrar clientes.',
    };
    Astro.response.status = 400;
  }
}

let customer: Customer | null = null;
let vehicles: Array<{ id: string; plate: string; make: string; model: string }> = [];
let orders: Array<{ id: string; number: number; status: RepairStatus; updated_at: string; vehicles: { plate: string; make: string; model: string } | null }> = [];
let invitations: Invitation[] = [];
let prefs = { operational_email: true, marketing_email: false, operational_whatsapp: false, updated_at: null as string | null };
let linkHistory: Array<{ id: string; status: 'activa' | 'revocada'; origin: string; linked_at: string; revoked_at: string | null }> = [];
let linkStatus: LinkStatus | null = null;
const mailOn = emailAvailable();
let consentLog: Array<{ id: number; channel: string; purpose: string; granted: boolean; source: string; created_at: string }> = [];
if (panel.workshop && isUuid(id)) {
  const [c, v, o, i, pr, lh, lo, cl] = await Promise.all([
    panel.supabase.from('customers').select('id, full_name, phone, email, internal_notes, tax_id, address_line, postal_code, city, province, created_at, user_id, portal_linked_at').eq('id', id).eq('workshop_id', panel.workshop.id).maybeSingle(),
    panel.supabase.from('vehicles').select('id, plate, make, model').eq('customer_id', id).eq('workshop_id', panel.workshop.id).order('plate'),
    panel.supabase.from('repair_orders').select('id, number, status, updated_at, vehicles(plate, make, model)').eq('customer_id', id).eq('workshop_id', panel.workshop.id).order('updated_at', { ascending: false }).limit(50),
    // Solo los gestores pueden leer las invitaciones (RLS); a un mecánico le llega vacío.
    panel.isOffice
      ? panel.supabase.from('customer_invitations').select('id, email, expires_at, created_at').eq('customer_id', id).eq('workshop_id', panel.workshop.id)
        .eq('status', 'pendiente').gt('expires_at', new Date().toISOString()).order('created_at', { ascending: false })
      : Promise.resolve({ data: [] }),
    panel.supabase.from('customer_contact_preferences').select('operational_email, marketing_email, operational_whatsapp, updated_at').eq('customer_id', id).maybeSingle(),
    // Historial de vinculaciones (oficina, por RLS) y estado actual del acceso.
    panel.isOffice
      ? panel.supabase.from('customer_account_links').select('id, status, origin, linked_at, revoked_at').eq('customer_id', id).eq('workshop_id', panel.workshop.id).order('linked_at', { ascending: false }).limit(10)
      : Promise.resolve({ data: [] }),
    panel.supabase.rpc('customer_link_overview', { p_workshop_id: panel.workshop.id }),
    // Registro de consentimientos: solo gestores (RLS «consent log: lectura gestores»).
    panel.isManager
      ? panel.supabase.from('communication_consent_log').select('id, channel, purpose, granted, source, created_at').eq('customer_id', id).eq('workshop_id', panel.workshop.id)
        .order('created_at', { ascending: false }).limit(20)
      : Promise.resolve({ data: [] }),
  ]);
  if (pr.data) prefs = pr.data as typeof prefs;
  linkHistory = (lh.data ?? []) as typeof linkHistory;
  linkStatus = ((lo.data ?? []) as Array<{ customer_id: string; status: LinkStatus }>).find(x => x.customer_id === id)?.status ?? null;
  consentLog = (cl.data ?? []) as typeof consentLog;
  customer = (c.data as Customer | null) ?? null;
  vehicles = (v.data ?? []) as typeof vehicles;
  orders = (o.data ?? []) as unknown as typeof orders;
  invitations = (i.data ?? []) as Invitation[];
}
if (panel.workshop && !customer) Astro.response.status = 404;
const values = editValues ?? customer ?? {};
const LINK_ORIGIN: Record<string, string> = { invitacion: 'aceptó una invitación', migracion: 'ya estaba vinculada antes del historial', sistema: 'vinculada por la plataforma' };
const CONSENT_SOURCE: Record<string, string> = { portal: 'por el cliente en su portal', panel: 'por el taller', queja_proveedor: 'automático (queja o rebote del email)' };
---
<PanelLayout panel={panel} title={customer?.full_name ?? 'Cliente'} section="clientes">
  <a class="pnl-back" href="/panel/clientes"><Icon name="arrow" />Clientes</a>
  {!panel.workshop ? <NoWorkshop loadError={panel.loadError} /> : !customer ? (
    <div class="empty"><strong>Cliente no encontrado.</strong><span>No existe o pertenece a otro taller.</span><a class="btn" href="/panel/clientes">Volver a clientes</a></div>
  ) : (
    <>
      <header class="pnl-head">
        <div>
          <h1 class="pnl-title">{customer.full_name}</h1>
          <p class="pnl-sub">Cliente desde el {formatDate(customer.created_at)} · {customer.user_id ? 'Con cuenta en el portal' : 'Sin cuenta en el portal'}</p>
        </div>
        <div class="pnl-actions">
          <a class="btn" href={`/panel/vehiculos/nuevo?cliente=${customer.id}`}><Icon name="car" />Registrar vehículo</a>
          {panel.isOffice && vehicles.length > 0 && <a class="btn btn-primary" href={`/panel/ordenes/nueva?cliente=${customer.id}`}><Icon name="plus" />Nueva orden</a>}
        </div>
      </header>
      <Flash kind={flash.kind} text={flash.text} />
      <div class="grid-2">
        <div class="stack">
          <section class="card" aria-labelledby="veh">
            <h2 id="veh" class="card-title"><Icon name="car" />Vehículos</h2>
            {vehicles.length === 0 ? <p class="hint">Este cliente no tiene vehículos registrados.</p> : (
              <ul class="list">{vehicles.map(v => (
                <li><a class="row" href={`/panel/vehiculos/${v.id}`}><span class="row-main"><span class="row-title"><span class="plate">{formatPlate(v.plate)}</span>{v.make} {v.model}</span></span></a></li>
              ))}</ul>
            )}
          </section>
          <section class="card" aria-labelledby="portal">
            <h2 id="portal" class="card-title"><Icon name="shield" />Acceso al área de cliente</h2>
            {linkStatus && <p style="margin-bottom:10px"><span class={`pill ${LINK_STATUS[linkStatus].tone}`}>{LINK_STATUS[linkStatus].short}</span> <span class="hint">{LINK_STATUS[linkStatus].long}</span></p>}
            {customer.user_id ? (
              <>
                <p><span class="status status-listo">Vinculada</span> El cliente entra con su cuenta y ve sus vehículos y reparaciones de este taller{customer.portal_linked_at ? ` desde el ${formatDate(customer.portal_linked_at)}` : ''}.</p>
                <p class="hint" style="margin-top:8px">Nunca ve las notas internas, el equipo ni otros clientes. La diagnosis y el trabajo realizado, solo si lo autorizas en cada orden.</p>
                {panel.isOffice && (
                  <div style="margin-top:12px">
                    {askUnlink ? (
                      <form method="post" class="confirm" data-busy="Retirando…">
                        <input type="hidden" name="action" value="desvincular" />
                        <strong>¿Retirar el acceso al portal de {customer.full_name}?</strong>
                        <span class="hint">Dejará de ver sus vehículos y reparaciones de inmediato. La ficha, los vehículos y el historial se conservan, y puedes invitarle de nuevo más adelante.</span>
                        <div class="pnl-actions">
                          <button class="btn btn-danger" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Sí, retirar el acceso</span></button>
                          <a class="btn" href={`/panel/clientes/${customer.id}`}>Cancelar</a>
                        </div>
                      </form>
                    ) : (
                      <form method="post"><input type="hidden" name="action" value="pedir-desvincular" /><button class="btn btn-sm btn-danger" type="submit">Retirar el acceso…</button></form>
                    )}
                  </div>
                )}
              </>
            ) : (
              <>
                <p><span class="status status-entregado">Sin vincular</span> Este cliente todavía no tiene acceso a su portal.</p>
                {!panel.isOffice ? <p class="hint" style="margin-top:8px">Las invitaciones al portal las envía la oficina del taller (propietario, administrador o recepción).</p> : (
                  <>
                    {inviteLink && (
                      <div class="invite-result" style="margin-top:12px">
                        {inviteLink.sent === 'enviado' ? (
                          <div class="alert alert-ok" role="status">
                            <Icon name="check" />
                            <span>Invitación enviada por correo a <strong>{inviteLink.email}</strong> (aceptada por el proveedor de correo; la entrega no está confirmada). Solo funciona con ese correo, una vez y durante 7 días. Si no le llega, compártele este enlace. <strong>No se volverá a mostrar.</strong></span>
                          </div>
                        ) : (
                          <div class="alert alert-warn" role="status">
                            <Icon name="alert" />
                            <span>Invitación creada para <strong>{inviteLink.email}</strong>, <strong>pendiente de envío</strong>: {inviteLink.sent === 'sin_proveedor' ? 'la plataforma todavía no tiene servicio de correo, así que no se ha enviado nada.' : 'el correo no se ha podido enviar ahora.'} Envíale tú este enlace (por WhatsApp o correo). Solo funciona con ese correo, una vez y durante 7 días. <strong>No se volverá a mostrar.</strong></span>
                          </div>
                        )}
                        <div class="copy-row">
                          <input class="input mono" id="enlace-portal" value={inviteLink.url} readonly aria-label="Enlace de invitación al portal" />
                          <button class="btn" type="button" data-copy="enlace-portal">Copiar</button>
                        </div>
                      </div>
                    )}
                    {invitations.length > 0 && (
                      <ul class="list" style="margin-top:12px" aria-label="Invitaciones pendientes">
                        {invitations.map(inv => (
                          <li class="row">
                            <span class="row-main">
                              <span class="row-title">Invitación pendiente para {inv.email}</span>
                              <span class="row-meta">Creada el {formatDate(inv.created_at)} · caduca el {formatDateTime(inv.expires_at)}</span>
                            </span>
                            <form method="post" class="row-side" data-busy="Anulando…">
                              <input type="hidden" name="action" value="anular-invitacion" />
                              <input type="hidden" name="invitation_id" value={inv.id} />
                              <button class="btn btn-sm" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Anular</span></button>
                            </form>
                          </li>
                        ))}
                      </ul>
                    )}
                    <form method="post" class="form-stack" style="margin-top:12px" data-busy="Creando…">
                      <input type="hidden" name="action" value="invitar" />
                      <div class="field">
                        <label for="invite_email">Correo del cliente para entrar en el portal</label>
                        <input class="input" id="invite_email" name="invite_email" type="email" inputmode="email" maxlength="254" required value={inviteEmail ?? customer.email ?? ''} aria-describedby="invite_hint" />
                        <p class="hint" id="invite_hint">Se crea un enlace personal que solo funciona con este correo. {invitations.length > 0 ? 'Crear otro anula el pendiente.' : ''} {mailOn ? 'Se le envía por correo y además verás el enlace para compartirlo.' : 'Todavía no hay servicio de correo: verás el enlace para compartirlo tú.'} Si ya tiene cuenta de AutoValue (por otro taller), se vincula esa misma cuenta.</p>
                      </div>
                      <button class="btn btn-primary" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>{invitations.length > 0 ? 'Crear un enlace nuevo' : 'Invitar al área de cliente'}</span></button>
                    </form>
                  </>
                )}
              </>
            )}
          </section>
          {panel.isOffice && linkHistory.length > 0 && (
            <section class="card" aria-labelledby="vinculos">
              <h2 id="vinculos" class="card-title"><Icon name="history" />Historial de acceso</h2>
              <ul class="plain-list small">
                {linkHistory.map(l => (
                  <li>{l.status === 'activa' ? 'Vinculada' : 'Vinculada y después retirada'} · {LINK_ORIGIN[l.origin] ?? l.origin} · desde el {formatDate(l.linked_at)}{l.revoked_at && ` hasta el ${formatDate(l.revoked_at)}`}</li>
                ))}
              </ul>
              <p class="hint" style="margin-top:8px">Retirar el acceso no borra la ficha, los vehículos ni las reparaciones: solo impide que la cuenta los vea.</p>
            </section>
          )}
          <section class="card" aria-labelledby="comunicaciones">
            <h2 id="comunicaciones" class="card-title"><Icon name="bell" />Comunicaciones</h2>
            <dl class="facts">
              <dt>Avisos de reparaciones por email</dt><dd>{!customer.email ? 'Sin correo en la ficha' : prefs.operational_email ? 'Sí' : 'No (desactivados)'}</dd>
              <dt>Avisos de reparaciones por WhatsApp</dt><dd>{prefs.operational_whatsapp ? 'Sí, pedido por el cliente desde su portal' : 'No'}</dd>
              <dt>Promociones por email</dt><dd>{prefs.marketing_email ? `Sí, consentimiento dado por el cliente${prefs.updated_at ? ` (${formatDate(prefs.updated_at)})` : ''}` : 'No'}</dd>
            </dl>
            {panel.isManager && (
              <div class="pnl-actions" style="margin-top:12px">
                <form method="post" data-busy="Guardando…">
                  <input type="hidden" name="action" value="comunicaciones" />
                  <input type="hidden" name="operational_email" value={prefs.operational_email ? '0' : '1'} />
                  <input type="hidden" name="marketing_email" value={prefs.marketing_email ? '1' : '0'} />
                  <button class="btn btn-sm" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>{prefs.operational_email ? 'Desactivar avisos por email' : 'Reactivar avisos por email'}</span></button>
                </form>
                {prefs.operational_whatsapp && (
                  <form method="post" data-busy="Guardando…">
                    <input type="hidden" name="action" value="retirar-whatsapp" />
                    <button class="btn btn-sm" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Retirar avisos por WhatsApp</span></button>
                  </form>
                )}
                {prefs.marketing_email && (
                  <form method="post" data-busy="Guardando…">
                    <input type="hidden" name="action" value="comunicaciones" />
                    <input type="hidden" name="operational_email" value={prefs.operational_email ? '1' : '0'} />
                    <input type="hidden" name="marketing_email" value="0" />
                    <button class="btn btn-sm btn-danger" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Retirar consentimiento de promociones</span></button>
                  </form>
                )}
              </div>
            )}
            <p class="hint" style="margin-top:10px">Cámbialo solo si el cliente te lo pide. Los avisos por WhatsApp y el consentimiento para promociones solo puede pedirlos el propio cliente desde su portal.</p>
            {panel.isManager && consentLog.length > 0 && (
              <details style="margin-top:12px">
                <summary class="small">Historial de cambios de comunicaciones ({consentLog.length})</summary>
                <ul class="timeline" style="margin-top:10px">
                  {consentLog.map(e => (
                    <li>
                      <span class="dot" aria-hidden="true"></span>
                      <div>
                        <span>{e.purpose === 'comercial' ? 'Promociones' : 'Avisos de reparaciones'} por {e.channel === 'whatsapp' ? 'WhatsApp' : 'email'}: <strong>{e.granted ? 'activado' : 'desactivado'}</strong> · {CONSENT_SOURCE[e.source] ?? e.source}</span>
                        <span class="when" style="display:block">{formatDateTime(e.created_at)}</span>
                      </div>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </section>
          <section class="card" aria-labelledby="rep">
            <h2 id="rep" class="card-title"><Icon name="clipboard" />Reparaciones</h2>
            {orders.length === 0 ? <p class="hint">{panel.isManager ? 'Sin reparaciones registradas.' : 'Sin reparaciones asignadas a ti para este cliente.'}</p> : (
              <ul class="list">{orders.map(o => (
                <li><a class="row" href={`/panel/ordenes/${o.id}`}>
                  <span class="row-main">
                    <span class="row-title"><span class="num">{orderLabel(o.number)}</span>{o.vehicles && <span class="plate">{formatPlate(o.vehicles.plate)}</span>}</span>
                    <span class="row-meta">Actualizada {formatDateTime(o.updated_at)}</span>
                  </span>
                  <span class="row-side"><StatusBadge status={o.status} /></span>
                </a></li>
              ))}</ul>
            )}
          </section>
        </div>
        <section class="card" aria-labelledby="datos">
          <h2 id="datos" class="card-title"><Icon name="user" />Datos del cliente</h2>
          <form method="post" class="form-stack" data-busy="Guardando…" novalidate>
            <input type="hidden" name="action" value="editar" />
            <CustomerFields values={values} errors={errors} />
            <button class="btn btn-primary" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Guardar cambios</span></button>
          </form>
          {panel.isManager && (
            <div style="margin-top:20px">
              {askDelete ? (
                <form method="post" class="confirm" data-busy="Borrando…">
                  <input type="hidden" name="action" value="borrar" />
                  <strong>¿Borrar la ficha de {customer.full_name}?</strong>
                  <span class="hint">No se puede deshacer. Sus vehículos se quedan sin cliente asignado. Si tiene órdenes, no se podrá borrar.</span>
                  <div class="pnl-actions">
                    <button class="btn btn-danger" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Sí, borrar definitivamente</span></button>
                    <a class="btn" href={`/panel/clientes/${customer.id}`}>Cancelar</a>
                  </div>
                </form>
              ) : (
                <form method="post"><input type="hidden" name="action" value="pedir-borrar" /><button class="btn btn-sm btn-danger" type="submit">Borrar cliente…</button></form>
              )}
            </div>
          )}
        </section>
      </div>
    </>
  )}
</PanelLayout>
