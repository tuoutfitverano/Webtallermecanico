---
/**
 * Ficha de una factura (oficina).
 *
 *  · Borrador: líneas, nota, EMITIR (en dos pasos: es irreversible) o borrar.
 *    Antes de emitir avisa si faltan datos fiscales del taller o del cliente.
 *  · Emitida: inmutable. Cobros (completos o parciales; la base de datos
 *    impide pasarse del total), anular un cobro con motivo y crear una
 *    rectificativa (propietario o administrador). Vista para imprimir o
 *    guardar en PDF.
 *  ⚠ Operativa, NO certificada VERI*FACTU (ver docs/FACTURACION.md).
 */
import PanelLayout from '../../../layouts/PanelLayout.astro';
import Icon from '../../../components/Icon.astro';
import NoWorkshop from '../../../components/panel/NoWorkshop.astro';
import Flash from '../../../components/panel/Flash.astro';
import LinesEditor from '../../../components/panel/LinesEditor.astro';
import { field, isUuid, panelPage } from '../../../lib/server/panel.ts';
import { logAuth } from '../../../lib/server/auth.ts';
import { dbErrorMessage } from '../../../lib/auth/messages.ts';
import { formatDateTime, formatDay, todayMadrid } from '../../../lib/panel/format.ts';
import { LINE_SELECT, lineColumns, readLine, type LineRow } from '../../../lib/panel/lines.ts';
import {
  formatCents, formatPlate, INVOICE_KIND_LABELS, orderLabel, parseEuros, PAYMENT_METHOD_LABELS, PAYMENT_METHODS, PAYMENT_STATUS_LABELS,
  type PaymentMethod,
} from '@talleres/core';

export const prerender = false;

const panel = await panelPage(Astro);
if (panel instanceof Response) return panel;
const id = Astro.params.id ?? '';

interface Party { name?: string; legal_name?: string; tax_id?: string | null; address?: string | null; postal_code?: string | null; city?: string | null; province?: string | null; footer?: string | null }
interface Invoice {
  id: string; kind: 'ordinaria' | 'rectificativa'; status: 'borrador' | 'emitida'; full_number: string | null; issue_date: string | null; due_date: string | null;
  notes: string | null; issuer: Party | null; recipient: Party | null; subtotal_cents: number | null; tax_cents: number | null; total_cents: number | null;
  taxes: Array<{ rate: number; base_cents: number; tax_cents: number }> | null; issued_at: string | null; rectifies_id: string | null; rectification_reason: string | null;
  order_id: string | null; quote_id: string | null; created_at: string;
  customers: { id: string; full_name: string; tax_id: string | null; address_line: string | null; postal_code: string | null; city: string | null } | null;
  vehicles: { id: string; plate: string; make: string; model: string } | null;
  repair_orders: { id: string; number: number } | null;
}
interface Payment { id: string; amount_cents: number; method: PaymentMethod; paid_on: string; reference: string | null; note: string | null; voided_at: string | null; void_reason: string | null; created_at: string }
const SELECT = 'id, kind, status, full_number, issue_date, due_date, notes, issuer, recipient, subtotal_cents, tax_cents, total_cents, taxes, issued_at, rectifies_id, rectification_reason, order_id, quote_id, created_at, customers(id, full_name, tax_id, address_line, postal_code, city), vehicles(id, plate, make, model), repair_orders(id, number)';
const ctx = panel;
async function load() {
  if (!ctx.workshop || !ctx.isOffice || !isUuid(id)) return null;
  const { data } = await ctx.supabase.from('invoices').select(SELECT).eq('id', id).eq('workshop_id', ctx.workshop.id).maybeSingle();
  return (data as unknown as Invoice | null) ?? null;
}
async function loadRest(inv: Invoice) {
  const [l, p, r, w] = await Promise.all([
    ctx.supabase.from('invoice_items').select(LINE_SELECT).eq('invoice_id', inv.id).order('position').order('created_at'),
    ctx.supabase.from('payments').select('id, amount_cents, method, paid_on, reference, note, voided_at, void_reason, created_at').eq('invoice_id', inv.id).order('created_at'),
    ctx.supabase.from('invoices').select('id, full_number, status').eq('rectifies_id', inv.id),
    ctx.supabase.from('workshops').select('legal_name, tax_id').eq('id', ctx.workshop!.id).maybeSingle(),
  ]);
  return {
    lines: (l.data ?? []) as LineRow[], payments: (p.data ?? []) as Payment[],
    rectifications: (r.data ?? []) as Array<{ id: string; full_number: string | null; status: string }>,
    workshopFiscal: (w.data ?? null) as { legal_name: string | null; tax_id: string | null } | null,
  };
}

let invoice = await load();
let rest = invoice ? await loadRest(invoice) : null;
let settings = { default_tax_rate: 21, labour_rate_cents: null as number | null };
if (invoice && panel.workshop) {
  const { data } = await panel.supabase.from('workshop_billing_settings').select('default_tax_rate, labour_rate_cents').eq('workshop_id', panel.workshop.id).maybeSingle();
  if (data) settings = { default_tax_rate: Number(data.default_tax_rate), labour_rate_cents: data.labour_rate_cents === null ? null : Number(data.labour_rate_cents) };
}

let flash: { kind: 'ok' | 'bad'; text: string } = { kind: 'ok', text: Astro.url.searchParams.get('creada') === '1' ? 'Borrador creado. Revisa las líneas antes de emitir.' : '' };
let lineErrors: Record<string, string> = {};
let lineValues: Record<string, string> = {};
let askIssue = false;
let askDelete = false;
let askRectify = false;
let voidId = '';

if (panel.form && panel.workshop && invoice) {
  const form = panel.form;
  const action = field(form, 'action');
  const fail = (error: { code?: string; message?: string } | null, fallback: string, event: string) => {
    logAuth(event, error?.code);
    flash = { kind: 'bad', text: error && ['22023', '23514', '42501'].includes(error.code ?? '') && error.message ? error.message : error ? dbErrorMessage(error) : fallback };
    Astro.response.status = 400;
  };
  if (action === 'linea-anadir' && invoice.status === 'borrador') {
    const r = readLine(form, { taxRate: settings.default_tax_rate, labourRateCents: settings.labour_rate_cents, allowNegative: invoice.kind === 'rectificativa' });
    if (!r.ok) { lineErrors = r.errors; lineValues = r.values; flash = { kind: 'bad', text: 'Revisa la línea.' }; Astro.response.status = 422; }
    else {
      const position = (rest?.lines ?? []).reduce((m, l) => Math.max(m, l.position), 0) + 1;
      const { error } = await panel.supabase.from('invoice_items').insert({ workshop_id: panel.workshop.id, invoice_id: invoice.id, position, ...lineColumns(r.data) });
      if (error) fail(error, 'No se ha añadido la línea.', 'panel_invoice_line_error');
      else flash = { kind: 'ok', text: 'Línea añadida.' };
    }
  } else if (action === 'linea-quitar' && invoice.status === 'borrador') {
    const lineId = field(form, 'line_id');
    const { error } = isUuid(lineId) ? await panel.supabase.from('invoice_items').delete().eq('id', lineId).eq('invoice_id', invoice.id) : { error: null };
    if (error) fail(error, 'No se ha quitado la línea.', 'panel_invoice_line_error');
    else flash = { kind: 'ok', text: 'Línea quitada.' };
  } else if (action === 'nota' && invoice.status === 'borrador') {
    const { error } = await panel.supabase.from('invoices').update({ notes: field(form, 'notes').trim().slice(0, 2000) || null }).eq('id', invoice.id);
    if (error) fail(error, 'No se ha guardado la nota.', 'panel_invoice_update_error');
    else flash = { kind: 'ok', text: 'Nota guardada.' };
  } else if (action === 'pedir-emitir') {
    askIssue = true;
  } else if (action === 'emitir') {
    const { data, error } = await panel.supabase.rpc('issue_invoice', { p_invoice_id: invoice.id });
    if (error || !data) fail(error, 'No se ha emitido la factura.', 'panel_invoice_issue_error');
    else flash = { kind: 'ok', text: `Factura ${data} emitida. Ya no se puede modificar.` };
  } else if (action === 'pedir-borrar') {
    askDelete = true;
  } else if (action === 'borrar' && invoice.status === 'borrador') {
    const { data, error } = await panel.supabase.from('invoices').delete().eq('id', invoice.id).eq('workshop_id', panel.workshop.id).select('id');
    if (!error && data?.length) return Astro.redirect('/panel/facturas?estado=borradores', 303);
    fail(error, 'No se ha borrado.', 'panel_invoice_delete_error');
  } else if (action === 'cobro' && invoice.status === 'emitida') {
    const cents = parseEuros(field(form, 'amount'));
    const method = field(form, 'method') as PaymentMethod;
    const paidOn = field(form, 'paid_on');
    const sign = Number(invoice.total_cents) < 0 ? -1 : 1;
    if (cents === null || cents === 0) { flash = { kind: 'bad', text: 'Escribe el importe cobrado, p. ej. 120 o 120,50.' }; Astro.response.status = 422; }
    else if (!PAYMENT_METHODS.includes(method)) { flash = { kind: 'bad', text: 'Elige cómo se ha cobrado.' }; Astro.response.status = 422; }
    else if (!/^\d{4}-\d{2}-\d{2}$/.test(paidOn)) { flash = { kind: 'bad', text: 'Fecha del cobro no válida.' }; Astro.response.status = 422; }
    else {
      const { error } = await panel.supabase.from('payments').insert({
        workshop_id: panel.workshop.id, invoice_id: invoice.id, amount_cents: sign * cents, method, paid_on: paidOn,
        reference: field(form, 'reference').trim().slice(0, 120) || null, note: field(form, 'note').trim().slice(0, 500) || null,
      });
      if (error) fail(error, 'No se ha registrado el cobro.', 'panel_payment_error');
      else flash = { kind: 'ok', text: sign < 0 ? 'Devolución registrada.' : 'Cobro registrado.' };
    }
  } else if (action === 'pedir-anular-cobro') {
    voidId = field(form, 'payment_id');
  } else if (action === 'anular-cobro') {
    const { error } = await panel.supabase.rpc('void_payment', { p_payment_id: field(form, 'payment_id'), p_reason: field(form, 'reason').trim() });
    if (error) fail(error, 'No se ha anulado el cobro.', 'panel_payment_void_error');
    else flash = { kind: 'ok', text: 'Cobro anulado (queda registrado con su motivo).' };
  } else if (action === 'pedir-rectificar') {
    askRectify = true;
  } else if (action === 'rectificar') {
    const { data, error } = await panel.supabase.rpc('create_rectifying_invoice', { p_invoice_id: invoice.id, p_reason: field(form, 'reason').trim() });
    if (error || !data) fail(error, 'No se ha creado la rectificativa.', 'panel_invoice_rectify_error');
    else return Astro.redirect(`/panel/facturas/${data}?creada=1`, 303);
  }
  invoice = await load();
  rest = invoice ? await loadRest(invoice) : null;
}
if (panel.workshop && panel.isOffice && !invoice) Astro.response.status = 404;

const valid = (rest?.payments ?? []).filter(p => !p.voided_at);
const paid = valid.reduce((s, p) => s + Number(p.amount_cents), 0);
const pending = invoice?.status === 'emitida' ? Number(invoice.total_cents) - paid : 0;
const payStatus = pending === 0 ? 'cobrada' : paid === 0 ? 'pendiente' : 'parcial';
const overdue = Boolean(invoice?.due_date && invoice.due_date < todayMadrid() && pending !== 0);
const missing: string[] = [];
if (invoice?.status === 'borrador') {
  if (!rest?.workshopFiscal?.legal_name || !rest.workshopFiscal.tax_id) missing.push('la razón social y el NIF del taller (Panel → Taller)');
  if (!invoice.customers?.tax_id) missing.push('el NIF del cliente (necesario para una factura completa; sin él sería una factura simplificada)');
  if (!invoice.customers?.address_line) missing.push('la dirección del cliente');
}
const label = invoice ? (invoice.full_number ? `${INVOICE_KIND_LABELS[invoice.kind]} ${invoice.full_number}` : `${INVOICE_KIND_LABELS[invoice.kind]} (borrador)`) : 'Factura';
const stored = invoice?.status === 'emitida' ? { subtotal_cents: Number(invoice.subtotal_cents), tax_cents: Number(invoice.tax_cents), total_cents: Number(invoice.total_cents), taxes: invoice.taxes ?? [] } : null;
const address = (p: Party | null) => p ? [p.address, [p.postal_code, p.city].filter(Boolean).join(' '), p.province].filter(Boolean).join(', ') : '';
---
<PanelLayout panel={panel} title={label} section="facturas">
  <a class="pnl-back" href="/panel/facturas"><Icon name="arrow" />Facturas</a>
  {!panel.workshop ? <NoWorkshop loadError={panel.loadError} /> : !panel.isOffice ? (
    <div class="empty"><strong>Las facturas las gestiona la oficina del taller.</strong><a class="btn" href="/panel">Volver al inicio</a></div>
  ) : !invoice || !rest ? (
    <div class="empty"><strong>Factura no encontrada.</strong><a class="btn" href="/panel/facturas">Volver a facturas</a></div>
  ) : (
    <>
      <header class="pnl-head">
        <div>
          <h1 class="pnl-title">{label}</h1>
          <p class="pnl-sub">
            {invoice.customers && <a href={`/panel/clientes/${invoice.customers.id}`}>{invoice.customers.full_name}</a>}
            {invoice.vehicles && <> · <a href={`/panel/vehiculos/${invoice.vehicles.id}`}><span class="plate">{formatPlate(invoice.vehicles.plate)}</span></a> {invoice.vehicles.make} {invoice.vehicles.model}</>}
            {invoice.repair_orders && <> · <a href={`/panel/ordenes/${invoice.repair_orders.id}`}>{orderLabel(invoice.repair_orders.number)}</a></>}
          </p>
        </div>
        {invoice.status === 'emitida' && <div class="pnl-actions"><a class="btn" href={`/panel/facturas/${invoice.id}/imprimir`}><Icon name="printer" />Imprimir o guardar PDF</a></div>}
      </header>
      <Flash kind={flash.kind} text={flash.text} />
      {invoice.kind === 'rectificativa' && <div class="explain" style="margin-bottom:16px"><strong>Rectifica otra factura</strong><p>Motivo: {invoice.rectification_reason} · <a href={`/panel/facturas/${invoice.rectifies_id}`}>Ver la factura original</a></p></div>}
      {rest.rectifications.length > 0 && <div class="explain" style="margin-bottom:16px"><strong>Esta factura tiene rectificativas</strong><p>{rest.rectifications.map(r => <a href={`/panel/facturas/${r.id}`} style="margin-right:12px">{r.full_number ?? 'Borrador'}</a>)}</p></div>}

      <div class="grid-2">
        <div class="stack">
          <LinesEditor lines={rest.lines} editable={invoice.status === 'borrador'} title="Conceptos" taxRate={settings.default_tax_rate}
            errors={lineErrors} values={lineValues} stored={stored} labourRateCents={settings.labour_rate_cents} allowNegative={invoice.kind === 'rectificativa'}
            emptyText="Añade los conceptos de la factura." />
          {invoice.status === 'emitida' && (
            <section class="card" aria-labelledby="cobros-t">
              <h2 id="cobros-t" class="card-title"><Icon name="euro" />Cobros</h2>
              <p><span class={`pill ${overdue ? 'pill-bad' : payStatus === 'cobrada' ? 'pill-ok' : 'pill-warn'}`}>{overdue ? 'Vencida' : PAYMENT_STATUS_LABELS[payStatus]}</span> Cobrado {formatCents(paid)} · pendiente <strong>{formatCents(pending)}</strong> · vence {formatDay(invoice.due_date)}</p>
              {rest.payments.length > 0 && (
                <ul class="plain-list" style="margin-top:12px">
                  {rest.payments.map(p => (
                    <li>
                      <span style={p.voided_at ? 'text-decoration:line-through' : ''}>{formatDay(p.paid_on)} · {PAYMENT_METHOD_LABELS[p.method]} · {formatCents(Number(p.amount_cents))}{p.reference && ` · ${p.reference}`}</span>
                      {p.voided_at && <span class="muted small"> — anulado: {p.void_reason}</span>}
                      {!p.voided_at && panel.isManager && (voidId === p.id ? (
                        <form method="post" class="confirm" style="margin-top:8px" data-busy="Anulando…">
                          <input type="hidden" name="action" value="anular-cobro" /><input type="hidden" name="payment_id" value={p.id} />
                          <label for={`reason-${p.id}`}>Motivo de la anulación</label>
                          <input class="input" id={`reason-${p.id}`} name="reason" required maxlength="300" />
                          <div class="pnl-actions"><button class="btn btn-danger btn-sm" type="submit">Anular cobro</button><a class="btn btn-sm" href={`/panel/facturas/${invoice!.id}`}>Cancelar</a></div>
                        </form>
                      ) : (
                        <form method="post" style="display:inline"><input type="hidden" name="action" value="pedir-anular-cobro" /><input type="hidden" name="payment_id" value={p.id} /><button class="btn btn-sm" type="submit" aria-label={`Anular el cobro de ${formatCents(Number(p.amount_cents))}`}>Anular…</button></form>
                      ))}
                    </li>
                  ))}
                </ul>
              )}
              {pending !== 0 && (
                <form method="post" class="form-stack" style="margin-top:16px" data-busy="Guardando…" novalidate>
                  <input type="hidden" name="action" value="cobro" />
                  <h3 class="card-title" style="margin:0">{Number(invoice.total_cents) < 0 ? 'Registrar devolución' : 'Registrar cobro'}</h3>
                  <div class="form-row">
                    <div class="field"><label for="amount">Importe (€)</label><input class="input" id="amount" name="amount" inputmode="decimal" value={(Math.abs(pending) / 100).toFixed(2).replace('.', ',')} /></div>
                    <div class="field"><label for="method">Forma de pago</label><select class="select" id="method" name="method">{PAYMENT_METHODS.map(m => <option value={m}>{PAYMENT_METHOD_LABELS[m]}</option>)}</select></div>
                  </div>
                  <div class="form-row">
                    <div class="field"><label for="paid_on">Fecha</label><input class="input" id="paid_on" name="paid_on" type="date" max={todayMadrid()} value={todayMadrid()} /></div>
                    <div class="field"><label for="reference">Referencia <span class="muted">(opcional)</span></label><input class="input" id="reference" name="reference" maxlength="120" /></div>
                  </div>
                  <p class="hint">Los cobros se hacen fuera de la plataforma (efectivo, TPV del taller, transferencia…): aquí solo se anotan. No se guardan datos de tarjetas.</p>
                  <button class="btn btn-primary" type="submit"><span class="spinner" aria-hidden="true"></span><span data-label>Registrar</span></button>
                </form>
              )}
            </section>
          )}
        </div>
        <div class="stack">
          <section class="card" aria-labelledby="datos-t">
            <h2 id="datos-t" class="card-title"><Icon name="file" />Datos</h2>
            {invoice.status === 'emitida' ? (
              <dl class="facts">
                <dt>Número</dt><dd>{invoice.full_number}</dd>
                <dt>Fecha</dt><dd>{formatDay(invoice.issue_date)}</dd>
                <dt>Emitida</dt><dd>{formatDateTime(invoice.issued_at)}</dd>
                <dt>Emisor</dt><dd>{invoice.issuer?.legal_name} · NIF {invoice.issuer?.tax_id}<br /><span class="muted small">{address(invoice.issuer)}</span></dd>
                <dt>Cliente</dt><dd>{invoice.recipient?.name}{invoice.recipient?.tax_id && ` · NIF ${invoice.recipient.tax_id}`}<br /><span class="muted small">{address(invoice.recipient)}</span></dd>
                {invoice.notes && <><dt>Nota</dt><dd>{invoice.notes}</dd></>}
              </dl>
            ) : (
              <>
                {missing.length > 0 && <div class="alert alert-warn" role="note"><Icon name="alert" /><span>Antes de emitir revisa: {missing.join('; ')}.</span></div>}
                <form method="post" class="form-stack" data-busy="Guardando…">
                  <input type="hidden" name="action" value="nota" />
                  <div class="field"><label for="notes">Nota en la factura <span class="muted">(opcional)</span></label><textarea class="textarea" id="notes" name="notes" maxlength="2000" rows="3">{invoice.notes ?? ''}</textarea></div>
                  <button class="btn btn-sm" type="submit">Guardar nota</button>
                </form>
              </>
            )}
          </section>
          <section class="card" aria-labelledby="acc-t">
            <h2 id="acc-t" class="card-title"><Icon name="check" />Acciones</h2>
            {invoice.status === 'borrador' ? (
              <>
                {askIssue ? (
                  <form method="post" class="confirm" data-busy="Emitiendo…">
                    <input type="hidden" name="action" value="emitir" />
                    <strong>¿Emitir la factura?</strong>
                    <span class="hint">Recibirá el siguiente número de la serie y ya no se podrá modificar ni borrar (solo corregir con una rectificativa).</span>
                    <div class="pnl-actions"><button class="btn btn-primary" type="submit">Sí, emitir</button><a class="btn" href={`/panel/facturas/${invoice.id}`}>Cancelar</a></div>
                  </form>
                ) : <form method="post"><input type="hidden" name="action" value="pedir-emitir" /><button class="btn btn-primary" type="submit" disabled={rest.lines.length === 0}>Emitir factura…</button></form>}
                <div style="margin-top:16px">
                  {askDelete ? (
                    <form method="post" class="confirm" data-busy="Borrando…">
                      <input type="hidden" name="action" value="borrar" />
                      <strong>¿Borrar este borrador?</strong>
                      <div class="pnl-actions"><button class="btn btn-danger" type="submit">Sí, borrar</button><a class="btn" href={`/panel/facturas/${invoice.id}`}>Cancelar</a></div>
                    </form>
                  ) : <form method="post"><input type="hidden" name="action" value="pedir-borrar" /><button class="btn btn-sm btn-danger" type="submit">Borrar borrador…</button></form>}
                </div>
              </>
            ) : invoice.kind === 'ordinaria' && panel.isManager ? (
              askRectify ? (
                <form method="post" class="confirm" data-busy="Creando…">
                  <input type="hidden" name="action" value="rectificar" />
                  <label for="reason">Motivo de la rectificación</label>
                  <input class="input" id="reason" name="reason" required minlength="5" maxlength="500" placeholder="Ej.: precio de una pieza equivocado" />
                  <span class="hint">Se crea un borrador de rectificativa que anula en negativo esta factura; puedes ajustarlo antes de emitirlo.</span>
                  <div class="pnl-actions"><button class="btn btn-danger" type="submit">Crear rectificativa</button><a class="btn" href={`/panel/facturas/${invoice.id}`}>Cancelar</a></div>
                </form>
              ) : <form method="post"><input type="hidden" name="action" value="pedir-rectificar" /><button class="btn btn-sm" type="submit">Corregir con una rectificativa…</button></form>
            ) : <p class="hint">Una factura emitida no se modifica. {invoice.kind === 'ordinaria' && 'Las rectificativas las hace el propietario o un administrador.'}</p>}
          </section>
          <p class="hint">Facturación operativa, no certificada VERI*FACTU. Ver la guía de facturación antes de usarla para facturar de verdad.</p>
        </div>
      </div>
    </>
  )}
</PanelLayout>
