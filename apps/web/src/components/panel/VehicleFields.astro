---
/**
 * Campos del formulario de vehículo (alta y edición).
 * En el alta (prop `lookup`), junto a la matrícula aparece "Consultar datos"
 * si hay un proveedor configurado; si no, se explica que hay que rellenarlo a mano.
 */
import { FUEL_LABELS, FUEL_TYPES, YEAR_KIND_LABELS, YEAR_KINDS } from '@talleres/core';
import LookupReview from './LookupReview.astro';
import type { LookupView } from '../../lib/vehicle-lookup/service.ts';
interface Props {
  values: Record<string, string>;
  errors?: Partial<Record<string, string>>;
  customers: Array<{ id: string; full_name: string; phone: string | null }>;
  /** Mostrar la casilla de "matrícula no estándar" (cuando la validación lo pide). */
  askPlateConfirmation?: boolean;
  /** Solo en el alta: consulta por matrícula. */
  lookup?: { available: boolean; key: string; result: LookupView | null; appliedFrom: string | null };
}
const { values, errors = {}, customers, askPlateConfirmation = false, lookup } = Astro.props;
const err = (k: string) => errors[k];
---
<p class="hint">Matrícula, marca, modelo y año son obligatorios; lo demás es opcional.</p>
<div class="form-row">
  <div class={`field ${err('plate') ? 'has-error' : ''}`}>
    <label for="plate">Matrícula</label>
    <input class="input input-plate" id="plate" name="plate" required maxlength="20" autocomplete="off" autocapitalize="characters" placeholder="1234 ABC" value={values.plate ?? ''} aria-invalid={err('plate') ? 'true' : undefined} aria-describedby={err('plate') ? 'plate-err' : undefined} />
    {err('plate') && <p class="field-error" id="plate-err">{err('plate')}</p>}
    {askPlateConfirmation && (
      <label class="check"><input type="checkbox" name="confirm_plate" /><span>La matrícula es correcta aunque no tenga formato español (extranjera, histórica…).</span></label>
    )}
    {lookup && (lookup.available ? (
      <>
        <input type="hidden" name="lookup_key" value={lookup.key} />
        <button class="btn btn-sm" type="submit" name="action" value="consultar" formnovalidate data-busy-label="Consultando…">
          <span class="spinner" aria-hidden="true"></span><span data-label>Consultar datos</span>
        </button>
        <p class="hint">Consulta la matrícula en el proveedor de datos contratado. No se guarda nada hasta que revises los datos y pulses «Guardar vehículo».</p>
      </>
    ) : (
      <p class="hint" id="lookup-off">La consulta automática por matrícula no está disponible (no hay un proveedor de datos configurado). Introduce los datos a mano.</p>
    ))}
  </div>
  <div class={`field ${err('customerId') ? 'has-error' : ''}`}>
    <label for="customer_id">Cliente</label>
    <select class="select" id="customer_id" name="customer_id">
      <option value="">Sin cliente asignado</option>
      {customers.map(c => <option value={c.id} selected={c.id === values.customer_id}>{c.full_name}{c.phone ? ` · ${c.phone}` : ''}</option>)}
    </select>
    {err('customerId') && <p class="field-error">{err('customerId')}</p>}
  </div>
</div>
{lookup?.result && <LookupReview lookup={lookup.result} values={values} />}
{lookup?.appliedFrom && <input type="hidden" name="lookup_id" value={lookup.appliedFrom} />}
<div class="form-row">
  <div class={`field ${err('make') ? 'has-error' : ''}`}>
    <label for="make">Marca</label>
    <input class="input" id="make" name="make" required maxlength="60" autocomplete="off" placeholder="Ej.: Volkswagen" value={values.make ?? ''} aria-invalid={err('make') ? 'true' : undefined} />
    {err('make') && <p class="field-error">{err('make')}</p>}
  </div>
  <div class={`field ${err('model') ? 'has-error' : ''}`}>
    <label for="model">Modelo</label>
    <input class="input" id="model" name="model" required maxlength="80" autocomplete="off" placeholder="Ej.: Golf" value={values.model ?? ''} aria-invalid={err('model') ? 'true' : undefined} />
    {err('model') && <p class="field-error">{err('model')}</p>}
  </div>
</div>
<div class="form-row">
  <div class={`field ${err('year') ? 'has-error' : ''}`}>
    <label for="year">Año</label>
    <input class="input" id="year" name="year" required inputmode="numeric" maxlength="4" autocomplete="off" placeholder="Ej.: 2019" value={values.year ?? ''} aria-invalid={err('year') ? 'true' : undefined} />
    {err('year') && <p class="field-error">{err('year')}</p>}
  </div>
  <div class={`field ${err('yearKind') ? 'has-error' : ''}`}>
    <label for="year_kind">Ese año es de…</label>
    <select class="select" id="year_kind" name="year_kind" required>
      <option value="">Elige…</option>
      {YEAR_KINDS.map(k => <option value={k} selected={k === values.year_kind}>{YEAR_KIND_LABELS[k]}</option>)}
    </select>
    {err('yearKind') && <p class="field-error">{err('yearKind')}</p>}
  </div>
</div>
<div class={`field ${err('fuel') ? 'has-error' : ''}`}>
  <label for="fuel">Combustible <span class="muted">(opcional)</span></label>
  <select class="select" id="fuel" name="fuel">
    <option value="">Sin indicar</option>
    {FUEL_TYPES.map(f => <option value={f} selected={f === values.fuel}>{FUEL_LABELS[f]}</option>)}
  </select>
</div>
<div class="form-row">
  <div class={`field ${err('version') ? 'has-error' : ''}`}>
    <label for="version">Versión <span class="muted">(opcional)</span></label>
    <input class="input" id="version" name="version" maxlength="80" autocomplete="off" placeholder="Ej.: 1.5 TSI Life" value={values.version ?? ''} />
    {err('version') && <p class="field-error">{err('version')}</p>}
  </div>
  <div class={`field ${err('vin') ? 'has-error' : ''}`}>
    <label for="vin">Bastidor (VIN) <span class="muted">(opcional)</span></label>
    <input class="input" id="vin" name="vin" maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="17 caracteres" value={values.vin ?? ''} aria-invalid={err('vin') ? 'true' : undefined} />
    {err('vin') && <p class="field-error">{err('vin')}</p>}
  </div>
</div>
<div class={`field ${err('mileage') ? 'has-error' : ''}`}>
  <label for="mileage">Kilómetros actuales <span class="muted">(opcional)</span></label>
  <input class="input" id="mileage" name="mileage" inputmode="numeric" maxlength="9" autocomplete="off" placeholder="Ej.: 120500" value={values.mileage ?? ''} aria-invalid={err('mileage') ? 'true' : undefined} />
  {err('mileage') && <p class="field-error">{err('mileage')}</p>}
  <p class="hint">Se actualiza solo cuando una orden entra con más kilómetros.</p>
</div>
<fieldset class="next-service">
  <legend>Próxima revisión <span class="muted">(opcional; la ve el cliente en su portal)</span></legend>
  <div class="form-row">
    <div class={`field ${err('nextServiceDate') ? 'has-error' : ''}`}>
      <label for="next_service_date">Fecha</label>
      <input class="input" type="date" id="next_service_date" name="next_service_date" value={values.next_service_date ?? ''} />
      {err('nextServiceDate') && <p class="field-error">{err('nextServiceDate')}</p>}
    </div>
    <div class={`field ${err('nextServiceKm') ? 'has-error' : ''}`}>
      <label for="next_service_km">A los kilómetros</label>
      <input class="input" id="next_service_km" name="next_service_km" inputmode="numeric" maxlength="9" autocomplete="off" placeholder="Ej.: 135000" value={values.next_service_km ?? ''} />
      {err('nextServiceKm') && <p class="field-error">{err('nextServiceKm')}</p>}
    </div>
  </div>
  <div class={`field ${err('nextServiceNotes') ? 'has-error' : ''}`}>
    <label for="next_service_notes">Recomendación</label>
    <input class="input" id="next_service_notes" name="next_service_notes" maxlength="500" placeholder="Ej.: Cambio de aceite y filtros" value={values.next_service_notes ?? ''} />
    {err('nextServiceNotes') && <p class="field-error">{err('nextServiceNotes')}</p>}
  </div>
</fieldset>
<div class="field note-internal">
  <label for="internal_notes">Notas internas <span class="muted">(solo para el taller)</span></label>
  <textarea class="textarea" id="internal_notes" name="internal_notes" maxlength="2000" rows="3">{values.internal_notes ?? ''}</textarea>
  {err('internalNotes') && <p class="field-error">{err('internalNotes')}</p>}
</div>
{lookup?.appliedFrom ? (
  <p class="hint">Se guardará de qué consulta salen los datos y, campo a campo, si los has dejado como los dio el proveedor o los has cambiado. La verificación queda <strong>pendiente</strong>.</p>
) : (
  <p class="hint">Los datos se guardan como <strong>introducidos manualmente</strong> y con verificación externa <strong>pendiente</strong>.{!lookup && ' No se consulta la matrícula en ningún servicio externo.'}</p>
)}

<style>
  .next-service { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 10px; }
  .next-service legend { padding: 0; font-weight: 600; margin-bottom: 4px; }
</style>
