---
/** Página legal pendiente: no se inventa texto legal. */
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import type { PublicSite } from '../lib/site/content.ts';
interface Props { site: PublicSite; title: string; items: string[] }
const { site, title, items } = Astro.props;
---
<SiteLayout site={site} title={`${title} · ${site.name}`} noindex>
  <SiteHeader site={site} />
  <main class="section">
    <div class="wrap legal">
      <h1>{title}</h1>
      <div class="alert alert-warn" role="note">
        <span><strong>Texto pendiente.</strong> El titular de la web debe redactar esta página con su asesor legal antes de publicar la web. No es un texto legal válido.</span>
      </div>
      <p>Esta página deberá incluir, al menos:</p>
      <ul>{items.map(i => <li>{i}</li>)}</ul>
      <p><a href="/">Volver a la web</a></p>
    </div>
  </main>
  <SiteFooter site={site} />
</SiteLayout>
