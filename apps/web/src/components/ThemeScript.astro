---
/**
 * En la cabecera de cada plantilla, antes de pintar: aplica el modo guardado y
 * la respuesta al aviso de cookies (oculta el aviso si ya se respondió). Si hay
 * cookie, manda ella (es lo que ha pintado el servidor); sin cookie, lo de esta
 * visita (sessionStorage) o, con cookies aceptadas, localStorage (vista previa
 * sin servidor). Un valor desconocido no cambia nada.
 *
 * El texto está en lib/inline-scripts.ts: la CSP solo ejecuta scripts en línea con huella conocida.
 */
import { THEME_SCRIPT } from '../lib/inline-scripts.ts';
---
<script is:inline set:html={THEME_SCRIPT}></script>
