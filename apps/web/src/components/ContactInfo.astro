---
import Icon from './Icon.astro';
import BlurText from './BlurText.astro';
import type { PublicSite } from '../lib/site/content.ts';
import { telHref, whatsappHref } from '../lib/site/content.ts';
interface Props { site: PublicSite }
const { site } = Astro.props;
const c = site.content;
const tel = telHref(c.phone);
const wa = whatsappHref(c.whatsapp);
const maps = c.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.address)}` : '';
---
<section class="section glow glow-low" id="contacto">
  <div class="wrap">
    <header class="section-head">
      <p class="label">// Contacto</p>
      <BlurText as="h2" text="Dónde estamos" class="display-sm heading" />
    </header>
    <div class="contact-grid">
      {c.address && (
        <div class="contact-card liquid-glass reveal" data-reveal>
          <span class="ico-square liquid-glass"><Icon name="pin" /></span>
          <h3>Dirección</h3><p>{c.address}</p>
          {maps && <a href={maps} target="_blank" rel="noopener">Cómo llegar <Icon name="arrowUpRight" /></a>}
        </div>
      )}
      {c.hours.length > 0 && (
        <div class="contact-card liquid-glass reveal" data-reveal style="--d:.1s">
          <span class="ico-square liquid-glass"><Icon name="clock" /></span>
          <h3>Horario</h3>{c.hours.map(h => <p>{h}</p>)}
        </div>
      )}
      {tel && (
        <div class="contact-card liquid-glass reveal" data-reveal style="--d:.2s">
          <span class="ico-square liquid-glass"><Icon name="phone" /></span>
          <h3>Teléfono</h3><a href={tel}>{c.phone}</a>
        </div>
      )}
      {wa && (
        <div class="contact-card liquid-glass reveal" data-reveal style="--d:.3s">
          <span class="ico-square liquid-glass"><Icon name="chat" /></span>
          <h3>WhatsApp</h3><a href={wa} target="_blank" rel="noopener">Escríbenos <Icon name="arrowUpRight" /></a>
        </div>
      )}
      {c.email && (
        <div class="contact-card liquid-glass reveal" data-reveal style="--d:.4s">
          <span class="ico-square liquid-glass"><Icon name="mail" /></span>
          <h3>Correo</h3><a href={`mailto:${c.email}`}>{c.email}</a>
        </div>
      )}
    </div>
  </div>
</section>
