---
import BlurText from './BlurText.astro';
const steps = [
  { title: 'Envía tu solicitud', text: 'Cuéntanos qué necesitas desde la web, por teléfono o por WhatsApp.' },
  { title: 'Te confirmamos', text: 'Revisamos tu solicitud y te contactamos para confirmar el día y la hora.' },
  { title: 'Diagnóstico y presupuesto', text: 'Revisamos el vehículo y te explicamos qué necesita antes de empezar.' },
  { title: 'Recoges tu coche', text: 'Te avisamos cuando está listo para que pases a recogerlo.' },
];
---
<section class="section glow" id="como-trabajamos">
  <div class="wrap">
    <header class="section-head">
      <p class="label">// Cómo trabajamos</p>
      <BlurText as="h2" text="De la solicitud a la entrega" class="display-sm heading" />
    </header>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step liquid-glass reveal" data-reveal style={`--d:${i * 0.1}s`}>
          <span class="step-num heading" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="heading">{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
