---
import Icon from './Icon.astro';
import BlurText from './BlurText.astro';
import FadingVideo from './FadingVideo.astro';
import type { PublicSite } from '../lib/site/content.ts';
interface Props { site: PublicSite }
const { site } = Astro.props;
const c = site.content;
// Solo datos reales del taller: nada de cifras, reseñas ni logos inventados.
---
<section class="hero">
  <div class="ambient" aria-hidden="true"></div>
  {site.videos.hero && (
    <FadingVideo src={site.videos.hero} class="hero-video" style="width:120%;height:120%" />
  )}
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-main">
      <p class="badge liquid-glass reveal" data-reveal style="--d:.4s">
        <b>Cita online</b>
        <span>Pídela desde la web · te contactamos para confirmarla</span>
      </p>

      <BlurText text="Tu coche en buenas manos. Pide cita en un minuto." class="hero-title heading" />

      {c.intro && <p class="hero-lead reveal" data-reveal style="--d:.8s">{c.intro}</p>}

      <div class="hero-actions reveal" data-reveal style="--d:1.1s">
        <a href="#solicitar" class="btn-glass liquid-glass-strong">Solicitar cita <Icon name="arrowUpRight" /></a>
        <a href="#solicitar-presupuesto" class="btn-plain" data-open-tab="presupuesto"><Icon name="clipboard" /> Pedir presupuesto</a>
      </div>

      {(c.city || c.brands) && (
        <div class="hero-stats reveal" data-reveal style="--d:1.3s">
          {c.city && (
            <div class="stat liquid-glass">
              <Icon name="pin" />
              <p class="stat-value heading">{c.city}</p>
              {c.address && <p class="stat-label">{c.address}</p>}
            </div>
          )}
          {c.brands && (
            <div class="stat liquid-glass">
              <Icon name="car" />
              <p class="stat-value heading">Multimarca</p>
              <p class="stat-label">{c.brands}</p>
            </div>
          )}
        </div>
      )}
    </div>

    {c.hours.length > 0 && (
      <div class="hero-foot reveal" data-reveal style="--d:1.4s">
        <p class="hours-pill liquid-glass"><Icon name="clock" /><span>{c.hours.join(' · ')}</span></p>
      </div>
    )}
  </div>
</section>
