# Copia este archivo como .dev.vars (NO se sube a Git) y rellena los valores.
# En producción se configuran en Cloudflare → Workers → Settings → Variables and Secrets.

# --- Públicas: pueden verse en el navegador sin riesgo (la seguridad la da RLS) ---
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- SECRETAS: solo en el servidor. Si se filtran, hay que rotarlas al momento ---
# Salta todas las reglas RLS: úsala solo para operaciones concretas del servidor.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Antispam de formularios (Cloudflare Turnstile). Se usará en la Fase 1.
TURNSTILE_SECRET_KEY=
