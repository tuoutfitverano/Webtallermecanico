# Copia este archivo como apps/web/.env (NO se sube a Git) y rellénalo.
# En producción se configuran en Cloudflare → Workers → Settings → Variables and Secrets
# (las claves secretas como "Secret", nunca como texto plano).
#
# Sin estas variables la web se ve en local con datos de demostración, pero los
# formularios responden "no disponible": nunca simulan un envío correcto.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_…). Solo permite lo que RLS deja a un visitante.
SUPABASE_PUBLISHABLE_KEY=
# Clave SECRETA (sb_secret_…). Se salta RLS: solo vive en el servidor.
# Si se filtra, rótala inmediatamente en Supabase.
SUPABASE_SECRET_KEY=

# --- Antispam: Cloudflare Turnstile (Cloudflare → Turnstile → Add widget) ---
# Obligatorio en producción: sin él los formularios no aceptan envíos.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Huella anónima para limitar envíos (texto aleatorio largo, p. ej. `openssl rand -hex 32`) ---
REQUEST_HASH_SECRET=

# --- Área privada (inicio de sesión, cuenta, invitaciones) ---
# Usa SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY. Sin ellas, /acceso dice "servicio
# no disponible" (nunca simula un inicio de sesión).
# Dominio del área privada en producción, p. ej. https://app.tudominio.es
# (el mismo que "Site URL" en Supabase → Authentication → URL Configuration).
# En local déjalo vacío: se usa el dominio de la visita.
APP_URL=

# --- Consulta de datos por matrícula (opcional; ver docs/CONSULTA_MATRICULAS.md) ---
# Vacío = desactivada: el alta de vehículos es manual. Para activarla: openapi
VEHICLE_LOOKUP_PROVIDER=
# Token de Openapi (consola de Openapi → Tokens). SECRETO: solo en el servidor.
OPENAPI_AUTOMOTIVE_TOKEN=
# Vacío = producción. Para el entorno de pruebas del proveedor: https://test.automotive.openapi.com
OPENAPI_AUTOMOTIVE_URL=
# Tiempo máximo de espera en milisegundos (por defecto 8000).
VEHICLE_LOOKUP_TIMEOUT_MS=

# --- Avisos por email (opcional; ver docs/NOTIFICACIONES.md) ---
# Vacío = sin email: los avisos del portal funcionan y los emails se quedan pendientes (nunca "enviados").
EMAIL_PROVIDER=
# Remitente en un dominio verificado en Resend, p. ej. avisos@tudominio.es
EMAIL_FROM=
# Clave de la API de Resend (re_…). SECRETA.
RESEND_API_KEY=
# Solo para pruebas locales; vacío = API de Resend.
RESEND_API_URL=
# Secreto de firma del webhook de Resend (whsec_…). SECRETO.
RESEND_WEBHOOK_SECRET=
# --- Avisos por WhatsApp (opcional; ver docs/NOTIFICACIONES.md) ---
# Vacío = sin WhatsApp: los avisos se quedan pendientes (nunca "enviados"). Valor admitido: meta
WHATSAPP_PROVIDER=
# Token de acceso permanente de la API de WhatsApp Business (usuario del sistema). SECRETO.
WHATSAPP_TOKEN=
# Identificador del número de teléfono de empresa (solo cifras, lo da Meta).
WHATSAPP_PHONE_NUMBER_ID=
# Nombre de la plantilla aprobada; vacío = reparacion_estado_v1
WHATSAPP_TEMPLATE=
# Solo para pruebas locales; vacío = API de Meta.
WHATSAPP_API_URL=
# Secreto de la app de Meta (firma del webhook). SECRETO.
WHATSAPP_APP_SECRET=
# Texto que inventas tú para dar de alta el webhook en Meta. SECRETO.
WHATSAPP_VERIFY_TOKEN=
# Secreto largo (mín. 24 caracteres, p. ej. `openssl rand -hex 32`) del proceso programado (cron). SECRETO.
NOTIFICATIONS_CRON_SECRET=
