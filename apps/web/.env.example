# Copia este archivo como apps/web/.env (NO se sube a Git) y rellénalo.
# En producción se configuran en Cloudflare → Workers → Settings → Variables and Secrets
# (las claves secretas como "Secret", nunca como texto plano).
#
# Sin estas variables la web se ve en local con datos de demostración, pero los
# formularios responden "no disponible": nunca simulan un envío correcto.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_…). Solo permite lo que RLS deja a un visitante.
SUPABASE_PUBLISHABLE_KEY=
# Clave SECRETA (sb_secret_…). Se salta RLS: solo vive en el servidor.
# Si se filtra, rótala inmediatamente en Supabase.
SUPABASE_SECRET_KEY=

# --- Antispam: Cloudflare Turnstile (Cloudflare → Turnstile → Add widget) ---
# Obligatorio en producción: sin él los formularios no aceptan envíos.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Huella anónima para limitar envíos (texto aleatorio largo, p. ej. `openssl rand -hex 32`) ---
REQUEST_HASH_SECRET=
