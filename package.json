{
  "name": "plataforma-talleres",
  "private": true,
  "description": "Plataforma multiempresa para talleres mecánicos: webs comerciales y gestión de vehículos y reparaciones.",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @talleres/web",
    "build": "npm run build --workspace @talleres/web && node scripts/check-client-bundle.mjs",
    "check": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "bash scripts/test-db.sh",
    "test:concurrencia": "bash scripts/test-concurrencia.sh",
    "test:backup": "bash scripts/backup/test-restore.sh",
    "test:mcp": "node scripts/check-playwright-mcp.mjs",
    "mcp:playwright": "node scripts/playwright-mcp.mjs",
    "test:e2e": "bash scripts/test-e2e.sh",
    "lint": "eslint .",
    "test:bundle": "node scripts/check-client-bundle.mjs",
    "taller:sql": "node scripts/taller/sql.ts",
    "web:exportar": "node scripts/exportar-web/exportar.mjs",
    "test:exportar": "node scripts/exportar-web/exportar.mjs talleres/autovalue.json --sin-zip && bash scripts/exportar-web/test-local.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "supabase": "^2.121.0",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "undici@^7": "7.30.1",
    "fast-uri@^3": "3.1.9"
  }
}
